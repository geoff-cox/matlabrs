<!--META-DATA
{
	"tags": ["pattern-checking", "dice", "two-pair", "logical"]
}
-->

<statement>
	<p>
		Checks whether a given roll contains two distinct pairs of dice. A two-pair consists of two dice of one face value, two dice of another, and a fifth die of a different value. For example,
		<me>\LARGE ⚂\ ⚂\ ⚁\ ⚁\ ⚄</me>
	</p>

	<tabular valign="top" halign="right" top="minor">
		<col width="12%"/>
		<col width="88%" halign="left"/>

		<row>
			<cell><p>Inputs:</p></cell>
			<cell>
				<p><pf>roll</pf> (1 x 5) integer vector — dice values sorted into rank order.</p>
			</cell>
		</row>
		
		<row bottom="minor">
			<cell/>
			<cell>
				<p><pf>counts</pf> (1 x 6) integer vector — counts of each die face in <pf>roll</pf>.</p>
			</cell>
		</row>

		<row bottom="minor">
			<cell><p>Outputs:</p></cell>
			<cell>
				<p><pf>tf</pf> (1 x 1) logical — <pf>true</pf> if <pf>roll</pf> contains two-pairs; <pf>false</pf> otherwise.</p>
			</cell>
		</row>

		<row>
			<cell><p>Details:</p></cell>
			<cell><p>▸ You may assume that the input <pf>roll</pf> will be sorted by rank.</p></cell>
		</row>

		<row>
			<cell/>
			<cell><p>▸ Both <pf>roll</pf> and <pf>counts</pf> are provided as inputs. You may use one or both to code this. If one is not used, replace the input variable with <pf>~</pf>.</p></cell>
		</row>
		
		<row bottom="minor">
			<cell/>
			<cell><p>▸ You may use the MATLAB command <pf>isequal(v1,v2)</pf> to compare the equality of vectors, <pf>v1</pf> &amp; <pf>v2</pf>.</p></cell>
		</row>
	</tabular>

	<p>
		Examples:
		<program>
			<code>
				tf = is_2pair([4 4 2 2 5], [0 2 0 2 1 0])
				% returns tf  =  (logical)  1
			</code>
		</program>
		<program>
			<code>
				tf = is_2pair([3 3 3 5 5], [0 0 3 0 2 0])
				% returns tf  =  (logical)  0
			</code>
		</program>
		<program>
			<code>
				tf = is_2pair([6 6 6 6 2], [0 1 0 0 0 4])
				% returns tf  =  (logical)  0
			</code>
		</program>
	</p>
</statement>
