{
	tags: general,
}
-->

<statement>
<p>
	Given two input lists of the same length, the function returns the number of elements the lists have in common.
</p>

<tabular valign="top" top="minor">
	<col width="12%"/>
	<col width="88%"/>
	<row bottom="minor">
		<cell>Inputs:</cell>
		<cell>
			<p><pf>list1</pf> (1 x n) double — matrix of numbers (doubles)</p>
			<p><pf>list2</pf> (1 x n) double — matrix of numbers (doubles)</p>
		</cell>
	</row>
	<row bottom="minor">
		<cell>Outputs:</cell>
		<cell>
			<p><pf>count</pf> (double) double — is the number of elements the two input lists have in common.</p>
		</cell>
	</row>
</tabular>

<p>
	Examples:
<program>
	<code>
		INPUT
		[3, 3, 0, 4],[3, 3, 1, 4]
		OUTPUT
		3
		INPUT
		[-3, 1, 10, 23],[10, 0, 23, 1]
		OUTPUT
		3
		INPUT
		[1, 1, 1, 0, 0, 1],[0, 0, 0, 1, 1, 1]
		OUTPUT
		5
		INPUT
		[4, 7],[10,2]
		OUTPUT
		0
	</code>
</program>
</p>
</statement>
