function [results,player_1_ave_time,player_2_ave_time] = ...
    TTT_Game_Simulator(numOfGames,player_1,player_1_strategy,player_2,player_2_strategy)
results = zeros(1,numOfGames);
player_1_times = zeros(1,numOfGames);
player_2_times = zeros(1,numOfGames);
runs = 1:numOfGames;
% seedy=rng;
XWins = 0;
OWins = 0;
Ties = 0;
tic
for run = runs
    %results(run) = TicTacToeGame_CvC('1','1',seedy);
    [results(run),player_1_times(run),player_2_times(run)] = ...
        TTT_Game_CvC(player_1,player_1_strategy,player_2,player_2_strategy);
    %seedy = seedy + 1;
    if results(run) == 1
        XWins = XWins + 1;
    elseif results(run) == -1
        OWins = OWins + 1;
    else
        Ties = Ties + 1;
    end
    XWinningPer(run)=XWins/run;
    OWinningPer(run)=OWins/run;
    TiePer(run)=Ties/run;
end
toc
hold on;
step = ceil(numOfGames/100);
textOffSet = step;
if step < 50
    textOffSet = step/10;
end
% plot(runs(step:step:end),XWinningPer(step:step:end),'-o'); text(run+textOffSet,XWinningPer(end),[num2str(round(XWinningPer(end)*100,2)),'%']);
% plot(runs(step:step:end),OWinningPer(step:step:end),'-x'); text(run+textOffSet,OWinningPer(end),[num2str(round(OWinningPer(end)*100,2)),'%']);
% title(['Ties = ',num2str(round(TiePer(end)*100,2)),' %   Seed = ']);
% %plot(runs(1:step:end),TiePer(1:step:end),'-Square'); text(run+10,TiePer(end),num2str(TiePer(end)*100))
% hold off;
% goodSeeds
player_1_ave_time = mean(player_1_times);
player_2_ave_time = mean(player_2_times);
end
