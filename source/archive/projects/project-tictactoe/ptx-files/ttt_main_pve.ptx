<statement>
<p>
	This program implements a player vs environment (i.e. computer) implementation of Tic-Tac-Toe.
</p>

<tabular valign="top" top="minor">
	<col width="12%"/>
	<col width="88%"/>
	<row bottom="minor">
		<cell>Inputs:</cell>
		<cell>
			<p><pf>None</pf> number — value</p>
		</cell>
	</row>
	<row bottom="minor">
		<cell>Outputs:</cell>
		<cell>
			<p><pf>winner</pf> (1 x 1) number — has value 1 if player X wins, has value -1 if player O wins, has value 0 if there was a tie</p>
		</cell>
	</row>
	<row>
		<cell>Details:</cell>
		<cell><p>Adapt your</p></cell>
	</row>
	<row>
		<cell/>
		<cell><p>TTT_main_pvp</p></cell>
	</row>
	<row>
		<cell/>
		<cell><p>game into a player vs computer game.</p></cell>
	</row>
	<row>
		<cell/>
		<cell><p>Use your</p></cell>
	</row>
	<row>
		<cell/>
		<cell><p>ai_move_1</p></cell>
	</row>
	<row>
		<cell/>
		<cell><p>program as the AI for this game.</p></cell>
	</row>
	<row bottom="minor">
		<cell/>
		<cell><p>Assume the human player is X and moves first.</p></cell>
	</row>
</tabular>

</statement>
