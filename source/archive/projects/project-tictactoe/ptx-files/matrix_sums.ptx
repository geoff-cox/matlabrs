<statement>
<p>
	For example, if A is the m x n input matrix, then the output should be the (m+n+2) x 1 column vector:
</p>

<tabular valign="top" top="minor">
	<col width="12%"/>
	<col width="88%"/>
	<row bottom="minor">
		<cell>Inputs:</cell>
		<cell>
			<p><pf>A</pf> (m x n) double — matrix of numbers (doubles).</p>
		</cell>
	</row>
	<row bottom="minor">
		<cell>Outputs:</cell>
		<cell>
			<p><pf>sum_list</pf> (m+n+2 x 1) number — sum of the rows, columns, diagonal and anti-diagonal elements of <pf>A</pf>.</p>
		</cell>
	</row>
	<row>
		<cell>Details:</cell>
		<cell><p>Do not use MATLAB's</p></cell>
	</row>
	<row>
		<cell/>
		<cell><p>diag</p></cell>
	</row>
	<row>
		<cell/>
		<cell><p>or</p></cell>
	</row>
	<row>
		<cell/>
		<cell><p>sum</p></cell>
	</row>
	<row bottom="minor">
		<cell/>
		<cell><p>commands.</p></cell>
	</row>
</tabular>

</statement>
