<!--META-DATA
{
	tags: sum,
}
-->

<statement>
<p>
	Write a function <pf>row_col_diag_sums</pf>.
</p>

<tabular valign="top" top="minor">
	<col width="12%"/>
	<col width="88%"/>
	<row bottom="minor">
		<cell>Inputs:</cell>
		<cell>
			<p><pf>A</pf> (m x n) double — matrix of numbers (doubles).</p>
		</cell>
	</row>
	<row bottom="minor">
		<cell>Outputs:</cell>
		<cell>
			<p><pf>sum_list</pf> (m+n+2 x 1) number — sum of the rows, columns, diagonal and anti-diagonal elements of <pf>A</pf>.</p>
		</cell>
	</row>
	<row>
		<cell>Details:</cell>
		<cell><p>Do not use MATLAB's</p></cell>
	</row>
	<row>
		<cell/>
		<cell><p>diag</p></cell>
	</row>
	<row bottom="minor">
		<cell/>
		<cell><p>function.</p></cell>
	</row>
</tabular>

<p>
	Examples:
<program>
	<code>
		row_col_diag_sums([8 1; 1 -3])
		9
		-2
		9
		-2
		5
		2
		row_col_diag_sums([8 1 0; -2 1 -3])
		9
		-4
		6
		2
		-3
		9
		-1
		row_col_diag_sums([8 1; 1 -3; 0 -4])
		9
		-2
		-4
		9
		-6
		5
		-3
	</code>
</program>
</p>
</statement>
