<!--META-DATA
{
	tags: min,
}
-->

<statement>
<p>
	Note: this function does not display anything on the game board; it only determines the color string.
</p>

<tabular valign="top" top="minor">
	<col width="12%"/>
	<col width="88%"/>
	<row bottom="minor">
		<cell>Inputs:</cell>
		<cell>
			<p><pf>guess</pf> (string) number — is a five-letter string; this a guess at the secret word</p>
			<p><pf>word</pf> (string) number — is a five-letter string; this is the secret word</p>
		</cell>
	</row>
	<row bottom="minor">
		<cell>Outputs:</cell>
		<cell>
			<p><pf>colors</pf> (string) number — is a five-letter string representing the colors; the only letters that should appear in the string are w, g, and y (because the only colors that should appear in the guess boxes are white, green and yellow.</p>
		</cell>
	</row>
</tabular>

<p>
	Examples:
<program>
	<code>
		INPUTS
		'SLANT'
		'ANGLE'
		OUTPUT
		'wyyyw'
		INPUTS
		'PUPPY'
		'APPLE'
		OUTPUT
		'ywgww'
		INPUTS
		'AREAS'
		'APPLE'
		OUTPUT
		'gwyww'
	</code>
</program>
</p>
</statement>
