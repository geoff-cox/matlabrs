<!--META-DATA
{
	tags: general,
}
-->

<statement>
<p>
	Given two input lists, the function returns the number of times the k th element of &lt;pf&gt;list1&lt;/pf&gt; is the same as the k th element of &lt;pf&gt;list2&lt;/pf&gt;.
</p>

<tabular valign="top" top="minor">
	<col width="12%"/>
	<col width="88%"/>
	<row bottom="minor">
		<cell>Inputs:</cell>
		<cell>
			<p><pf>list1</pf> (1 x n 1 ) double — matrix of numbers (doubles)</p>
			<p><pf>list2</pf> (1 x n 2 ) double — matrix of numbers (doubles)</p>
		</cell>
	</row>
	<row bottom="minor">
		<cell>Outputs:</cell>
		<cell>
			<p><pf>count</pf> (double) double — the number of times the k th element of <pf>list1</pf> is the same as the k th element of <pf>list2</pf></p>
		</cell>
	</row>
</tabular>

<p>
	Examples:
<program>
	<code>
		INPUT
		[3, 0, 0, 4, 6, 1],[3, 0, 0, 4, 5, 1]
		OUTPUT
		5
		INPUT
		[-3, 0, 1, 2],[1, -3, 1, 0]
		OUTPUT
		1
		INPUT
		[3, 0, 0, 4, 6, 1],[3, -5, 0]
		OUTPUT
		2
		INPUT
		[-10, 0, 0],[1, 2, 8]
		OUTPUT
		0
	</code>
</program>
</p>
</statement>
