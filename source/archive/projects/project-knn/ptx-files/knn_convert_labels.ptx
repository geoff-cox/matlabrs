<!--META-DATA
{
	tags: for, vector, unique, find,
}
-->

<statement>
<p>
	Given a list of data labels that are character arrays, this program converts these labels into a positive integer value as well as a key for this conversion.
</p>

<tabular valign="top" top="minor">
	<col width="12%"/>
	<col width="88%"/>
	<row bottom="minor">
		<cell>Inputs:</cell>
		<cell>
			<p><pf>labels</pf> (M x 1) double vector — column vector of single characters.</p>
		</cell>
	</row>
	<row bottom="minor">
		<cell>Outputs:</cell>
		<cell>
			<p><pf>int_labels</pf> (M x 1) integer — integer labels.</p>
			<p><pf>label_key</pf> (Q x 1) number — list of Q unique character labels in <pf>labels</pf>.</p>
		</cell>
	</row>
	<row>
		<cell>Details:</cell>
		<cell><p>In a past assignment, you wrote a</p></cell>
	</row>
	<row>
		<cell/>
		<cell><p>unique_values</p></cell>
	</row>
	<row>
		<cell/>
		<cell><p>program. Even though it was written to find unique numbers, it turns out that it also works for single characters. Use this code to generate the</p></cell>
	</row>
	<row>
		<cell/>
		<cell><p>label_key</p></cell>
	</row>
	<row bottom="minor">
		<cell/>
		<cell><p>.</p></cell>
	</row>
</tabular>

<p>
	Examples:
<program>
	<code>
		[num_labels,key] = KNN_convert_labels_Key(['f';'m';'m';'f';'m';'f'])
		num_labels =
		1
		2
		2
		1
		2
		1
		key =
		2×1 char array
		'f'
		'm'
	</code>
</program>
</p>
</statement>
