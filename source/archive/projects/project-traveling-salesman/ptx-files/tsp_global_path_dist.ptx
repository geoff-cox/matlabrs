<statement>
<p>
	where is the global distance between and .
</p>

<tabular valign="top" top="minor">
	<col width="12%"/>
	<col width="88%"/>
	<row bottom="minor">
		<cell>Inputs:</cell>
		<cell>
			<p><pf>pt_list</pf> (N x 2) number — list of GPS (degree) coordinates.</p>
		</cell>
	</row>
	<row bottom="minor">
		<cell>Outputs:</cell>
		<cell>
			<p><pf>total_dist</pf> (1 x 1) number — closed distance between all the points in <pf>pt_list</pf>.</p>
		</cell>
	</row>
	<row>
		<cell>Details:</cell>
		<cell><p>Use your</p></cell>
	</row>
	<row>
		<cell/>
		<cell><p>TSP_global_dist</p></cell>
	</row>
	<row bottom="minor">
		<cell/>
		<cell><p>code.</p></cell>
	</row>
</tabular>

<p>
	Examples:
<program>
	<code>
		tot_dist = TSP_global_path_dist_lastname([111 -90; 20 66; -167 42])
		tot_dist = 2.2352e+04
	</code>
</program>
</p>
</statement>
