<exercise xml:id="ex-for-max-entry">
  <statement>
    <p>
      Given a vector <code>v</code>, write code that finds the maximum entry using a loop
      (do not use <code>max</code>). Store the maximum value in <code>m</code>.
    </p>
  </statement>
</exercise>

<!-- Exercise: Running average of vector -->
<exercise xml:id="ex-for-running-average">
  <statement>
    <p>
      Given a vector <code>v</code>, create a vector <code>a</code> of the same length where <code>a(k)</code>
      equals the average of the first <code>k</code> entries of <code>v</code>.
      Use a <code>for</code> loop and preallocate <code>a</code>.
    </p>
  </statement>
</exercise>

<!-- Exercise: Count entries in vector that satisfy condition -->
<exercise xml:id="ex-for-count-condition">
  <statement>
    <p>
      Given a vector <code>v</code>, write a script that counts how many entries satisfy <code>v(k) &gt; 0</code>.
      Store the count in a variable named <code>count</code>.
    </p>
  </statement>
</exercise>

