	<section xml:id="subsec-nested-loops">
		<title>Nested Loops</title>

		<reading-questions xml:id="rqs-">
			<exercise xml:id="activity-for-loop-drill-4">
				<title>Rewrite repeated <pf>fprintf</pf> code: stars</title>

				<task xml:id="activity-for-loop-drill-4a">
					<statement>
						<p>
							The code below has repeated lines:
							<program language="matlab">
								fprintf('*\n');
								fprintf('**\n');
								fprintf('***\n');
								fprintf('****\n');
							</program>
							Rewrite it as a <pf>for</pf>-loop that prints one more star on each line.
						</p>
					</statement>
					<!--<solution>
						<program language="matlab">
							stars = '';
							for k = 1:4
								stars = [stars '*'];
								fprintf('%s\n', stars);
							end
						</program>
					</solution>-->
				</task>
			</exercise>
		</reading-questions>

  <reading-questions xml:id="class-activities-nested-loops">

    <introduction>
      <p>
        These activities will help you practice using nested loops to solve interesting problems.
      </p>
    </introduction>



		


  
    <exercise xml:id="activity-perfect-numbers-nested-part">
      <title>Perfect Number Detector</title>

      <task xml:id="activity-perfect-numbers-nested-part-a">
        <statement>
          <p>
            <em>Extension:</em> The first four perfect numbers are 6, 28, 496, and 8128. Write a script using nested loops to search for all perfect numbers less than 10,000.
          </p>
        </statement>
      </task>
    </exercise>

  </reading-questions>

</section>