<!--META-DATA
{
	tags: indexing,
}
-->

<statement>
<p>
	This program returns a list of available spaces (as an absolute index) in a Tic-Tac-Toe game.
</p>

<tabular valign="top" top="minor">
	<col width="12%"/>
	<col width="88%"/>
	<row>
		<cell>Details:</cell>
		<cell><p>This program aims to provide a list of available spaces where a player could place an 'X' or 'O'.</p></cell>
	</row>
</tabular>

<p>
	Examples:
<program>
	<code>
		spaces = TTT42_get_open_spaces_lastname([0 0 0; 0 1 0; 0 0 0])
		spaces = [1 2 3 4 6 7 8 9]
		spaces = TTT42_get_open_spaces_lastname([1 -1 -1; 0 1 -1; 1 0 -1])
		spaces = [2 6]
		spaces = TTT42_get_open_spaces_lastname([1 -1 -1; -1 1 -1; 1 1 -1])
		spaces = []
	</code>
</program>
</p>
</statement>
