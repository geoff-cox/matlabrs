<statement>
<p>
	Chose an available space at random from a uniform distribution (i.e., all spaces are equally likely to be selected).
</p>

<tabular valign="top" top="minor">
	<col width="12%"/>
	<col width="88%"/>
	<row>
		<cell>Details:</cell>
		<cell><p>You may use MATLAB's</p></cell>
	</row>
	<row>
		<cell/>
		<cell><p>randi</p></cell>
	</row>
	<row>
		<cell/>
		<cell><p>command to generate a random number.</p></cell>
	</row>
	<row>
		<cell/>
		<cell><p>You may want to use your</p></cell>
	</row>
	<row>
		<cell/>
		<cell><p>TTT42</p></cell>
	</row>
	<row bottom="minor">
		<cell/>
		<cell><p>program here.</p></cell>
	</row>
</tabular>

<p>
	Examples:
<program>
	<code>
		move_to = TTT44_ai_move_1_lastname([0 -1 -1; -1 1 -1; 1 1 -1])
		move_to = 1
		move_to = TTT44_ai_move_1_lastname([0 0 0; 0 1 0; 0 0 0])
		move_to = 7
		move_to = TTT44_ai_move_1_lastname([1 -1 -1; -1 1 -1; 1 1 -1])
		move_to = []
	</code>
</program>
</p>
</statement>
