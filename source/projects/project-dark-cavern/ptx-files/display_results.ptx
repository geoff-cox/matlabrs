<statement>
<p>
	This function displays the results of the game and compares the current game time to the best game time.
</p>

<tabular valign="top" top="minor">
	<col width="12%"/>
	<col width="88%"/>
	<row bottom="minor">
		<cell>Inputs:</cell>
		<cell>
			<p><pf>state</pf> (1 x 1) number — struct object representing the current game state.</p>
			<p><pf>player_time</pf> (1 x 1) number — numeric value representing the time it took to complete the game.</p>
		</cell>
	</row>
	<row bottom="minor">
		<cell>Outputs:</cell>
		<cell>
			<p><pf>No</pf> number — output</p>
		</cell>
	</row>
	<row>
		<cell>Details:</cell>
		<cell><p>Follow the template provided in class.</p></cell>
	</row>
</tabular>

</statement>
