<!--META-DATA
{
	tags: for, min,
}
-->

<statement>
<p>
	This function check the game state for a terminal state and sets the &lt;pf&gt;state.game_over&lt;/pf&gt; field to &lt;pf&gt;true&lt;/pf&gt;.
</p>

<tabular valign="top" top="minor">
	<col width="12%"/>
	<col width="88%"/>
	<row bottom="minor">
		<cell>Inputs:</cell>
		<cell>
			<p><pf>state</pf> (1 x 1) number — struct object representing the current game state.</p>
		</cell>
	</row>
	<row bottom="minor">
		<cell>Outputs:</cell>
		<cell>
			<p><pf>state</pf> (1 x 1) number — struct object containing an updated version of the state.</p>
		</cell>
	</row>
	<row>
		<cell>Details:</cell>
		<cell><p>Think about what conditions need to be met for a game to be over.</p></cell>
	</row>
	<row>
		<cell/>
		<cell><p>Play the demo again to refresh your memory.</p></cell>
	</row>
	<row>
		<cell/>
		<cell><p>This function updates the following fields listed below.</p></cell>
	</row>
	<row bottom="minor">
		<cell/>
		<cell>
			<p>
				<ul>
					<li><pf>state.player_won</pf></li>
					<li><pf>state.game_over</pf></li>
				</ul>
			</p>
		</cell>
	</row>
</tabular>

</statement>
