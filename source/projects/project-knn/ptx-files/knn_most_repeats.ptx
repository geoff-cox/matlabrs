<!--META-DATA
{
	tags: vector,
}
-->

<statement>
<p>
	Given a column vector of numbers, this program returns the value that occurs most often.
</p>

<tabular valign="top" top="minor">
	<col width="12%"/>
	<col width="88%"/>
	<row bottom="minor">
		<cell>Inputs:</cell>
		<cell>
			<p><pf>values</pf> (m x 1) double vector — a column vector of numeric values</p>
		</cell>
	</row>
	<row bottom="minor">
		<cell>Outputs:</cell>
		<cell>
			<p><pf>val</pf> (1 x 1) number — value in <pf>values</pf> that occurs most often</p>
		</cell>
	</row>
	<row>
		<cell>Details:</cell>
		<cell><p>If there is a tie, return the value that is closest to the beginning of the list.</p></cell>
	</row>
</tabular>

<p>
	Examples:
<program>
	<code>
		result = KNN_most_repeats_lastname([9; 3; 2; 3])
		result = 3
		result = KNN_most_repeats_lastname([9; 2; 3; 3; 2; 1; 3; 1; 4; 2; 5; 1])
		result = 2
	</code>
</program>
</p>
</statement>
