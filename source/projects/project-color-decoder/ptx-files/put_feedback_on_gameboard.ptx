<!--META-DATA
{
	tags: general,
}
-->

<statement>
<p>
	This function places the boxes on the game board.
</p>

<tabular valign="top" top="minor">
	<col width="12%"/>
	<col width="88%"/>
	<row bottom="minor">
		<cell>Inputs:</cell>
		<cell>
			<p><pf>current_attempt_num</pf> (double) double — is a number that indicates where the guess is on the game board (and therefore where the feedback should be placed)</p>
			<p><pf>num_black_feedback_boxes</pf> (double) double — is a number between 0 and 4 that indicates the number of black feedback boxes that should be added to the game board</p>
			<p><pf>num_white_feedback_boxes</pf> (double) double — is a number between 0 and 4 that indicates the number of white feedback boxes that should be added to the game board</p>
		</cell>
	</row>
	<row bottom="minor">
		<cell>Outputs:</cell>
		<cell>
			<p><pf>none</pf> (but the boxes are placed on the game board) number — value</p>
		</cell>
	</row>
</tabular>

<p>
	Examples:
<program>
	<code>
		INPUT
		3,2,1
		Game board:
		INPUT
		1,0,2
		Game board:
	</code>
</program>
</p>
</statement>
