<statement>
<p>
	Write a function <pf>create_guess_boxes_struct</pf>.
</p>

<tabular valign="top" top="minor">
	<col width="12%"/>
	<col width="88%"/>
	<row bottom="minor">
		<cell>Inputs:</cell>
		<cell>
			<p><pf>none</pf> number — value</p>
		</cell>
	</row>
	<row bottom="minor">
		<cell>Outputs:</cell>
		<cell>
			<p><pf>guess_boxes</pf> (6 5 struct with 4 fields) number — value</p>
		</cell>
	</row>
	<row>
		<cell>Details:</cell>
		<cell><p>Note that this function does not display the game board or the guess boxes. No plot/figure is involved in this function.</p></cell>
	</row>
	<row>
		<cell/>
		<cell><p>The purpose of this function is only to create the</p></cell>
	</row>
	<row>
		<cell/>
		<cell><p>guess_boxes</p></cell>
	</row>
	<row bottom="minor">
		<cell/>
		<cell><p>structure.</p></cell>
	</row>
</tabular>

</statement>
