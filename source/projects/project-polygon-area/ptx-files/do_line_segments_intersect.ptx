<!--META-DATA
{
	tags: for, logical,
}
-->

<statement>
<p>
	locates the theoretical intersection point of extended line segments checks if that point is on the actual line segments
</p>

<tabular valign="top" top="minor">
	<col width="12%"/>
	<col width="88%"/>
	<row bottom="minor">
		<cell>Inputs:</cell>
		<cell>
			<p><pf>line1</pf> (struct with 4 fields) number — structure containing the endpoints of the first line segment.</p>
			<p><pf>line2</pf> (struct with 4 fields) number — structure containing the endpoints of the second line segment.</p>
		</cell>
	</row>
	<row bottom="minor">
		<cell>Outputs:</cell>
		<cell>
			<p><pf>intersect</pf> ( logical) logical — : is <pf>true</pf> if <pf>line1</pf> intersects with <pf>line2</pf>. <pf>false</pf>, otherwise.</p>
		</cell>
	</row>
	<row>
		<cell>Details:</cell>
		<cell><p>The output structure,</p></cell>
	</row>
	<row>
		<cell/>
		<cell><p>line1</p></cell>
	</row>
	<row>
		<cell/>
		<cell><p>, contains the following fields:</p></cell>
	</row>
	<row>
		<cell/>
		<cell>
			<p>
				<ul>
					<li><pf>line1.x1</pf> : x-value of the first endpoint of the first line segment.</li>
					<li><pf>line1.y1</pf> : y-value of the first endpoint of the first line segment.</li>
					<li><pf>line1.x2</pf> : x-value of the second endpoint of the first line segment.</li>
					<li><pf>line1.y2</pf> : y-value of the second endpoint of the first line segment.</li>
				</ul>
			</p>
		</cell>
	</row>
	<row>
		<cell/>
		<cell><p>The output</p></cell>
	</row>
	<row>
		<cell/>
		<cell><p>line2</p></cell>
	</row>
	<row>
		<cell/>
		<cell><p>is defined similarly.</p></cell>
	</row>
	<row>
		<cell/>
		<cell><p>You should also call your</p></cell>
	</row>
	<row>
		<cell/>
		<cell><p>HW8P2_is_pt_on_line_segment</p></cell>
	</row>
	<row>
		<cell/>
		<cell><p>within this program.</p></cell>
	</row>
	<row>
		<cell/>
		<cell><p>This problem is easy to understand but is tricky to program.</p></cell>
	</row>
	<row>
		<cell/>
		<cell><p>You should probably break this problem down into a few special sub-cases.</p></cell>
	</row>
	<row bottom="minor">
		<cell/>
		<cell><p>Please take a look at the class notes on this topic for guidance.</p></cell>
	</row>
</tabular>

<p>
	Examples:
<program>
	<code>
		Examples_for_HW8P3.mlx
	</code>
</program>
</p>
</statement>
