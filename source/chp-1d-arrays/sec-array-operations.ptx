	<exercises xml:id="array-operations-exercises">
		<title>Practice Problems</title>

		<introduction>
			<p>
				Practice performing operations on arrays.
			</p>
		</introduction>

		<exercise>
			<title>Element-wise Calculations</title>
			<statement>
				<p>
					Given <c>x = [1 2 3 4 5]</c> and <c>y = [2 4 6 8 10]</c>, compute:
				</p>
				<ol>
					<li><c>z1 = x + y</c></li>
					<li><c>z2 = y ./ x</c></li>
					<li><c>z3 = x .^ 3</c></li>
				</ol>
			</statement>
			<solution component="example-solution-dev">
				<program language="matlab">
					<code>
						x = [1 2 3 4 5];
						y = [2 4 6 8 10];
						
						z1 = x + y;         % [3 6 9 12 15]
						z2 = y ./ x;        % [2 2 2 2 2]
						z3 = x .^ 3;        % [1 8 27 64 125]
					</code>
				</program>
			</solution>
		</exercise>

		<exercise>
			<title>Temperature Conversion</title>
			<statement>
				<p>
					Write a MATLAB command to convert the temperatures <c>[32 68 86 104 212]</c> from Fahrenheit to Celsius using the formula <m>C = \frac{5}{9}(F - 32)</m>.
				</p>
			</statement>
			<solution component="example-solution-dev">
				<program language="matlab">
					<code>
						F = [32 68 86 104 212];
						C = (5/9) * (F - 32);    % [0 20 30 40 100]
					</code>
				</program>
			</solution>
		</exercise>

		<exercise>
			<title>Computing Multiple Function Values</title>
			<statement>
				<p>
					Create a vector <c>theta</c> containing 100 evenly spaced angles from 0 to <m>2\pi</m>, then compute <c>y = sin(theta)</c>. What is the size and shape of the result?
				</p>
			</statement>
			<solution component="example-solution-dev">
				<program language="matlab">
					<code>
						theta = linspace(0, 2*pi, 100);
						y = sin(theta);
						% Result: y is a 1-by-100 row vector
					</code>
				</program>
			</solution>
		</exercise>
	</exercises>

</section>
