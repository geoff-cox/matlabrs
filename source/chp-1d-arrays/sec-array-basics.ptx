	<exercises xml:id="array-basics-exercises">
		<title>Practice Problems</title>

		<introduction>
			<p>
				These exercises help you practice identifying and working with different array types.
			</p>
		</introduction>

		<exercise>
			<title>Identifying Array Types</title>
			<statement>
				<p>
					For each of the following MATLAB expressions, determine whether the result is a scalar, row vector, column vector, or matrix:
				</p>
				<ol>
					<li><c>x = 7;</c></li>
					<li><c>y = [1 2 3 4];</c></li>
					<li><c>z = [1; 2; 3; 4];</c></li>
					<li><c>A = [1 2; 3 4; 5 6];</c></li>
				</ol>
			</statement>
			<solution>
				<p>
					<ol>
						<li>Scalar (1-by-1 array)</li>
						<li>Row vector (1-by-4 array)</li>
						<li>Column vector (4-by-1 array)</li>
						<li>Matrix (3-by-2 array)</li>
					</ol>
				</p>
			</solution>
		</exercise>

		<exercise>
			<title>Determining Array Size</title>
			<statement>
				<p>
					What will <c>size(B)</c> return for the following matrix?
				</p>
				<program language="matlab">
					<code>
						B = [10 20 30; 40 50 60];
					</code>
				</program>
			</statement>
			<solution>
				<p>
					<c>size(B)</c> returns <c>[2 3]</c>, indicating 2 rows and 3 columns.
				</p>
			</solution>
		</exercise>
	</exercises>

</section>
