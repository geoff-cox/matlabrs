<!--META-DATA
{
	tags: ["if", "char"],
}
-->

<statement>
	<p>
		Returns an object's direction given two 2D positions <m>(x,y)</m>: the initial position <pf>position_old</pf> and the final position <pf>position_new</pf>. The direction must be one of the eight cardinal directions:
	</p>

	<sidebyside width="60%">
		<p>
			<pf>'N'</pf>, <pf>'S'</pf>, <pf>'E'</pf>, <pf>'W'</pf>, <pf>'NE'</pf>, <pf>'NW'</pf>, <pf>'SE'</pf>, <pf>'SW'</pf>.
		</p>
	</sidebyside>
	
	<tabular valign="top" halign="right" top="minor">
		<col width="12%"/>
		<col width="88%" halign="left"/>
		<row>
			<cell>Inputs:</cell>
			<cell>
				<p><pf>position_old</pf> (1 x 2) double vector — contains the (x, y)-coordinates of the initial position</p>
			</cell>
		</row>
		<row bottom="minor">
			<cell/>
			<cell>
				<p><pf>position_new</pf> (1 x 2) double vector — contains the (x, y)-coordinates of the final position</p>
			</cell>
		</row>
		<row bottom="minor">
			<cell>Outputs:</cell>
			<cell>
				<p><pf>direction</pf> (1 x 1) or (1 x 2) character vector — indicating the movement direction</p>
			</cell>
		</row>
		<row>
			<cell>Details:</cell>
			<cell><p>▸ If <pf>position_old</pf> equals <pf>position_new</pf>, return the empty string <pf>''</pf>.</p></cell>
		</row>
		<row>
			<cell/>
			<cell><p>▸ Any movement in a primary direction should be reflected (for example, moving 10 units north and only 0.1 units west should return <pf>'NW'</pf>)</p></cell>
		</row>
		<row bottom="minor">
			<cell/>
			<cell><p>▸ Use an <pf>if</pf>-statement.</p></cell>
		</row>
	</tabular>

	<p>
		Examples:
		<program>
			<code>
				direction = get_direction([2 1], [3 1])
				% returns 'E'
			</code>
		</program>
		<program>
			<code>
				direction = get_direction([-2 1], [0 -8])
				% returns 'SE'
			</code>
		</program>
		<program>
			<code>
				direction = get_direction([8 -2], [-2 5])
				% returns 'NW'
			</code>
		</program>
		<program>
			<code>
				direction = get_direction([0 -2], [0 -2])
				% returns ''
			</code>
		</program>
	</p>
</statement>
<solution component="exercise-solution">
	<program language="matlab">
		function direction = get_direction(position_old, position_new)
			
				if isequal(position_old,position_new)
						direction = '';
						return
				end

				% extract the x and y coordinates from the old and new positions
				x_old = position_old(1);
				y_old = position_old(2);
				x_new = position_new(1);
				y_new = position_new(2);
				
				% change in y positive implies north
				if y_new - y_old > 0
						direction = 'N';
				elseif y_new - y_old < 0
						direction = 'S';
				else
						direction = '';
				end
				
				% change in x positive implies east
				if x_new - x_old > 0
						direction = [direction 'E'];
				elseif x_new - x_old < 0
						direction = [direction 'W'];
				end

		end
	</program>
</solution>
