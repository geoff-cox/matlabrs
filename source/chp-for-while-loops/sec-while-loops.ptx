						</row>
						<row bottom="minor">
							<cell>Outputs:</cell>
							<cell><p><pf>maxSteps</pf></p></cell>
							<cell><p>(1x1) double</p></cell>
							<cell><p>maximum number of steps to reach 1 for any number between <m>a</m> and <m>b</m></p></cell>
						</row>
					</tabular>
					<sidebyside widths="50% 48%">
