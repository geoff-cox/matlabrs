<exercises xml:id="exercises-for-while-loops">
	<title>💻 Coding Exercises</title>

	<exercise label="coding-drills-for-loops">
		<title>for-loop Drills</title>
		
		<task label="coding-drill-for-rewrite-1">
			<title>Rewrite repeated output: counting by fives</title>

			<statement>
				<p>
					Rewrite the repeated code below as a <pf>for</pf> loop:
				</p>

				<program language="matlab">
					fprintf('5\n');
					fprintf('10\n');
					fprintf('15\n');
					fprintf('20\n');
					fprintf('25\n');
				</program>

				<p>
					Your loop should produce the same output in the same order.
				</p>
			</statement>
		</task>

		<task label="coding-drill-for-rewrite-2">
			<title>Rewrite repeated output: countdown by twos</title>

			<statement>
				<p>
					Rewrite the repeated code below as a <pf>for</pf> loop:
				</p>

				<program language="matlab">
					fprintf('12\n');
					fprintf('10\n');
					fprintf('8\n');
					fprintf('6\n');
					fprintf('4\n');
					fprintf('2\n');
				</program>

				<p>
					Your loop should produce the same output in the same order.
				</p>
			</statement>
		</task>

		<task label="coding-drill-for-rewrite-3">
			<title>Rewrite repeated output: countdown by twos</title>

			<statement>
				<p>
					Rewrite only the repeated update lines below as a <pf>for</pf> loop:
				</p>

				<program language="matlab">
					total = 0;
					total = total + 3;
					total = total + 4;
					total = total + 5;
					total = total + 6;
					total = total + 7;
					fprintf('total = %i\n', total);
				</program>

				<p>
					Keep the initialization and final <pf>fprintf</pf> line.
				</p>
			</statement>
		</task>

	</exercise>

	<exercise label="coding-exercises-for-loops">
		<title>For-loop Exercises</title>

		<task label="coding-for-loop-display-powersOfTwo">
			<statement>
				<p>
					Write a function named <pf>powersOfTwo</pf> that uses <pf>fprintf</pf> and a <pf>for</pf> loop to compute and display the first <m>n</m> powers of 2.
				</p>
				<tabular valign="top" halign="right" top="minor">
					<col width="11%"/>
					<col width="15%"/>
					<col width="28%" halign="left"/>
					<col width="46%" halign="left"/>
					<row>
						<cell><p>Inputs:</p></cell>
						<cell><p><pf>n</pf></p></cell>
						<cell><p>(1x1) double</p></cell>
						<cell><p>number of powers of 2 to display</p></cell>
					</row>
					<row bottom="minor">
						<cell><p>Outputs:</p></cell>
						<cell><p>None</p></cell>
						<cell colspan="2"><p>display to command window with <pf>fprintf</pf></p></cell>
					</row>
				</tabular>
				<sidebyside widths="49% 49%">
					<stack>
						<p>Test Cases ⤵︎</p>
						<program language="matlab">
							fprintf("Test with n = 2:\n");
							powersOfTwo(2)
							fprintf("Test with n = 7:\n");
							powersOfTwo(7)
						</program>
					</stack>
					<stack>
						<p>Expected ⤵︎</p>
						<program language="matlab">
							Test with n = 2:
							2^1 = 2
							2^2 = 4
							Test with n = 7:
							2^1 = 2
							2^2 = 4
							2^3 = 8
							2^4 = 16
							2^5 = 32
							2^6 = 64
							2^7 = 128
						</program>
					</stack>
				</sidebyside>
			</statement>
			<!-- <solution>
				<p>
					Here is one possible solution:
				</p>
				<program language="matlab">
					function powersOfTwo(n)
						for k = 1:n
							fprintf('2^%d = %d\n', k, 2^k);
						end
					end
				</program>
			</solution> --> 
		</task>

		<task label="coding-for-sumSquares">
			<statement>
				<p>
					Write a function, <pf>sumSquares</pf> that computes 
					<me>1^2 + 2^2 + \cdots + n^2</me>
					for a given non-negative integer <m>n</m>. You must use a <pf>for</pf>-loop. If <m>n</m> is <m>0</m>, return <m>0</m>.
				</p>
				<tabular valign="top" halign="right" top="minor">
					<col width="11%"/>
					<col width="15%"/>
					<col width="28%" halign="left"/>
					<col width="46%" halign="left"/>
					<row>
						<cell><p>Inputs:</p></cell>
						<cell><p><pf>n</pf></p></cell>
						<cell><p>(1x1) double</p></cell>
						<cell><p>non-negative integer</p></cell>
					</row>
					<row bottom="minor">
						<cell><p>Outputs:</p></cell>
						<cell><p><pf>S</pf></p></cell>
						<cell><p>(1x1) double</p></cell>
						<cell><p>the sum of squares from 1 to n</p></cell>
					</row>
				</tabular>
				<sidebyside widths="49% 49%">
					<stack>
						<p>Test Cases ⤵︎</p>
						<program language="matlab">
							S = sumSquares(3)
							S = sumSquares(5)
						</program>
					</stack>
					<stack>
						<p>Expected ⤵︎</p>
						<program language="matlab">
							% S = 14 (1 + 4 + 9)
							% S = 55 (1 + 4 + 9 + 16 + 25)
						</program>
					</stack>
				</sidebyside>
			</statement>
			<!-- <solution>
				<p>
					Here is one possible solution:
				</p>
				<program language="matlab">
					function S = sumSquares(n)
						S = 0;
						for k = 1:n
							S = S + k^2;
						end
					end
				</program>
			</solution> --> 
		</task>

		<task xml:id="coding-for-loop-sumMultiples">
			<statement>
				<p>
					Write a function named <pf>sumMultiples</pf> that takes two nonnegative integers <pf>n</pf> and <pf>m</pf> and returns the sum of all multiples of <pf>m</pf> between <pf>1</pf> and <pf>n</pf> (inclusive).
					If there are no multiples, the sum should be <pf>0</pf>.
				</p>
				<tabular valign="top" halign="right" top="minor">
					<col width="12%"/>
					<col width="12%" halign="left"/>
					<col width="22%" halign="left"/>
					<col width="54%" halign="left"/>
					<row>
						<cell><p>Inputs:</p></cell>
						<cell><p><pf>n</pf></p></cell>
						<cell><p>(1x1) double</p></cell>
						<cell><p>upper limit</p></cell>
					</row>
					<row>
						<cell/>
						<cell><p><pf>m</pf></p></cell>
						<cell><p>(1x1) double</p></cell>
						<cell><p>multiple to sum</p></cell>
					</row>
					<row bottom="minor">
						<cell><p>Outputs:</p></cell>
						<cell><p><pf>total</pf></p></cell>
						<cell><p>(1x1) double</p></cell>
						<cell><p>sum of multiples of <pf>m</pf> from <pf>1</pf> to <pf>n</pf></p></cell>
					</row>
				</tabular>
				<sidebyside widths="49% 49%">
					<stack>
						<p>Test Cases ⤵︎</p>
						<program language="matlab">
							total = sumMultiples(10, 3)
							total = sumMultiples(20, 5)
							total = sumMultiples(15, 4)
							total = sumMultiples(10, 11)
						</program>
					</stack>
					<stack>
						<p>Expected ⤵︎</p>
						<program language="matlab">
							% total = 18 (3 + 6 + 9)
							% total = 50 (5 + 10 + 15 + 20)
							% total = 24 (4 + 8 + 12)
							% total = 0
						</program>
					</stack>
				</sidebyside>
			</statement>
			<!-- <solution>
				<p>
					Here is one possible solution:
				</p>
				<program language="matlab">
					function total = sumMultiples(n, m)
						total = 0;
						for k = 1:n
							if mod(k, m) == 0
								total = total + k;
							end
						end
					end
				</program>
			</solution> --> 
		</task>

		<task xml:id="coding-for-loop-prob3HeadsInARow">
			<statement>
				<p>
					Write a function named <pf>prob3HeadsInARow</pf> that estimates the probability of flipping 3 heads when flipping a coin 3 times.
					Inside the loop, simulate three coin flips using three separate calls to <pf>randi([0,1])</pf>. Let <pf>1</pf> represents heads and <pf>0</pf> represents tails.
				</p>
				<tabular top="minor">
					<col width="12%"/>
					<col width="15%" halign="left"/>
					<col width="28%" halign="left"/>
					<col width="45%" halign="left"/>
					<row>
						<cell><p>Inputs:</p></cell>
						<cell><p><pf>n</pf></p></cell>
						<cell><p>(1x1) double</p></cell>
						<cell><p>number of times we flip 3 coins</p></cell>
					</row>
					<row bottom="minor">
						<cell><p>Outputs:</p></cell>
						<cell><p><pf>prob</pf></p></cell>
						<cell><p>(1x1) double</p></cell>
						<cell><p>probability of 3 heads in a row</p></cell>
					</row>
				</tabular>
				<sidebyside widths="49% 49%">
					<stack>
						<p>Test Cases ⤵︎</p>
						<program language="matlab">
							rng(123);  % Set seed
							prob = prob3HeadsInARow(10)
							prob = prob3HeadsInARow(100)
							prob = prob3HeadsInARow(1000)
						</program>
					</stack>
					<stack>
						<p>Expected ⤵︎</p>
						<program language="matlab">
							󠀠
							% prob = 0.2000
							% prob = 0.1300
							% prob = 0.1200
						</program>
					</stack>
				</sidebyside>
				<aside>
					<title>What is <pf>rng(123)</pf>?</title>
					<p>
						Note: <pf>rng(123)</pf> sets the random seed (i.e., <pf>123</pf>) to ensure that the same sequence of random 
						numbers is generated each time, which allows for consistent test results. The seed value can be any integer.
					</p>
				</aside>
			</statement>
			<!-- <solution>
				<p>
					Here is one possible solution:
				</p>
				<program language="matlab">
					function prob = prob3HeadsInARow(n)
						count_HHH = 0;
						for k = 1:n
							flip1 = randi([0, 1]);
							flip2 = randi([0, 1]);
							flip3 = randi([0, 1]);
							if flip1 == 1 &amp;&amp; flip2 == 1 &amp;&amp; flip3 == 1
								count_HHH = count_HHH + 1;
							end
						end
						prob = count_HHH / n;
					end
				</program>	
			</solution> --> 
		</task>

		<task label="coding-for-loop-compoundBalance">
			<statement>
				<p>
					Given a starting balance and a monthly interest rate, write a function named <pf>compoundBalance</pf> 
					that returns the final balance of an account that has accumulated compound interest after a certain 
					number of months. Use a for-loop to compute the monthly interest and add to the balance. 
				</p>
				<tabular valign="top" halign="right" top="minor">
					<col width="11%"/>
					<col width="18%"/>
					<col width="28%" halign="left"/>
					<col width="43%" halign="left"/>
					<row>
						<cell><p>Inputs:</p></cell>
						<cell><p><pf>P</pf></p></cell>
						<cell><p>(1x1) double</p></cell>
						<cell><p>starting balance</p></cell>
					</row>
					<row>
						<cell/>
						<cell><p><pf>r</pf></p></cell>
						<cell><p>(1x1) double</p></cell>
						<cell><p>monthly interest rate</p></cell>
					</row>
					<row>
						<cell/>
						<cell><p><pf>months</pf></p></cell>
						<cell><p>(1x1) double</p></cell>
						<cell><p>number of months</p></cell>
					</row>
					<row bottom="minor">
						<cell><p>Outputs:</p></cell>
						<cell><p><pf>balance</pf></p></cell>
						<cell><p>(1x1) double</p></cell>
						<cell><p>final balance after interest</p></cell>
					</row>
				</tabular>
				<sidebyside widths="59% 39%">
					<stack>
						<p>Test Cases ⤵︎</p>
						<program language="matlab">
							format shortG	% For nicer output
							bal = compoundBalance(1000, 0.01, 12)
							bal = compoundBalance(500, 0.02, 6)
							bal = compoundBalance(1500, 0.005, 24)
						</program>
					</stack>
					<stack>
						<p>Expected ⤵︎</p>
						<program language="matlab">
							󠀠
							% bal ≈ 1126.8
							% bal ≈ 563.08
							% bal ≈ 1690.7
						</program>
					</stack>
				</sidebyside>
			</statement>
			<!-- <solution>
				<p>
					Here is one possible solution:
				</p>
				<program language="matlab">
					function balance = compoundBalance(P, r, months)
						balance = P;
						for k = 1:months
							interest = balance * r;
							balance = balance + interest;
						end
					end
				</program>
			</solution> --> 
		</task>

		<task label="coding-for-loop-isPrime">
			<statement>
				<p>
					An integer greater than 1 is <term>prime</term> if its only divisors are 1 and itself.
				</p>
				<p>
					Write a function named <pf>isXPrime</pf> that tests whether a given positive integer is prime. 
					Use a <pf>for</pf> loop and the <pf>mod</pf> function.
				</p>
				<p>
					As a comment in your code (below HR statement), explain why it is enough to check divisors up to the square root of the number you are testing. 
					Give an example to support your explanation.
				</p>
				<tabular valign="top" halign="right" top="minor">
					<col width="11%"/>
					<col width="15%"/>
					<col width="28%" halign="left"/>
					<col width="46%" halign="left"/>
					<row>
						<cell><p>Inputs:</p></cell>
						<cell><p><pf>x</pf></p></cell>
						<cell><p>(1x1) double</p></cell>
						<cell><p>positive integer to test</p></cell>
					</row>
					<row bottom="minor">
						<cell><p>Outputs:</p></cell>
						<cell><p><pf>tf</pf></p></cell>
						<cell><p>(1x1) logical</p></cell>
						<cell><p><pf>true</pf> if <pf>x</pf> is prime, <pf>false</pf> otherwise</p></cell>
					</row>
				</tabular>
				<sidebyside widths="49% 49%">
					<stack>
						<p>Test Cases ⤵︎</p>
						<program language="matlab">
							answer = isXPrime(17)
							answer = isXPrime(15)
							answer = isXPrime(1)
							answer = isXPrime(899321)
							answer = isXPrime(215773)
						</program>
					</stack>
					<stack>
						<p>Expected ⤵︎</p>
						<program language="matlab">
							% answer = true
							% answer = false
							% answer = false
							% answer = true
							% answer = false
						</program>
					</stack>
				</sidebyside>
			</statement>
			<!-- <solution>
				<p>
					Here is one possible solution:
				</p>
				<program language="matlab">
					function tf = isXPrime(x)
						if x &lt;= 1
							tf = false;	% Edge case handling
							return
						end
						tf = true;	% Assume x is prime until we find a divisor
						for k = 2:sqrt(x)	% Check divisors up to sqrt(x)
							if mod(x, k) == 0
								tf = false;	% Found a divisor =&gt; x is not prime
								return
							end
						end
					end
				</program>
				<aside>
					<title>Why do we only Check Divisors Up to <m>\sqrt{x}</m>?</title>
					<p>
						Suppose we are testing whether 36 is prime. The proper divisors of 36 are (2, 18), (3, 12), (4, 9), and (6, 6). The square root of 36 is 6. All other pairs of divisors must include one divisor less than 6 and one greater than 6. Therefore, we don't need to check 9 since 4 would have been found as a divisor.
					</p>
				</aside>
			</solution> --> 
		</task>

		<task label="coding-for-loop-sumProperDivisors">
			<statement>
				<p>
					Let <m>p</m> and <m>N</m> be positive integers, then 
					<ul marker="square">
						<li>
							<p>
								<line><m>p</m> is a <term>proper divisor</term> of <m>N</m> if <m>p &lt; N</m> and <m>p</m> divides <m>N</m> evenly.</line>
								<line><em>Example: the proper divisors of 12 are 1, 2, 3, 4, and 6.</em></line>
							</p>
						</li>
					</ul>
				</p>
				<p>
					Write a function, called <pf>sumProperDivisors</pf>, that computes the sum of the proper divisors of a given positive integer, <m>n</m>. Use a <pf>for</pf>-loop and the <pf>mod</pf> function.
				</p>
				<tabular valign="top" halign="right" top="minor">
					<col width="11%"/>
					<col width="21%"/>
					<col width="28%" halign="left"/>
					<col width="40%" halign="left"/>
					<row>
						<cell><p>Inputs:</p></cell>
						<cell><p><pf>n</pf></p></cell>
						<cell><p>(1x1) double</p></cell>
						<cell><p>positive integer</p></cell>
					</row>
					<row bottom="minor">
						<cell><p>Outputs:</p></cell>
						<cell><p><pf>sum_divisors</pf></p></cell>
						<cell><p>(1x1) double</p></cell>
						<cell><p>sum of proper divisors of n</p></cell>
					</row>
				</tabular>
				<sidebyside widths="49% 49%">
					<stack>
						<p>Test Cases ⤵︎</p>
						<program language="matlab">
							out = sumProperDivisors(6)
							out = sumProperDivisors(8)
							out = sumProperDivisors(12)
							out = sumProperDivisors(1)
						</program>
					</stack>
					<stack>
						<p>Expected ⤵︎</p>
						<program language="matlab">
							% out = 6 (1 + 2 + 3)
							% out = 7 (1 + 2 + 4)
							% out = 16 (1 + 2 + 3 + 4 + 6)
							% out = 0 (no proper divisors)
						</program>
					</stack>
				</sidebyside>
			</statement>
			<!-- <solution>
				<p>
					Here is one possible solution:
				</p>
				<program language="matlab">
					function sum_divisors = sumProperDivisors(n)
						sum_divisors = 0;
						for k = 1:(n-1) % Check all numbers less than n
							if mod(n, k) == 0
								sum_divisors = sum_divisors + k; % Found one, add it
							end
						end
					end
				</program>
			</solution> --> 
		</task>

		<task label="coding-for-loop-classifyNumber">
			<statement>
				<p>
					Let <m>p</m> and <m>N</m> be positive integers, then 
					<ul marker="square">
						<li>
							<p>
								<line><m>N</m> is <q><term>perfect</term></q> if it equals the sum of its proper divisors.</line>
								<line><em>N = 6 is perfect because <m>1 + 2 + 3 = 6</m>.</em></line>
							</p>
						</li>
						<li>
							<p>
								<line><m>N</m> is <q><term>abundant</term></q> if it is less than the sum of its proper divisors.</line>
								<line><em>N = 12 is abundant because <m>12 &lt; 1 + 2 + 3 + 4 + 6 = 16</m>.</em></line>
							</p>
						</li>
						<li>
							<p>
								<line><m>N</m> is <q><term>deficient</term></q> if it is greater than the sum of its proper divisors.</line>
								<line><em>N = 8 is deficient because <m>8 &gt; 1 + 2 + 4 = 7</m>.</em></line>
							</p>
						</li>
					</ul>
				</p>
				<p>
					Write a function, called <pf>classifyNumber</pf>, that classifies a given positive integer as <pf>"perfect"</pf>, <pf>"abundant"</pf>, or <pf>"deficient"</pf>. Use the function from the previous task as a helper function.
				</p>
				<tabular valign="top" halign="right" top="minor">
					<col width="11%"/>
					<col width="10%"/>
					<col width="28%" halign="left"/>
					<col width="51%" halign="left"/>
					<row>
						<cell><p>Inputs:</p></cell>
						<cell><p><pf>N</pf></p></cell>
						<cell><p>(1x1) double</p></cell>
						<cell><p>positive integer</p></cell>
					</row>
					<row bottom="minor">
						<cell><p>Outputs:</p></cell>
						<cell><p><pf>type</pf></p></cell>
						<cell><p>(1x1) string</p></cell>
						<cell><p><pf>"perfect"</pf>, <pf>"abundant"</pf>, or <pf>"deficient"</pf> depending on n</p></cell>
					</row>
				</tabular>
				<sidebyside widths="49% 49%">
					<stack>
						<p>Test Cases ⤵︎</p>
						<program language="matlab">
							type = classifyNumber(6)
							type = classifyNumber(8)
							type = classifyNumber(12)
							type = classifyNumber(1)
						</program>
					</stack>
					<stack>
						<p>Expected ⤵︎</p>
						<program language="matlab">
							% type = "perfect"
							% type = "deficient"
							% type = "abundant"
							% type = "deficient"
						</program>
					</stack>
				</sidebyside>
			</statement>
			<!-- <solution>
				<p>
					Here is one possible solution:
				</p>
				<program language="matlab">
					function type = classifyNumber(N)
						sum_divisors = sumProperDivisors(N); % Call helper function
						if N == sum_divisors
							type = "perfect";
						elseif N &lt; sum_divisors
							type = "abundant";
						else
							type = "deficient";
						end
					end
				</program>
			</solution> --> 
		</task>

		<task label="coding-for-loop-approxE">
			<statement>
				<p>
					Write a function named <pf>approxE</pf> that takes a nonnegative integer <pf>n</pf> and returns the approximation
					<me>e \approx 1 + \frac{1}{1!} + \frac{1}{2!} + \cdots + \frac{1}{n!}.</me>
					Use one <pf>for</pf>-loop.
				</p>
				<tabular valign="top" halign="right" top="minor">
					<col width="12%"/>
					<col width="15%"/>
					<col width="25%" halign="left"/>
					<col width="48%" halign="left"/>
					<row>
						<cell><p>Inputs:</p></cell>
						<cell><p><pf>n</pf></p></cell>
						<cell><p>(1x1) double</p></cell>
						<cell><p>nonnegative integer</p></cell>
					</row>
					<row bottom="minor">
						<cell><p>Outputs:</p></cell>
						<cell><p><pf>approx</pf></p></cell>
						<cell><p>(1x1) double</p></cell>
						<cell><p>approximation of e using n terms</p></cell>
					</row>
				</tabular>
				<sidebyside widths="49% 49%">
					<stack>
						<p>Test Cases ⤵︎</p>
						<program language="matlab">
							out = approxE(0)
							out = approxE(1)
							out = approxE(5)
						</program>
					</stack>
					<stack>
						<p>Expected ⤵︎</p>
						<program language="matlab">
							% out = 1 (1)
							% out = 2 (1 + 1)
							% out = 2.7167 (approximates e)
						</program>
					</stack>
				</sidebyside>
			</statement>
			<!-- <solution>
				<p>
					Here is one possible solution:
				</p>
				<program language="matlab">
					function approx = approxE(n)
						approx = 1;
						factorial = 1; % To keep track of k!
						for k = 1:n
							factorial = factorial * k; % Update factorial to k!
							approx = approx + 1/factorial; % Add 1/k!
						end
					end
				</program>
			</solution> --> 
		</task>

		<task label="coding-for-loop-approxEofx">
			<statement>
				<p>
					The following (partial) sum converges to <m>e^x</m> as <m>N \to \infty</m>: 
					<me>
						\sum_{k=0}^{N} \frac{x^k}{k!} = 1 + \frac{x}{1!} + \frac{x^2}{2!} + \cdots + \frac{x^N}{N!}
					</me>
				</p>
				<p>
					So for large <m>N</m> this series can be used to approximate <m>e^x</m>:
					<me>
						e^x \approx 1 + \frac{x}{1!} + \frac{x^2}{2!} + \cdots + \frac{x^N}{N!}
					</me>
					for any real number <m>x</m>.
				</p>
				<p>
					Write a function named <pf>approxEofx</pf> that takes a real number <pf>x</pf> and a positive integer <pf>N</pf> and returns the approximation of <m>e^x</m> using the series above. Use one <pf>for</pf>-loop.
				</p>
				<tabular valign="top" halign="right" top="minor">
					<col width="12%"/>
					<col width="15%"/>
					<col width="25%" halign="left"/>
					<col width="48%" halign="left"/>
					<row>
						<cell><p>Inputs:</p></cell>
						<cell><p><pf>x</pf></p></cell>
						<cell><p>(1x1) double</p></cell>
						<cell><p>real number</p></cell>
					</row>
					<row>
						<cell/>
						<cell><p><pf>N</pf></p></cell>
						<cell><p>(1x1) double</p></cell>
						<cell><p>positive integer</p></cell>
					</row>
					<row bottom="minor">
						<cell><p>Outputs:</p></cell>
						<cell><p><pf>approx</pf></p></cell>
						<cell><p>(1x1) double</p></cell>
						<cell><p>approximation of <m>e^x</m> using <m>N</m> terms</p></cell>
					</row>
				</tabular>
				<sidebyside widths="44% 54%">
					<stack>
						<p>Test Cases ⤵︎</p>
						<program language="matlab">
							out = approxEofx(0, 10)
							out = approxEofx(1, 10)
							out = approxEofx(2, 20)
						</program>
					</stack>
					<stack>
						<p>Expected ⤵︎</p>
						<program language="matlab">
							% out = 1 (e^0 = 1)
							% out ≈ 2.7183 (approximates e^1)
							% out ≈ 7.3891 (approximates e^2)
						</program>
					</stack>
				</sidebyside>
			</statement>
			<!-- <solution>
				<p>
					Here is one possible solution:
				</p>
				<program language="matlab">
					function approx = approxEofx(x, N)
						approx = 1;
						factorial = 1; % To keep track of k!
						for k = 0:N
							if k &gt; 0
								factorial = factorial * k; % Update factorial to k!
							end
							approx = approx + (x^k)/factorial; % Add x^k/k!
						end
					end
				</program>
			</solution> --> 
		</task>

		<task label="coding-for-loop-binomialCoeff">
			<statement>
				<p>
					Write a function, <pf>binomialCoeff</pf>, that computes <m>n</m> choose <m>m</m> (the binomial coefficient) using the formula:
					<me>
						\binom{n}{m} = \frac{n!}{m!(n-m)!}
					</me>. 
					Use a for loop. Assume <m>n</m> is a nonnegative integer and <m>m</m> is a non-negative integer less than or equal to <m>n</m>.
				</p>
				<p>
					To code this with one for loop, expand <m>n!</m> down to <m>(n-m)!</m>:
					<me>n(n-1)(n-2)\cdots(n-(m-1))(n-m)!</me>
					then cancel the <m>(n-m)!</m> in the numerator and denominator to get:
					<me>
						\binom{n}{m} = \frac{n(n-1)(n-2)\cdots(n-(m-1))}{m(m-1)(m-2)\cdots 1}
					</me>
					But this is the same as:
					<me>
						\binom{n}{m} = \frac{n}{m}\cdot\frac{n-1}{m-1}\cdot\frac{n-2}{m-2}\cdots\frac{n-(m-1)}{1}
					</me>
					This way, you can compute each fraction for <m>k=0,1,2,\ldots,m-1</m>.
				</p>
				<tabular valign="top" halign="right" top="minor">
					<col width="12%"/>
					<col width="88%" halign="left"/>
					<row>
						<cell>Inputs:</cell>
						<cell>
							<p><pf>n</pf> (1x1) double — nonnegative integer</p>
							<p><pf>m</pf> (1x1) double — non-negative integer less than or equal to <m>n</m></p>
						</cell>
					</row>
					<row bottom="minor">
						<cell>Outputs:</cell>
						<cell>
							<p><pf>bicoeff</pf> (1x1) double — the binomial coefficient <m>\binom{n}{m}</m></p>
						</cell>
					</row>
				</tabular>
				<sidebyside widths="49% 49%">
					<stack>
						<p>Test Cases ⤵︎</p>
						<program language="matlab">
							bcoef = binomialCoeff(5, 2)
							bcoef = binomialCoeff(0, 0)
							bcoef = binomialCoeff(7, 7)
							bcoef = binomialCoeff(10, 3)
						</program>
					</stack>
					<stack>
						<p>Expected ⤵︎</p>
						<program language="matlab">
							% bcoef = 10 (5!/(2!*(5-2)!))
							% bcoef = 1 (0!/(0!*0!))
							% bcoef = 1 (7!/(7!*0!))
							% bcoef = 120 (10!/(3!*7!))
						</program>
					</stack>
				</sidebyside>
			</statement>
			<!-- <solution>
				<p>
					Here is one way to compute the binomial coefficient using a for loop:
				</p>
				<program language="matlab">
					function F = binomialCoeff(n, m)
						numerator = 1;
						denominator = 1;

						for k = 0:(m-1)
							numerator = numerator * (n - k);
							denominator = denominator * (m - k);
						end

						F = numerator / denominator;
					end
				</program>
			</solution> --> 
		</task>

		<task xml:id="coding-for-loop-countRunsOfOnes">
			<statement>
				<p>
					Write a function named <pf>countRunsOfOnes</pf> that simulates <pf>n</pf> single coin flips using <pf>randi([0,1])</pf> and returns the number of <em>runs</em> of one or more consecutive heads.
				</p>
				<p>
					Before you start coding, think about what information you need to count the runs. It is less than you might expect. You may find it helpful to write out some sequences of coin flips and count the runs by hand.
				</p>
				<p>
					For example, 
					<ul>
						<li>the flip sequence <pf>0 1 1 0 1 0 1 1 1</pf> contains 3 runs of heads.</li>
						<li>the flip sequence <pf>1 1 0 0 1 1 1 0</pf> contains 2 runs of heads.</li>
						<li>the flip sequence <pf>0 0 0 0</pf> contains 0 runs of heads.</li>
						<li>the flip sequence <pf>1 1 1 1 1 1</pf> contains 1 run of heads.</li>
					</ul>
				</p>
				<tabular valign="top" halign="right" top="minor">
					<col width="12%"/>
					<col width="12%" halign="left"/>
					<col width="22%" halign="left"/>
					<col width="54%" halign="left"/>
					<row>
						<cell><p>Inputs:</p></cell>
						<cell><p><pf>n</pf></p></cell>
						<cell><p>(1x1) double</p></cell>
						<cell><p>number of coin flips</p></cell>
					</row>
					<row bottom="minor">
						<cell><p>Outputs:</p></cell>
						<cell><p><pf>runs</pf></p></cell>
						<cell><p>(1x1) double</p></cell>
						<cell><p>number of runs of consecutive heads</p></cell>
					</row>
				</tabular>
				<sidebyside widths="49% 49%">
					<stack>
						<p>Test Cases ⤵︎</p>
						<program language="matlab">
							rng(123);  % Set seed
							runs = countRunsOfOnes(10)
							runs = countRunsOfOnes(100)
							runs = countRunsOfOnes(600)
							runs = countRunsOfOnes(0)
						</program>
					</stack>
					<stack>
						<p>Expected ⤵︎</p>
						<program language="matlab">
							󠀠
							% runs = 3
							% runs = 20
							% runs = 160
							% runs = 0 (no flips)
						</program>
					</stack>
				</sidebyside>
			</statement>
			<!-- <solution>
				<p>
					Here is one possible solution:
				</p>
				<program language="matlab">
					function runs = countRunsOfOnes(n)
						runs = 0;
						prev = 0;
						for k = 1:n
							cur = randi([0,1]);
							if cur == 1 &amp;&amp; prev == 0
								runs = runs + 1;
							end
							prev = cur;
						end
					end
				</program>
			</solution> --> 
		</task>

		<task xml:id="coding-for-loop-longestHeadRun">
			<statement>
				<p>
					Write a function named <pf>longestHeadRun</pf> that simulates <pf>n</pf> single coin flips using <pf>randi([0,1])</pf> and returns the length of the longest run of consecutive heads.
					If <pf>n = 0</pf>, return <pf>0</pf>.
				</p>
				<p>
					For example, 
					<ul>
						<li>the longest head run of the sequence <pf>1 0 1 1 1 0 1</pf> is <pf>3</pf>.</li>
						<li>the longest head run of the sequence <pf>1 1 0 0 1 0 1 1</pf> is <pf>2</pf>.</li>
						<li>the longest head run of the sequence <pf>0 0 0 0</pf> is <pf>0</pf>.</li>
						<li>the longest head run of the sequence <pf>1 1 1 1 1 1</pf> is <pf>6</pf>.</li>
					</ul>
				</p>
				<tabular valign="top" halign="right" top="minor">
					<col width="12%"/>
					<col width="15%" halign="left"/>
					<col width="22%" halign="left"/>
					<col width="51%" halign="left"/>
					<row>
						<cell><p>Inputs:</p></cell>
						<cell><p><pf>n</pf></p></cell>
						<cell><p>(1x1) double</p></cell>
						<cell><p>number of coin flips</p></cell>
					</row>
					<row bottom="minor">
						<cell><p>Outputs:</p></cell>
						<cell><p><pf>maxLen</pf></p></cell>
						<cell><p>(1x1) double</p></cell>
						<cell><p>length of the longest run of heads</p></cell>
					</row>
				</tabular>
				<sidebyside widths="49% 49%">
					<stack>
						<p>Test Cases ⤵︎</p>
						<program language="matlab">
							rng(123);  % Set seed
							maxLen = longestHeadRun(10)
							maxLen = longestHeadRun(100)
							maxLen = longestHeadRun(600)
							maxLen = longestHeadRun(0)
						</program>
					</stack>
					<stack>
						<p>Expected ⤵︎</p>
						<program language="matlab">
							󠀠
							% maxLen = 2
							% maxLen = 8
							% maxLen = 11
							% maxLen = 0 (no flips)
						</program>
					</stack>
				</sidebyside>
			</statement>
			<!-- <solution>
				<p>
					Here is one possible solution:
				</p>
				<program language="matlab">
					function maxLen = longestHeadRun(n)
						maxLen = 0;
						currentLen = 0;
						for k = 1:n
							coin = randi([0, 1]);
							if coin == 1
								currentLen = currentLen + 1; % increase the steak count
								if currentLen > maxLen  % Update max length, if needed
									maxLen = currentLen;
								end
							else
								currentLen = 0; % Reset current run length on a tail
							end
						end
					end
				</program>
			</solution>	 -->
		</task>

		<task xml:id="coding-for-loop-movePoint">
			<statement>
				<p>
					Given a starting point <m>(x,y)</m>, a slope <m>m</m> and a step size <m>h</m>, 
					write a function called <pf>movePoint</pf> that returns the coordinates of a new point, <m>(x_f,y_f)</m>,  
					that results from moving <m>(x,y)</m> in the direction of <m>m</m> when <m>x</m> is increased by <m>h</m>.
				</p>
				<p>
					Clearly, <m>x_f = x + h</m>. For <m>y_f</m>, get out a piece of paper and do some math to find a formula for <m>y_f</m> in terms of the given inputs: <m>x</m>, <m>y</m>, <m>m</m>, and <m>h</m>.
				</p>
				<tabular valign="top" halign="right" top="minor">
					<col width="12%"/>
					<col width="15%" halign="left"/>
					<col width="22%" halign="left"/>
					<col width="51%" halign="left"/>
					<row>
						<cell><p>Inputs:</p></cell>
						<cell><p><pf>x</pf></p></cell>
						<cell><p>(1x1) double</p></cell>
						<cell><p><m>x</m>-coordinate of starting point</p></cell>
					</row>
					<row>
						<cell><p></p></cell>
						<cell><p><pf>y</pf></p></cell>
						<cell><p>(1x1) double</p></cell>
						<cell><p><m>y</m>-coordinate of starting point</p></cell>
					</row>
					<row>
						<cell><p></p></cell>
						<cell><p><pf>m</pf></p></cell>
						<cell><p>(1x1) double</p></cell>
						<cell><p>slope of movement direction</p></cell>
					</row>
					<row>
						<cell><p></p></cell>
						<cell><p><pf>h</pf></p></cell>
						<cell><p>(1x1) double</p></cell>
						<cell><p>step size in <m>x</m>-direction</p></cell>
					</row>
					<row>
						<cell><p>Outputs:</p></cell>
						<cell><p><pf>xf</pf></p></cell>
						<cell><p>(1x1) double</p></cell>
						<cell><p><m>x</m>-coordinate of new point.</p></cell>
					</row>
					<row bottom="minor">
						<cell/>
						<cell><p><pf>yf</pf></p></cell>
						<cell><p>(1x1) double</p></cell>
						<cell><p><m>y</m>-coordinate of new point.</p></cell>
					</row>
				</tabular>
				<sidebyside widths="53% 45%">
					<stack>
						<p>Test Cases ⤵︎</p>
						<program language="matlab">
							[xf,yf] = movePoint(0,0,1,1)
							[xf,yf] = movePoint(1,2,-1,2)
							[xf,yf] = movePoint(-1,-1,0.5,3)
						</program>
					</stack>
					<stack>
						<p>Expected ⤵︎</p>
						<program language="matlab">
							% xf ≈ 1, yf ≈ 1
							% xf ≈ 3, yf ≈ 0
							% xf ≈ 2, yf ≈ 0.5
						</program>
					</stack>
				</sidebyside>
			</statement>
			<!-- <solution>
				<p>
					Here is one way to compute the new point:
				</p>
				<program language="matlab">
					function [xf, yf] = movePoint(x, y, m, h)
						xf = x + h;
						yf = y + m * h;
					end
				</program>
			</solution>  -->
		</task>

		<task xml:id="coding-for-loop-moveInYsDirection">
			<statement>
				<p>
					Let <m>y(x)</m> be the solution to the differential equation:
					<me>
						y' = 2y-2xy, \quad y(0) = y_0
					</me>.
					In this form, the right-side of the equation gives the slope of the tangent line of <m>y(x)</m> (i.e., the direction of <m>y</m>) at any point <m>(x,y)</m>.
				</p>
				<p>
					For example, to get the direction of <m>y(x)</m> at the point <m>(3,1)</m>, we plug <m>x=3</m> and <m>y=1</m> into <m>2y-2xy</m> to get <m>m=2\cdot 1 - 2\cdot 3 \cdot 1 = -4</m>.
				</p>
				<p>
					Write a function called <pf>moveInYsDirection</pf> that returns a final <m>y</m>-value after moving the initial point <m>(0, y_0)</m> through a sequence of points in the same direction as <m>y(x)</m>. That is,
					<me>
						(0, y_0) \to (x_1, y_1) \to (x_2, y_2) \to \cdots \to (x_f, y_f)
					</me>
					where each new point is found by moving from the previous point in the direction of <m>y(x)</m>. 
					For example, we get <m>(x_1, y_1)</m> by moving <m>(0, y_0)</m> in the direction we would get from plugging <m>(0, y_0)</m> into <m>2y-2xy</m>.
					Repeat this for each point and stop when <m>x_f</m> is reached.
				</p>
				<p>
					To code this, 
					<ul marker="square">
						<li>Compute the number of steps needed to go from <m>0</m> to <m>x_f</m> using the step size <m>h</m>. This will be the number of times to run the loop.</li>
						<li>Define variables <pf>x</pf> and <pf>y</pf> to keep track of the current point. Initialize them as <m>(0, y_0)</m>.</li>
						<li>For each step of the loop, update <pf>x</pf> and <pf>y</pf> as the output of your <pf>movePoint</pf> helper function.</li>
						<li>When the loop finishes, <pf>y</pf> should be the <m>y</m>-value of <m>(x_f, y_f)</m>.</li>
					</ul>
				</p>
				<tabular valign="top" halign="right" top="minor">
					<col width="12%"/>
					<col width="15%" halign="left"/>
					<col width="22%" halign="left"/>
					<col width="51%" halign="left"/>
					<row>
						<cell><p>Inputs:</p></cell>
						<cell><p><pf>y0</pf></p></cell>
						<cell><p>(1x1) double</p></cell>
						<cell><p><m>y</m>-coordinate of the starting point</p></cell>
					</row>
					<row>
						<cell><p></p></cell>
						<cell><p><pf>xf</pf></p></cell>
						<cell><p>(1x1) double</p></cell>
						<cell><p><m>x</m>-coordinate of the final point</p></cell>
					</row>
					<row>
						<cell><p></p></cell>
						<cell><p><pf>h</pf></p></cell>
						<cell><p>(1x1) double</p></cell>
						<cell><p>step size in <m>x</m>-direction</p></cell>
					</row>
					<row bottom="minor">
						<cell><p>Outputs:</p></cell>
						<cell><p><pf>yf</pf></p></cell>
						<cell><p>(1x1) double</p></cell>
						<cell><p><m>y</m>-coordinate of the final point</p></cell>
					</row>
				</tabular>
				<sidebyside widths="54% 44%">
					<stack>
						<p>Test Cases ⤵︎</p>
						<program language="matlab">
							yf = moveInYsDirection(1, 2, 1)
							yf = moveInYsDirection(1, 2, 0.5)
							yf = moveInYsDirection(1, 2, 0.1)
							yf = moveInYsDirection(1, 2, 0.01)
						</program>
					</stack>
					<stack>
						<p>Expected ⤵︎</p>
						<program language="matlab">
							% yf = 3.0
							% yf = 1.5
							% yf ≈ 1.0694
							% yf ≈ 1.0067
						</program>
					</stack>
				</sidebyside>
			</statement>
			<!-- <solution>
				<p>
					Here is one way to approximate <m>y(x_f)</m> using a for loop and the <pf>movePoint</pf> function:
				</p>
				<program language="matlab">
					function yf = moveInYsDirection(y0, xf, h)
						x = 0;
						y = y0;

						numSteps = ceil(xf / h);

						for i = 1:numSteps
							slope = 2*y - 2*x*y;  % Compute slope at current point
							[x, y] = movePoint(x, y, slope, h);  % Move to next point
						end

						yf = y;  % Final approximation of y(xf)
					end
				</program>
			</solution> --> 
		</task>
	</exercise>

