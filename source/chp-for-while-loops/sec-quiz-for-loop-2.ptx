<section xml:id="sec-quiz-looping-for-fundamentals-v2" component="quiz">
	<title>for-Loops Quiz (Fundamentals)</title>

	<worksheet xml:id="ws-quiz-looping-for-fundamentals-v2">
		<title>Quiz: for-Loops (Fundamentals)</title>

		<sidebyside widths="10% 90%">
			<stack>
				<p>NAME:</p>
				<p>HR:</p>
			</stack>
			<stack><p/></stack>
		</sidebyside>

    <!-- ========================================================= -->
    <!-- Conceptual Questions																			 -->
    <!-- ========================================================= -->

		<exercise xml:id="quiz-for-loop-conceptual">
			<title>Conceptual Questions</title>

			<task xml:id="quiz-for-loop-conceptual-1">
				<statement>
					<p>
						Which loop header generates the <pf>k</pf>-values: <pf>3, 6, 9, 12, 15</pf>?
					</p>
				</statement>
				<choices randomize="no">
					<choice correct="yes">
						<statement><p><pf>for k = [3, 6, 9, 12, 15]</pf></p></statement>
					</choice>
					<choice>
						<statement><p><pf>for k = 1:3:15</pf></p></statement>
					</choice>
					<choice>
						<statement><p><pf>for k = 3:6:15</pf></p></statement>
					</choice>
					<choice>
						<statement><p><pf>for k = 3:2:15</pf></p></statement>
					</choice>
					<choice correct="yes">
						<statement><p><pf>for k = 3:3:15</pf></p></statement>
					</choice>
				</choices>
			</task>

			<task xml:id="quiz-for-loop-conceptual-2">
				<statement>
					<p>
						What are the <pf>k</pf>-values generated by the loop header: <pf>for k = 4:-2:-3</pf>?
					</p>
				</statement>
				<choices randomize="no">
					<choice>
						<statement><p><pf>4, 2, 0, -2, -4</pf></p></statement>
						<feedback><p>With a step of <pf>-2</pf>, the next value after <pf>-2</pf> would be <pf>-4</pf>, which overshoots past <pf>-3</pf>, so it is not included.</p></feedback>
					</choice>
					<choice correct="yes">
						<statement><p><pf>4, 2, 0, -2</pf></p></statement>
						<feedback><p>Start at 4 and subtract 2 each time. The next value would be <pf>-4</pf>, which goes past the stop value <pf>-3</pf>, so the loop ends at <pf>-2</pf>.</p></feedback>
					</choice>
					<choice>
						<statement><p><pf>4, 2, 0, -2, -3</pf></p></statement>
						<feedback><p><pf>-3</pf> is the stop value, but it is only included if the step lands on it exactly.</p></feedback>
					</choice>
					<choice>
						<statement><p><pf>2, 0, -2</pf></p></statement>
						<feedback><p>The start value 4 is missing.</p></feedback>
					</choice>
				</choices>
			</task>

		</exercise>

    <!-- ========================================================= -->
    <!-- Rewrite the Code (repeated code ↔ for-loop)     					 -->
    <!-- ========================================================= -->

		<exercise xml:id="quiz-for-loop-rewrite">
			<title>Rewrite Repeated Code and Loop Code</title>

			<statement>
				<p>
					Rewrite each of the following repeated code snippets using a single <pf>for</pf>-loop. Your loop should produce the same output in the same order.
				</p>

				<sidebyside widths="47% 52%">
					<stack>
						<program language="matlab">
							fprintf('Step 1 of 6 complete\n')
							fprintf('Step 2 of 6 complete\n')
							fprintf('Step 3 of 6 complete\n')
							fprintf('Step 4 of 6 complete\n')
							󠀠
						</program>
					</stack>
					<stack>
						<program component="stu" language="matlab" line-numbers="no">
							%─── TYPE YOUR CODE HERE ───%
							󠀠
							󠀠
							󠀠
							󠀠
							󠀠
						</program>
						<program component="key" language="matlab" line-numbers="no">
							%─── TYPE YOUR CODE HERE ───%
							for k = 1:4
							 fprintf('Step %d of 6 complete\n',k)
							end
							󠀠
						</program>
					</stack>
				</sidebyside>

				<sidebyside widths="47% 52%">
					<stack>
						<program language="matlab">
							score = 10;
							score = score*1 + 1/4;
							score = score*2 + 1/6;
							score = score*3 + 1/8;
							score = score*4 + 1/10;
							score = score*5 + 1/12;
						</program>
					</stack>
					<stack>
						<program component="stu" language="matlab" line-numbers="no">
							%─── TYPE YOUR CODE HERE ───%
							󠀠
							󠀠
							󠀠
							󠀠
							󠀠
						</program>
						<program component="key" language="matlab" line-numbers="no">
							%─── TYPE YOUR CODE HERE ───%
							score = 10;
							for k = 1:5
							  score = score*k + 1/(2*k+2);
							end
							󠀠
						</program>
					</stack>
				</sidebyside>
			</statement>
		</exercise>

		<!-- ========================================================= -->
		<!-- Output-Tracing Questions																	 -->
		<!-- ========================================================= -->

		<exercise xml:id="quiz-for-loop-output">
			<title>Determine the Printed Values</title>

			<statement>
				<p>
					For each of the following code snippets, determine what is printed by <pf>fprintf</pf>.
				</p>

				<sidebyside widths="49% 49%">
					<stack>
						<program language="matlab">
							total = 0;
							for k = 1:4
								total = total + k*(k-1);
							end
							fprintf('total = %d\n', total)
						</program>
					</stack>
					<stack>
						<program component="stu" language="matlab" line-numbers="no">
							% What does this print?
							
							
							
							total = 
						</program>
						<program component="key" language="matlab" line-numbers="no">
							% What does this print?
							
							
							
							total = 20
						</program>
					</stack>
				</sidebyside>

				<sidebyside widths="49% 49%">
					<stack>
						<program language="matlab">
							x = 1;
							for k = 4:4:11
								x = 2-x;
							end
							fprintf('x = %d\n', x)
						</program>
					</stack>
					<stack>
						<program component="stu" language="matlab" line-numbers="no">
							% What does this print?
							
							
							
							x = 
						</program>
						<program component="key" language="matlab" line-numbers="no">
							% What does this print?
							
							
							
							x = 1
						</program>
					</stack>
				</sidebyside>
			</statement>

		</exercise>

		<exercise xml:id="quiz-for-loop-function-output">
			<title>Determine the Output of Functions</title>

			<statement>
				<p>
					For each of the following functions, determine the output when called with the given input.
				</p>

				<p>
					What does this function return when <pf>x = 3</pf>?
				</p>

				<sidebyside widths="49% 49%">
					<stack>
						<program language="matlab">
							function y = bump(x)
								y = x;
								for k = 1:5
									y = y + 2*k;
								end
							end
						</program>
					</stack>
					<stack>
						<program component="stu" language="matlab" line-numbers="no">
							% What is the value of out?

							out = bump(3);
							󠀠
							out = 
							󠀠
						</program>
						<program component="key" language="matlab" line-numbers="no">
							% What is the value of out?

							out = bump(3);
							󠀠
							out = 33
							󠀠
						</program>
					</stack>
				</sidebyside>

				<p>
					What does this function return when <pf>n = 6</pf>?
				</p>

				<sidebyside widths="49% 49%">
					<stack>
						<program language="matlab">
							function c = dump(n)
								c = 0;
								for k = 1:n
									if mod(k, 3) == 0
										c = c + 2;
									elseif mod(k, 2) == 0
										c = c + 1;
									end
								end
							end
						</program>
					</stack>
					<stack>
						<program component="stu" language="matlab" line-numbers="no">
							% What is the value of out?

							out = dump(6);
							󠀠
							out = 
							󠀠
							󠀠
							󠀠
							󠀠
							󠀠
						</program>
						<program component="key" language="matlab" line-numbers="no">
							% What is the value of out?

							out = dump(6);
							󠀠
							󠀠
							󠀠
							out = 6
							󠀠
						</program>
					</stack>
				</sidebyside>
			</statement>
		</exercise>
	
		<!-- ========================================================= -->
		<!-- Function-Writing Questions																 -->
		<!-- ========================================================= -->

		<exercise xml:id="quiz-for-loop-function-1">
			<title>Summing with a for-Loop</title>

			<task xml:id="quiz-for-loop-function-1a">
				<statement>
					<p>
						Write a function named <pf>sumFromOne</pf> that takes a positive integer <pf>n</pf> and returns the sum:
						<me>1 + 2 + \cdots + n</me> 
					</p>

					<sidebyside>
						<stack>
							<tabular valign="top" halign="right" top="minor">
								<col width="12%"/>
								<col width="12%" halign="left"/>
								<col width="22%" halign="left"/>
								<col width="54%" halign="left"/>
								<row>
									<cell><p>Inputs:</p></cell>
									<cell><p><pf>n</pf></p></cell>
									<cell><p>(1x1) double</p></cell>
									<cell><p>number to sum up to</p></cell>
								</row>
								<row bottom="minor">
									<cell><p>Outputs:</p></cell>
									<cell><p><pf>total</pf></p></cell>
									<cell><p>(1x1) double</p></cell>
									<cell><p>the sum above</p></cell>
								</row>
							</tabular>
						</stack>
					</sidebyside>

					<program component="stu" language="matlab">
						% Write your sumFromOne function here. You must use a for-loop.
							󠀠
							󠀠
							󠀠
							󠀠
							󠀠
							󠀠
							󠀠
							󠀠
							󠀠
							󠀠
							󠀠
							󠀠
					</program>
					<program component="key" language="matlab">
						% Write your sumFromOne function here. You must use a for-loop.
						function total = sumFromOne(n)
							total = 0;
							for k = 1:n
								total = total + k;
							end
						end
							󠀠
							󠀠
							󠀠
							󠀠
							󠀠
							󠀠
					</program>
				</statement>
			</task>

			<task xml:id="quiz-for-loop-function-1b">
				<statement>
					<p>
						Write a function named <pf>sumBetween</pf> that takes two nonnegative integers <pf>a</pf>, <pf>b</pf> and returns the sum:
						<me>a + (a+1) + (a+2) + \cdots + b</me>
						You may assume that <pf>a</pf> is less than or equal to <pf>b</pf>. If <pf>a</pf> and <pf>b</pf> are equal, the sum should be <pf>0</pf>. 
					</p>

					<sidebyside>
						<stack>
							<tabular valign="top" halign="right" top="minor">
								<col width="12%"/>
								<col width="12%" halign="left"/>
								<col width="22%" halign="left"/>
								<col width="54%" halign="left"/>
								<row>
									<cell><p>Inputs:</p></cell>
									<cell><p><pf>a</pf></p></cell>
									<cell><p>(1x1) double</p></cell>
									<cell><p>start of sum</p></cell>
								</row>
								<row>
									<cell><p></p></cell>
									<cell><p><pf>b</pf></p></cell>
									<cell><p>(1x1) double</p></cell>
									<cell><p>end of sum</p></cell>
								</row>
								<row bottom="minor">
									<cell><p>Outputs:</p></cell>
									<cell><p><pf>total</pf></p></cell>
									<cell><p>(1x1) double</p></cell>
									<cell><p>the sum above</p></cell>
								</row>
							</tabular>
						</stack>
					</sidebyside>

					<program component="stu" language="matlab">
						% Write your sumBetween function here. You must use a for-loop.
							󠀠
							󠀠
							󠀠
							󠀠
							󠀠
							󠀠
							󠀠
							󠀠
							󠀠
							󠀠
							󠀠
							󠀠
					</program>
					<program component="key" language="matlab">
						% Write your sumBetween function here. You must use a for-loop.
						function total = sumBetween(a,b)
							total = 0;
							for k = a:(b-1)
								total = total + k;
							end
						end
							󠀠
							󠀠
							󠀠
							󠀠
					</program>
				</statement>
			</task>

		</exercise>

		<exercise xml:id="quiz-for-loop-function-2">
			<title>Counting Die Rolls</title>

			<task xml:id="quiz-for-loop-function-2a">
				<statement>
					<p>
						Write a function named <pf>highDieCount</pf> that uses a for loop to count the number of times a 5 or 6 is rolled when rolling a six-sided die <pf>n</pf> times. 
						Inside the loop, simulate a die roll using <pf>randi([1,6])</pf>, which returns a random integer between <pf>1</pf> and <pf>6</pf>.
					</p>

					<sidebyside>
						<stack>
							<tabular valign="top" halign="right" top="minor">
								<col width="12%"/>
								<col width="12%" halign="left"/>
								<col width="22%" halign="left"/>
								<col width="54%" halign="left"/>
								<row>
									<cell><p>Inputs:</p></cell>
									<cell><p><pf>n</pf></p></cell>
									<cell><p>(1x1) double</p></cell>
									<cell><p>number of die rolls</p></cell>
								</row>
								<row bottom="minor">
									<cell><p>Outputs:</p></cell>
									<cell><p><pf>count</pf></p></cell>
									<cell><p>(1x1) double</p></cell>
									<cell><p>the number of times <pf>5</pf> or <pf>6</pf> is rolled</p></cell>
								</row>
							</tabular>
						</stack>
					</sidebyside>

					<program component="stu" language="matlab">
						% Write your highDieCount function here. You must use a for-loop.
							󠀠
							󠀠
							󠀠
							󠀠
							󠀠
							󠀠
							󠀠
							󠀠
							󠀠
							󠀠
							󠀠
							󠀠
					</program>
					<program component="key" language="matlab">
						% Write your highDieCount function here. You must use a for-loop.
						function count = highDieCount(n)
							count = 0;
							for k = 1:n
								roll = randi([1,6]);
								if roll == 5 || roll == 6
									count = count + 1;
								end
							end
						end
							󠀠
							󠀠
							󠀠
							󠀠
					</program>						
				</statement>
			</task>

			<task xml:id="quiz-for-loop-function-2b">
				<statement>
					<p>
						Write a function named <pf>snakeEyesCount</pf> that counts the number of times you roll two <pf>1</pf>'s in a row in <pf>n</pf> rolls.
					</p>

					<sidebyside>
						<stack>
							<tabular valign="top" halign="right" top="minor">
								<col width="12%"/>
								<col width="12%" halign="left"/>
								<col width="22%" halign="left"/>
								<col width="54%" halign="left"/>
								<row>
									<cell><p>Inputs:</p></cell>
									<cell><p><pf>n</pf></p></cell>
									<cell><p>(1x1) double</p></cell>
									<cell><p>number of die rolls</p></cell>
								</row>
								<row bottom="minor">
									<cell><p>Outputs:</p></cell>
									<cell><p><pf>count</pf></p></cell>
									<cell><p>(1x1) double</p></cell>
									<cell><p>the number of times two <pf>1</pf>s are rolled</p></cell>
								</row>
							</tabular>
						</stack>
					</sidebyside>

					<program component="stu" language="matlab">
						% Write your snakeEyesCount function here. You must use a for-loop.
							󠀠
							󠀠
							󠀠
							󠀠
							󠀠
							󠀠
							󠀠
							󠀠
							󠀠
							󠀠
							󠀠
							󠀠
					</program>
					<program component="key" language="matlab">
						% Write your snakeEyesCount function here. You must use a for-loop.
						function count = snakeEyesCount(n)
							count = 0;
							prevRoll = 0;
							for k = 1:n
								roll = randi([1,6]);
								if roll == 1 &amp;&amp; prevRoll == 1
									count = count + 1;
								end
								prevRoll = roll;
							end
						end
							󠀠
					</program>
				</statement>
			</task>

		</exercise>

		<exercise xml:id="quiz-for-loop-special-student">
			<title>Code Recall</title>

			<introduction>
				<p>
					Use the functions below to answer the questions that follow. Assume that the functions are defined in the same file and that <pf>is_valid_triangle</pf> correctly identifies valid triangles.
				</p>

				<program language="matlab">
					function result=my_xor_threeway(a,b,c)
					if a==true
						result=1;
					elseif b==true
						result=1;
					elseif c==true
						result=1;
					else
						result=0;
					end
					end
				</program>
				<program language="matlab">
					function type=classify_triangle(a,b,c)
					if is_valid_triangle(a,b,c)==true
						if a==b &amp;&amp; b==c
							type='Equilateral'
						elseif my_xor_threeway(a==b,b==c,a==c)
							type='Isosceles'
						elseif a~=b &amp;&amp; b~=c
							type='Scalene'
						end
					elseif is_valid_triangle(a,b,c)==false
						type='Invalid'
					end
					end
				</program>
			</introduction>

			<task xml:id="quiz-for-loop-conceptual-1a">
				<statement>
					<p>
						Which statement best explains why <pf>my_xor_threeway</pf> correctly detects isosceles triangles inside <pf>classify_triangle</pf>?
					</p>
				</statement>
				<choices randomize="no">
					<choice>
						<statement><p>Because <pf>my_xor_threeway</pf> correctly implements <pf>xor</pf>.</p></statement>
					</choice>
					<choice>
						<statement><p>Because for valid triangles, at most one of <pf>a==b</pf>, <pf>b==c</pf>, <pf>a==c</pf> can be true.</p></statement>
					</choice>
					<choice>
						<statement>
							<p>Because <pf>my_xor_threeway</pf> specifically checks the isosceles case.</p>
						</statement>
					</choice>
					<choice correct="yes">
						<statement>
							<p>
								Because after ruling out equilateral, the isosceles case reduces to checking whether at least one pair of sides is equal.
							</p>
						</statement>
					</choice>
					<choice>
						<statement><p>Because if the equilateral branch fails, all three <pf>a==b</pf>, <pf>b==c</pf>, <pf>a==c</pf> must be false </p></statement>
					</choice>
				</choices>
			</task>

			<task xml:id="quiz-for-loop-conceptual-1b">
				<statement>
					<p>
						Suppose we modify the order of the conditional checks in <pf>classify_triangle</pf> as follows:
					</p>
					<program language="matlab">
						function [type]=classify_triangle(a,b,c)
							if is_valid_triangle(a,b,c)==true
								if my_xor_threeway(a==b,b==c,a==c)
									type='Isosceles'
								elseif a==b &amp;&amp; b==c
									type='Equilateral'
								elseif a~=b &amp;&amp; b~=c
									type='Scalene'
								end
							elseif is_valid_triangle(a,b,c)==false
								type='Invalid'
							end
						end
					</program>
					<p>
						Which inputs will be misclassified by this code?
					</p>
				</statement>
				<choices randomize="no" multiple-correct="yes">
					<choice correct="yes">
						<statement><p><pf>(5,5,5)</pf></p></statement>
					</choice>
					<choice>
						<statement><p><pf>(5,0,8)</pf></p></statement>
					</choice>
					<choice>
						<statement><p><pf>(5,5,8)</pf></p></statement>
					</choice>
					<choice>
						<statement><p><pf>(-5,2,8)</pf></p></statement>
					</choice>
					<choice>
						<statement><p><pf>(3,4,5)</pf></p></statement>
					</choice>
					<choice>
						<statement><p><pf>(7,10,7)</pf></p></statement>
					</choice>
				</choices>
			</task>

			<task xml:id="quiz-for-loop-conceptual-1c">
				<statement>
					<p>
						The <pf>xor</pf> operator returns true if exactly one of its inputs is true, and false otherwise.
						Provide one specific input triple <pf>(a,b,c)</pf> for which <pf>my_xor_threeway(a,b,c)</pf> and <pf>xor(a,b,c)</pf> return different results.
						Then breifly explain why the results differ.
					</p>
				</statement>
				<response />
			</task>

			<task xml:id="quiz-for-loop-conceptual-1d">
				<statement>
					<p>
						You named your function <pf>my_xor_threeway</pf>. In your own words, what did you intend this function to do when you wrote it? Why did you choose that name?
					</p>
				</statement>
				<response />
			</task>

			<task xml:id="quiz-for-loop-conceptual-1e">
				<statement>
					<p>
						Consider the <pf>is_valid_triangle</pf> function:
					</p>
					<program language="matlab" line-numbers="yes">
						function [is_valid]=is_valid_triangle(a,b,c)
							is_valid=false;
							if (a&gt;0) &amp;&amp; (b&gt;0) &amp;&amp; (c&gt;0)
								if a&lt;=c &amp;&amp; b&lt;=c
									if (a+b)&gt;c
										is_valid = true;
									end
								elseif b&lt;=a &amp;&amp; c&lt;=a 
									if (b+c)&gt;a
										is_valid=true;
									end
								elseif a&lt;=b &amp;&amp; c&lt;=b
									if (a+c)&gt;b
										is_valid=true;
									end
								end
							end
						end
					</program>
					<p>
						Trace through <pf>is_valid_triangle(7, 10, 7)</pf> step by step.
						<ol>
							<li>
								<p>
									<line>Which branch of the outer if/elseif/elseif is entered?</line>
									<line>Give the line number: <fillin mode="string" characters="5" answer="555"/></line>
								</p>
							</li>
							<li>
								<p>
									What is the final value of <pf>is_valid</pf>? <fillin mode="string" characters="5" answer="555"/>
								</p>
							</li>
						</ol>
					</p>
				</statement>
