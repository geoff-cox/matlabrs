					<p>
						Rewrite the repeated code as a <pf>for</pf>-loop. (Use the formula <m>C = (F-32)\cdot 5/9</m>.)
					</p>
					<program language="matlab">
						F = 40;
						C = (F - 32) * 5/9;
						fprintf('%d F is %.1f C\n', F, C)

						F = 50;
						C = (F - 32) * 5/9;
						fprintf('%d F is %.1f C\n', F, C)

						F = 60;
						C = (F - 32) * 5/9;
						fprintf('%d F is %.1f C\n', F, C)

						F = 70;
						C = (F - 32) * 5/9;
						fprintf('%d F is %.1f C\n', F, C)
					</program>
					<program language="matlab" line-numbers="no">
						% Write your for-loop here


					</program>
