		<exercise label="drill-for-loop-code-build-a" language="octave" adaptive="yes" indentation="hide">
			<title>Drill: 16 factorial</title>

			<statement>
				<p>
					Put the blocks in order to create a script that computes and prints <pf>16!</pf>.
				</p>
				<p>
					<em>Use correct indentation to show which lines are inside the loop.</em>
				</p>
			</statement>

			<blocks>
				<block><cline>fact = 1;						</cline></block>
				<block><cline>for k = 1:16				</cline></block>
				<block><cline>	fact = fact * k;	</cline></block>
				<block><cline>end									</cline></block>
				<block><cline>fprintf(fact)				</cline></block>
			</blocks>

			<solution component="solution">
				<program language="matlab">
					fact = 1;
					for k = 1:16
							fact = fact * k;
					end
					fprintf(fact)
				</program>
			</solution>
		</exercise>

		<exercise label="drill-for-loop-code-build-b" language="octave" adaptive="yes" indentation="hide">
			<title>Drill: Print 1 through 8</title>

			<statement>
				<p>
					Put the blocks in order to create a script that prints the integers from 1 through 8, one per line.
				</p>
				<p>
					<em>Use correct indentation to show which lines are inside the loop.</em>
				</p>
			</statement>

			<blocks>
				<block><cline>for k = 1:8						</cline></block>
				<block><cline>	fprintf('%i\n', k)	</cline></block>
				<block><cline>end										</cline></block>
			</blocks>
		</exercise>

		<exercise label="drill-for-loop-code-build-c" language="octave" adaptive="yes" indentation="hide">
			<title>Drill: Sum of multiples of 3</title>

			<statement>
				<p>
					Put the blocks in order to create a script that computes the sum of all multiples of 3 from 3 through 30. 
					Store the result in <pf>total</pf>.
				</p>
				<p>
					<em>Use correct indentation to show which lines are inside the loop.</em>
				</p>
			</statement>

			<blocks>
				<block><cline>total = 0;						</cline></block>
				<block><cline>for k = 3:3:30				</cline></block>
				<block><cline>	total = total + k;	</cline></block>
				<block><cline>end										</cline></block>
			</blocks>
		</exercise>

		<exercise label="drill-for-loop-code-build-d" language="octave" adaptive="yes" indentation="hide">
			<title>Drill: Multiple of 3 or not?</title>
			<statement>
				<p>
					Put the blocks in order to create a script that prints either <q>multiple of 3</q> or <q>not a multiple of 3</q> for each integer <pf>1</pf> through <pf>n</pf>.
				</p>
				<p>
					<em>Use correct indentation to show which lines are inside the loop.</em>
				</p>
			</statement>

			<blocks>
				<block><cline>n = 10;																</cline></block>
				<block><cline>for k = 1:n														</cline></block>
				<block><cline>	if mod(k, 3) == 0										</cline></block>
				<block><cline>		fprintf('multiple of 3\n')				</cline></block>
				<block><cline>	else																</cline></block>
				<block><cline>		fprintf('not a multiple of 3\n')	</cline></block>
				<block><cline>	end																	</cline>
							 <cline>end																		</cline></block>
			</blocks>
		</exercise>

		<exercise label="drill-for-loop-code-build-e" language="octave" adaptive="yes" indentation="hide">
			<title>Drill: Fahrenheit to Celsius Table</title>
			<statement>
				<p>
					Put the blocks in order to create a script that prints a Fahrenheit-to-Celsius table for <pf>F = 0, 10, 20, 30, 40, 50</pf>.
					Use the formula <m>C = (F-32)\cdot 5/9</m>. Print one row per value of <pf>F</pf> using <pf>fprintf</pf>.
				</p>
				<p>
					<em>Use correct indentation to show which lines are inside the loop.</em>
				</p>
			</statement>

			<blocks>
				<block><cline>for F = 0:10:50									</cline></block>
				<block><cline>	C = (F - 32) * 5/9						</cline></block>
				<block><cline>	fprintf('%d F = %g C\n',F,C)	</cline></block>
				<block><cline>end															</cline></block>
			</blocks>
				
		</exercise>

		<exercise label="drill-for-loop-code-build-f" language="octave" numbered="left" indentation="hide">
			<title>Drill: Count Multiples of 6</title>
			<statement>
				<p>
					Put the blocks in order to create a script that takes a positive integer <pf>n</pf> and counts how many integers from 1 through <pf>n</pf> are divisible by 6.
				</p>
				<p>
					<em>Use correct indentation to show which lines are inside the loop.</em>
				</p>
			</statement>

			<blocks>
				<block><cline>n = 147;								</cline>
							 <cline>count = 0;							</cline></block>
				<block><cline>for k = 1:n							</cline></block>
				<block><cline>	if mod(k, 6) == 0			</cline></block>
				<block><cline>		count = count + 1;	</cline></block>
				<block><cline>	end										</cline>
							 <cline>end											</cline></block>
			</blocks>
		</exercise>

		<exercise label="drill-for-loop-code-build-g" language="octave" numbered="left" indentation="hide">
			<title>Drill: Sum of Floors</title>
			<statement>
				<p>
					Put the blocks in order to create a script that takes a positive integer <pf>n</pf> and computes the sum:
					<me>
						\sum_{k=1}^{n} \left\lfloor\frac{k}{2}\right\rfloor 
						= \left\lfloor\frac12\right\rfloor 
						+ \left\lfloor\frac22\right\rfloor 
						+ \left\lfloor\frac32\right\rfloor 
						+ \cdots + \left\lfloor\frac{n}{2}\right\rfloor
					</me>
					where <m>\lfloor x \rfloor</m> is the floor of <m>x</m> (i.e., greatest integer less than or equal to <m>x</m>). Store the result in <pf>total</pf>.
				</p>
				<p>
					<em>Use correct indentation to show which lines are inside the loop.</em>
				</p>
			</statement>

			<blocks>
				<block>	<cline>n = 20												</cline>
							 	<cline>total = 0;										</cline> </block>
				<block>	<cline>for k = 1:n									</cline> </block>
				<block>	<cline>	total = total + floor(k/2);	</cline> </block>
				<block>	<cline>end													</cline> </block>
			</blocks>
		</exercise>

	</exercises>

</section>