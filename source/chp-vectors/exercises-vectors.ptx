<?xml version="1.0" encoding="UTF-8"?>
<exercises xml:id="vectors-coding-exercises">
	<title>💻 Coding Exercises</title>

	<exercise label="vectors-coding-exercise-1">
		<title>Creating and Indexing Vectors</title>

		<task label="vectors-coding-firstAndLast">
			<statement>
				<p>
					Write a function <pf>firstAndLast</pf> that takes a vector <pf>v</pf> and returns its first and last elements as two separate outputs.
				</p>

				<tabular valign="top" top="minor">
					<col width="11%" halign="right" />
					<col width="15%" halign="left" />
					<col width="28%" halign="center" />
					<col width="46%" halign="left" />
					<row>
						<cell>Inputs:</cell>
						<cell><p><pf>v</pf></p></cell>
						<cell><p>(1xn) double</p></cell>
						<cell><p>vector with at least one element</p></cell>
					</row>
					<row>
						<cell>Outputs:</cell>
						<cell><p><pf>first</pf></p></cell>
						<cell><p>(1x1) double</p></cell>
						<cell><p>first element of <pf>v</pf></p></cell>
					</row>
					<row bottom="minor">
						<cell></cell>
						<cell><p><pf>last</pf></p></cell>
						<cell><p>(1x1) double</p></cell>
						<cell><p>last element of <pf>v</pf></p></cell>
					</row>
				</tabular>

				<sidebyside widths="49% 49%">
					<stack>
						<p>Test Cases ⤵︎</p>
						<program language="matlab">
							[a, b] = firstAndLast([3, 7, 2, 9, 5])
							[a, b] = firstAndLast([42])
							[a, b] = firstAndLast(1:10)
						</program>
					</stack>
					<stack>
						<p>Expected ⤵︎</p>
						<program language="matlab">
							a = 3,  b = 5
							a = 42, b = 42
							a = 1,  b = 10
						</program>
					</stack>
				</sidebyside>
			</statement>
			<solution component="exercise-solution">
				<p>Here is one possible solution:</p>
				<program language="matlab">
					function [first, last] = firstAndLast(v)
						first = v(1);
						last = v(end);
					end
				</program>
			</solution>
		</task>

		<task label="vectors-coding-swapEnds">
			<statement>
				<p>
					Write a function <pf>swapEnds</pf> that takes a vector <pf>v</pf> and returns a new vector with the first and last elements swapped. All other elements should remain in place.
				</p>

				<tabular valign="top" top="minor">
					<col width="11%" halign="right" />
					<col width="15%" halign="left" />
					<col width="28%" halign="center" />
					<col width="46%" halign="left" />
					<row>
						<cell>Inputs:</cell>
						<cell><p><pf>v</pf></p></cell>
						<cell><p>(1xn) double</p></cell>
						<cell><p>vector with at least two elements</p></cell>
					</row>
					<row bottom="minor">
						<cell>Outputs:</cell>
						<cell><p><pf>w</pf></p></cell>
						<cell><p>(1xn) double</p></cell>
						<cell><p>vector with the first and last elements swapped</p></cell>
					</row>
				</tabular>

				<sidebyside widths="49% 49%">
					<stack>
						<p>Test Cases ⤵︎</p>
						<program language="matlab">
							w = swapEnds([1, 2, 3, 4, 5])
							w = swapEnds([10, 20])
							w = swapEnds([7, 7, 7, 7])
						</program>
					</stack>
					<stack>
						<p>Expected ⤵︎</p>
						<program language="matlab">
							w = [5, 2, 3, 4, 1]
							w = [20, 10]
							w = [7, 7, 7, 7]
						</program>
					</stack>
				</sidebyside>
			</statement>
			<solution component="exercise-solution">
				<p>Here is one possible solution:</p>
				<program language="matlab">
					function w = swapEnds(v)
						w = v;
						w(1) = v(end);
						w(end) = v(1);
					end
				</program>
			</solution>
		</task>

		<task label="vectors-coding-dropEnds">
			<statement>
				<p>
					Write a function <pf>dropEnds</pf> that takes a vector <pf>v</pf> and returns a new vector with the first and last elements removed.
				</p>

				<tabular valign="top" top="minor">
					<col width="11%" halign="right" />
					<col width="15%" halign="left" />
					<col width="28%" halign="center" />
					<col width="46%" halign="left" />
					<row>
						<cell>Inputs:</cell>
						<cell><p><pf>v</pf></p></cell>
						<cell><p>(1xn) double</p></cell>
						<cell><p>vector with at least two elements</p></cell>
					</row>
					<row bottom="minor">
						<cell>Outputs:</cell>
						<cell><p><pf>w</pf></p></cell>
						<cell><p>(1x(n-2)) double</p></cell>
						<cell><p>vector with the first and last elements removed</p></cell>
					</row>
				</tabular>

				<sidebyside widths="49% 49%">
					<stack>
						<p>Test Cases ⤵︎</p>
						<program language="matlab">
							w = dropEnds([10, 20, 30, 40, 50])
							w = dropEnds([1, 2, 3])
							w = dropEnds([4, 9])
						</program>
					</stack>
					<stack>
						<p>Expected ⤵︎</p>
						<program language="matlab">
							w = [20, 30, 40]
							w = [2]
							w = []
						</program>
					</stack>
				</sidebyside>
			</statement>
			<solution component="exercise-solution">
				<p>Here is one possible solution using slicing:</p>
				<program language="matlab">
					function w = dropEnds(v)
						w = v(2:end-1);
					end
				</program>
			</solution>
		</task>

		<task label="vectors-coding-everyOther">
			<statement>
				<p>
					Write a function <pf>everyOther</pf> that takes a vector <pf>v</pf> and returns a new vector containing the elements at the odd positions: positions 1, 3, 5, and so on.
				</p>

				<tabular valign="top" top="minor">
					<col width="11%" halign="right" />
					<col width="15%" halign="left" />
					<col width="28%" halign="center" />
					<col width="46%" halign="left" />
					<row>
						<cell>Inputs:</cell>
						<cell><p><pf>v</pf></p></cell>
						<cell><p>(1xn) double</p></cell>
						<cell><p>vector of any length</p></cell>
					</row>
					<row bottom="minor">
						<cell>Outputs:</cell>
						<cell><p><pf>w</pf></p></cell>
						<cell><p>(1xm) double</p></cell>
						<cell><p>elements of <pf>v</pf> at positions 1, 3, 5, ...</p></cell>
					</row>
				</tabular>

				<sidebyside widths="49% 49%">
					<stack>
						<p>Test Cases ⤵︎</p>
						<program language="matlab">
							w = everyOther([10, 20, 30, 40, 50, 60])
							w = everyOther([1, 2, 3, 4, 5])
							w = everyOther([99])
						</program>
					</stack>
					<stack>
						<p>Expected ⤵︎</p>
						<program language="matlab">
							w = [10, 30, 50]
							w = [1, 3, 5]
							w = [99]
						</program>
					</stack>
				</sidebyside>
			</statement>
			<solution component="exercise-solution">
				<p>Here is one possible solution using colon notation with a step:</p>
				<program language="matlab">
					function w = everyOther(v)
						w = v(1:2:end);
					end
				</program>
			</solution>
		</task>

		<task label="vectors-coding-reverseVector">
			<statement>
				<p>
					Write a function <pf>reverseVector</pf> that takes a vector <pf>v</pf> and returns a new vector with the elements in reverse order. Use slicing — do not use a loop.
				</p>

				<tabular valign="top" top="minor">
					<col width="11%" halign="right" />
					<col width="15%" halign="left" />
					<col width="28%" halign="center" />
					<col width="46%" halign="left" />
					<row>
						<cell>Inputs:</cell>
						<cell><p><pf>v</pf></p></cell>
						<cell><p>(1xn) double</p></cell>
						<cell><p>vector of any length</p></cell>
					</row>
					<row bottom="minor">
						<cell>Outputs:</cell>
						<cell><p><pf>w</pf></p></cell>
						<cell><p>(1xn) double</p></cell>
						<cell><p>elements of <pf>v</pf> in reverse order</p></cell>
					</row>
				</tabular>

				<sidebyside widths="49% 49%">
					<stack>
						<p>Test Cases ⤵︎</p>
						<program language="matlab">
							w = reverseVector([1, 2, 3, 4, 5])
							w = reverseVector([10, 20])
							w = reverseVector(1:6)
						</program>
					</stack>
					<stack>
						<p>Expected ⤵︎</p>
						<program language="matlab">
							w = [5, 4, 3, 2, 1]
							w = [20, 10]
							w = [6, 5, 4, 3, 2, 1]
						</program>
					</stack>
				</sidebyside>
			</statement>
			<solution component="exercise-solution">
				<p>
					Here is one possible solution. The slice <pf>end:-1:1</pf> walks the positions backward, from <pf>end</pf> down to <pf>1</pf>:
				</p>
				<program language="matlab">
					function w = reverseVector(v)
						w = v(end:-1:1);
					end
				</program>
			</solution>
		</task>

		<task label="vectors-coding-replaceElement">
			<statement>
				<p>
					Write a function <pf>replaceElement</pf> that takes a vector <pf>v</pf>, a position <pf>i</pf>, and a new value <pf>newval</pf>, and returns a new vector with the element at position <pf>i</pf> replaced by <pf>newval</pf>. All other elements should remain unchanged.
				</p>

				<tabular valign="top" top="minor">
					<col width="11%" halign="right" />
					<col width="15%" halign="left" />
					<col width="28%" halign="center" />
					<col width="46%" halign="left" />
					<row>
						<cell>Inputs:</cell>
						<cell><p><pf>v</pf></p></cell>
						<cell><p>(1xn) double</p></cell>
						<cell><p>vector to modify</p></cell>
					</row>
					<row>
						<cell></cell>
						<cell><p><pf>i</pf></p></cell>
						<cell><p>(1x1) double</p></cell>
						<cell><p>position to replace (between 1 and n)</p></cell>
					</row>
					<row>
						<cell></cell>
						<cell><p><pf>newval</pf></p></cell>
						<cell><p>(1x1) double</p></cell>
						<cell><p>value to store at position <pf>i</pf></p></cell>
					</row>
					<row bottom="minor">
						<cell>Outputs:</cell>
						<cell><p><pf>w</pf></p></cell>
						<cell><p>(1xn) double</p></cell>
						<cell><p>vector with position <pf>i</pf> replaced</p></cell>
					</row>
				</tabular>

				<sidebyside widths="49% 49%">
					<stack>
						<p>Test Cases ⤵︎</p>
						<program language="matlab">
							w = replaceElement([10, 20, 30, 40], 2, 99)
							w = replaceElement([1, 2, 3], 1, 0)
							w = replaceElement([5, 6, 7, 8], 4, -1)
						</program>
					</stack>
					<stack>
						<p>Expected ⤵︎</p>
						<program language="matlab">
							w = [10, 99, 30, 40]
							w = [0, 2, 3]
							w = [5, 6, 7, -1]
						</program>
					</stack>
				</sidebyside>
			</statement>
			<solution component="exercise-solution">
				<p>Here is one possible solution:</p>
				<program language="matlab">
					function w = replaceElement(v, i, newval)
						w = v;
						w(i) = newval;
					end
				</program>
			</solution>
		</task>

		<task label="vectors-coding-appendValue">
			<statement>
				<p>
					Write a function <pf>appendValue</pf> that takes a vector <pf>v</pf> and a value <pf>x</pf>, and returns a new vector with <pf>x</pf> added to the end.
				</p>

				<tabular valign="top" top="minor">
					<col width="11%" halign="right" />
					<col width="15%" halign="left" />
					<col width="28%" halign="center" />
					<col width="46%" halign="left" />
					<row>
						<cell>Inputs:</cell>
						<cell><p><pf>v</pf></p></cell>
						<cell><p>(1xn) double</p></cell>
						<cell><p>vector to extend</p></cell>
					</row>
					<row>
						<cell></cell>
						<cell><p><pf>x</pf></p></cell>
						<cell><p>(1x1) double</p></cell>
						<cell><p>value to append</p></cell>
					</row>
					<row bottom="minor">
						<cell>Outputs:</cell>
						<cell><p><pf>w</pf></p></cell>
						<cell><p>(1x(n+1)) double</p></cell>
						<cell><p>vector with <pf>x</pf> tacked on at the end</p></cell>
					</row>
				</tabular>

				<sidebyside widths="49% 49%">
					<stack>
						<p>Test Cases ⤵︎</p>
						<program language="matlab">
							w = appendValue([1, 2, 3], 99)
							w = appendValue([], 5)
							w = appendValue([10, 20], 30)
						</program>
					</stack>
					<stack>
						<p>Expected ⤵︎</p>
						<program language="matlab">
							w = [1, 2, 3, 99]
							w = [5]
							w = [10, 20, 30]
						</program>
					</stack>
				</sidebyside>
			</statement>
			<solution component="exercise-solution">
				<p>Here is one possible solution:</p>
				<program language="matlab">
					function w = appendValue(v, x)
						w = v;
						w(end + 1) = x;
					end
				</program>
			</solution>
		</task>

		<task label="vectors-coding-removeElement">
			<statement>
				<p>
					Write a function <pf>removeElement</pf> that takes a vector <pf>v</pf> and a position <pf>i</pf>, and returns a new vector with the element at position <pf>i</pf> removed. All elements after position <pf>i</pf> should shift down by one.
				</p>

				<tabular valign="top" top="minor">
					<col width="11%" halign="right" />
					<col width="15%" halign="left" />
					<col width="28%" halign="center" />
					<col width="46%" halign="left" />
					<row>
						<cell>Inputs:</cell>
						<cell><p><pf>v</pf></p></cell>
						<cell><p>(1xn) double</p></cell>
						<cell><p>vector to modify</p></cell>
					</row>
					<row>
						<cell></cell>
						<cell><p><pf>i</pf></p></cell>
						<cell><p>(1x1) double</p></cell>
						<cell><p>position to remove (between 1 and n)</p></cell>
					</row>
					<row bottom="minor">
						<cell>Outputs:</cell>
						<cell><p><pf>w</pf></p></cell>
						<cell><p>(1x(n-1)) double</p></cell>
						<cell><p>vector with position <pf>i</pf> removed</p></cell>
					</row>
				</tabular>

				<sidebyside widths="49% 49%">
					<stack>
						<p>Test Cases ⤵︎</p>
						<program language="matlab">
							w = removeElement([10, 20, 30, 40, 50], 3)
							w = removeElement([1, 2, 3], 1)
							w = removeElement([7, 8, 9], 3)
						</program>
					</stack>
					<stack>
						<p>Expected ⤵︎</p>
						<program language="matlab">
							w = [10, 20, 40, 50]
							w = [2, 3]
							w = [7, 8]
						</program>
					</stack>
				</sidebyside>
			</statement>
			<solution component="exercise-solution">
				<p>Here is one possible solution:</p>
				<program language="matlab">
					function w = removeElement(v, i)
						w = v;
						w(i) = [];
					end
				</program>
			</solution>
		</task>

	</exercise>

	<exercise label="vectors-coding-exercise-2">
		<title>Vector Arithmetic</title>

		<task label="vectors-coding-shiftAndScale">
			<statement>
				<p>
					Write a function <pf>shiftAndScale</pf> that takes a vector <pf>v</pf>, a shift <pf>s</pf>, and a scale factor <pf>k</pf>, and returns a new vector where every element has had <pf>s</pf> added to it and then been multiplied by <pf>k</pf>. Do not use a loop.
				</p>

				<tabular valign="top" top="minor">
					<col width="11%" halign="right" />
					<col width="15%" halign="left" />
					<col width="28%" halign="center" />
					<col width="46%" halign="left" />
					<row>
						<cell>Inputs:</cell>
						<cell><p><pf>v</pf></p></cell>
						<cell><p>(1xn) double</p></cell>
						<cell><p>vector to transform</p></cell>
					</row>
					<row>
						<cell></cell>
						<cell><p><pf>s</pf></p></cell>
						<cell><p>(1x1) double</p></cell>
						<cell><p>shift to add to every element</p></cell>
					</row>
					<row>
						<cell></cell>
						<cell><p><pf>k</pf></p></cell>
						<cell><p>(1x1) double</p></cell>
						<cell><p>factor to multiply every element by</p></cell>
					</row>
					<row bottom="minor">
						<cell>Outputs:</cell>
						<cell><p><pf>w</pf></p></cell>
						<cell><p>(1xn) double</p></cell>
						<cell><p>transformed vector</p></cell>
					</row>
				</tabular>

				<sidebyside widths="49% 49%">
					<stack>
						<p>Test Cases ⤵︎</p>
						<program language="matlab">
							w = shiftAndScale([1, 2, 3, 4], 0, 10)
							w = shiftAndScale([1, 2, 3, 4], 1, 2)
							w = shiftAndScale([5, 10, 15], -5, 0.5)
						</program>
					</stack>
					<stack>
						<p>Expected ⤵︎</p>
						<program language="matlab">
							w = [10, 20, 30, 40]
							w = [4, 6, 8, 10]
							w = [0, 2.5, 5]
						</program>
					</stack>
				</sidebyside>
			</statement>
			<solution component="exercise-solution">
				<p>Here is one possible solution:</p>
				<program language="matlab">
					function w = shiftAndScale(v, s, k)
						w = (v + s) * k;
					end
				</program>
			</solution>
		</task>

		<task label="vectors-coding-celsiusToFahrenheit">
			<statement>
				<p>
					Write a function <pf>celsiusToFahrenheit</pf> that takes a vector of temperatures in degrees Celsius and returns a vector of the same temperatures in degrees Fahrenheit. The conversion formula is:
					<me>F = \frac{9}{5} C + 32</me>
					Do not use a loop.
				</p>

				<tabular valign="top" top="minor">
					<col width="11%" halign="right" />
					<col width="15%" halign="left" />
					<col width="28%" halign="center" />
					<col width="46%" halign="left" />
					<row>
						<cell>Inputs:</cell>
						<cell><p><pf>C</pf></p></cell>
						<cell><p>(1xn) double</p></cell>
						<cell><p>temperatures in degrees Celsius</p></cell>
					</row>
					<row bottom="minor">
						<cell>Outputs:</cell>
						<cell><p><pf>F</pf></p></cell>
						<cell><p>(1xn) double</p></cell>
						<cell><p>temperatures in degrees Fahrenheit</p></cell>
					</row>
				</tabular>

				<sidebyside widths="49% 49%">
					<stack>
						<p>Test Cases ⤵︎</p>
						<program language="matlab">
							F = celsiusToFahrenheit([0, 100])
							F = celsiusToFahrenheit([-40, 0, 20, 37])
							F = celsiusToFahrenheit(25)
						</program>
					</stack>
					<stack>
						<p>Expected ⤵︎</p>
						<program language="matlab">
							F = [32, 212]
							F = [-40, 32, 68, 98.6]
							F = 77
						</program>
					</stack>
				</sidebyside>
			</statement>
			<solution component="exercise-solution">
				<p>Here is one possible solution:</p>
				<program language="matlab">
					function F = celsiusToFahrenheit(C)
						F = (9/5) * C + 32;
					end
				</program>
			</solution>
		</task>

		<task label="vectors-coding-circleAreas">
			<statement>
				<p>
					Write a function <pf>circleAreas</pf> that takes a vector of circle radii and returns a vector of the corresponding areas. The area of a circle of radius <m>r</m> is <m>\pi r^2</m>. Do not use a loop.
				</p>

				<tabular valign="top" top="minor">
					<col width="11%" halign="right" />
					<col width="15%" halign="left" />
					<col width="28%" halign="center" />
					<col width="46%" halign="left" />
					<row>
						<cell>Inputs:</cell>
						<cell><p><pf>r</pf></p></cell>
						<cell><p>(1xn) double</p></cell>
						<cell><p>radii of circles</p></cell>
					</row>
					<row bottom="minor">
						<cell>Outputs:</cell>
						<cell><p><pf>A</pf></p></cell>
						<cell><p>(1xn) double</p></cell>
						<cell><p>areas of the corresponding circles</p></cell>
					</row>
				</tabular>

				<sidebyside widths="49% 49%">
					<stack>
						<p>Test Cases ⤵︎</p>
						<program language="matlab">
							A = circleAreas([1, 2, 3])
							A = circleAreas([0.5, 1.0, 1.5, 2.0])
							A = circleAreas(10)
						</program>
					</stack>
					<stack>
						<p>Expected ⤵︎</p>
						<program language="matlab">
							A ≈ [3.1416, 12.566, 28.274]
							A ≈ [0.7854, 3.1416, 7.0686, 12.566]
							A ≈ 314.16
						</program>
					</stack>
				</sidebyside>
			</statement>
			<solution component="exercise-solution">
				<p>
					Here is one possible solution. Note the dot in <pf>.^</pf> — this is what tells MATLAB to square each element individually rather than perform a matrix operation.
				</p>
				<program language="matlab">
					function A = circleAreas(r)
						A = pi * r.^2;
					end
				</program>
			</solution>
		</task>

		<task label="vectors-coding-magnitudes">
			<statement>
				<p>
					A two-dimensional vector with components <m>(x, y)</m> has magnitude <m>\sqrt{x^2 + y^2}</m>. Write a function <pf>magnitudes</pf> that takes two equal-length vectors <pf>x</pf> and <pf>y</pf> — the <m>x</m>- and <m>y</m>-components of a collection of vectors — and returns a vector of their magnitudes. Do not use a loop.
				</p>

				<tabular valign="top" top="minor">
					<col width="11%" halign="right" />
					<col width="15%" halign="left" />
					<col width="28%" halign="center" />
					<col width="46%" halign="left" />
					<row>
						<cell>Inputs:</cell>
						<cell><p><pf>x</pf></p></cell>
						<cell><p>(1xn) double</p></cell>
						<cell><p>x-components</p></cell>
					</row>
					<row>
						<cell></cell>
						<cell><p><pf>y</pf></p></cell>
						<cell><p>(1xn) double</p></cell>
						<cell><p>y-components</p></cell>
					</row>
					<row bottom="minor">
						<cell>Outputs:</cell>
						<cell><p><pf>m</pf></p></cell>
						<cell><p>(1xn) double</p></cell>
						<cell><p>magnitudes of the vectors</p></cell>
					</row>
				</tabular>

				<sidebyside widths="49% 49%">
					<stack>
						<p>Test Cases ⤵︎</p>
						<program language="matlab">
							m = magnitudes([3, 0, 5], [4, 1, 12])
							m = magnitudes([1, 1], [1, 1])
							m = magnitudes(0, 0)
						</program>
					</stack>
					<stack>
						<p>Expected ⤵︎</p>
						<program language="matlab">
							m = [5, 1, 13]
							m ≈ [1.4142, 1.4142]
							m = 0
						</program>
					</stack>
				</sidebyside>
			</statement>
			<solution component="exercise-solution">
				<p>Here is one possible solution:</p>
				<program language="matlab">
					function m = magnitudes(x, y)
						m = sqrt(x.^2 + y.^2);
					end
				</program>
			</solution>
		</task>

		<task label="vectors-coding-distances">
			<statement>
				<p>
					Write a function <pf>distances</pf> that takes four equal-length vectors <pf>x1</pf>, <pf>y1</pf>, <pf>x2</pf>, and <pf>y2</pf>, where each set of four entries describes a pair of points, and returns a vector of the straight-line distances between them. The distance between <m>(x_1, y_1)</m> and <m>(x_2, y_2)</m> is:
					<me>d = \sqrt{(x_2 - x_1)^2 + (y_2 - y_1)^2}</me>
					Do not use a loop.
				</p>

				<tabular valign="top" top="minor">
					<col width="11%" halign="right" />
					<col width="15%" halign="left" />
					<col width="28%" halign="center" />
					<col width="46%" halign="left" />
					<row>
						<cell>Inputs:</cell>
						<cell><p><pf>x1</pf></p></cell>
						<cell><p>(1xn) double</p></cell>
						<cell><p>x-coordinates of starting points</p></cell>
					</row>
					<row>
						<cell></cell>
						<cell><p><pf>y1</pf></p></cell>
						<cell><p>(1xn) double</p></cell>
						<cell><p>y-coordinates of starting points</p></cell>
					</row>
					<row>
						<cell></cell>
						<cell><p><pf>x2</pf></p></cell>
						<cell><p>(1xn) double</p></cell>
						<cell><p>x-coordinates of ending points</p></cell>
					</row>
					<row>
						<cell></cell>
						<cell><p><pf>y2</pf></p></cell>
						<cell><p>(1xn) double</p></cell>
						<cell><p>y-coordinates of ending points</p></cell>
					</row>
					<row bottom="minor">
						<cell>Outputs:</cell>
						<cell><p><pf>d</pf></p></cell>
						<cell><p>(1xn) double</p></cell>
						<cell><p>distances between corresponding point pairs</p></cell>
					</row>
				</tabular>

				<sidebyside widths="49% 49%">
					<stack>
						<p>Test Cases ⤵︎</p>
						<program language="matlab">
							d = distances([0, 0], [0, 0], [3, 5], [4, 12])
							d = distances(0, 0, 1, 1)
							d = distances([1, 2], [1, 2], [1, 2], [1, 2])
						</program>
					</stack>
					<stack>
						<p>Expected ⤵︎</p>
						<program language="matlab">
							d = [5, 13]
							d ≈ 1.4142
							d = [0, 0]
						</program>
					</stack>
				</sidebyside>
			</statement>
			<solution component="exercise-solution">
				<p>Here is one possible solution:</p>
				<program language="matlab">
					function d = distances(x1, y1, x2, y2)
						d = sqrt((x2 - x1).^2 + (y2 - y1).^2);
					end
				</program>
			</solution>
		</task>

		<task label="vectors-coding-evaluateQuadratic">
			<statement>
				<p>
					Write a function <pf>evaluateQuadratic</pf> that takes three scalar coefficients <pf>a</pf>, <pf>b</pf>, and <pf>c</pf>, and a vector <pf>x</pf>, and returns a vector containing the value of the quadratic
					<me>y = ax^2 + bx + c</me>
					evaluated at every element of <pf>x</pf>. Do not use a loop.
				</p>

				<tabular valign="top" top="minor">
					<col width="11%" halign="right" />
					<col width="15%" halign="left" />
					<col width="28%" halign="center" />
					<col width="46%" halign="left" />
					<row>
						<cell>Inputs:</cell>
						<cell><p><pf>a</pf></p></cell>
						<cell><p>(1x1) double</p></cell>
						<cell><p>coefficient of <m>x^2</m></p></cell>
					</row>
					<row>
						<cell></cell>
						<cell><p><pf>b</pf></p></cell>
						<cell><p>(1x1) double</p></cell>
						<cell><p>coefficient of <m>x</m></p></cell>
					</row>
					<row>
						<cell></cell>
						<cell><p><pf>c</pf></p></cell>
						<cell><p>(1x1) double</p></cell>
						<cell><p>constant term</p></cell>
					</row>
					<row>
						<cell></cell>
						<cell><p><pf>x</pf></p></cell>
						<cell><p>(1xn) double</p></cell>
						<cell><p>values at which to evaluate the quadratic</p></cell>
					</row>
					<row bottom="minor">
						<cell>Outputs:</cell>
						<cell><p><pf>y</pf></p></cell>
						<cell><p>(1xn) double</p></cell>
						<cell><p>quadratic values at each <pf>x</pf></p></cell>
					</row>
				</tabular>

				<sidebyside widths="49% 49%">
					<stack>
						<p>Test Cases ⤵︎</p>
						<program language="matlab">
							y = evaluateQuadratic(1, 0, 0, [-2, -1, 0, 1, 2])
							y = evaluateQuadratic(1, -3, 2, [0, 1, 2, 3])
							y = evaluateQuadratic(2, 1, -1, [0, 1])
						</program>
					</stack>
					<stack>
						<p>Expected ⤵︎</p>
						<program language="matlab">
							y = [4, 1, 0, 1, 4]
							y = [2, 0, 0, 2]
							y = [-1, 2]
						</program>
					</stack>
				</sidebyside>
			</statement>
			<solution component="exercise-solution">
				<p>Here is one possible solution:</p>
				<program language="matlab">
					function y = evaluateQuadratic(a, b, c, x)
						y = a * x.^2 + b * x + c;
					end
				</program>
			</solution>
		</task>

		<task label="vectors-coding-compoundBalance">
			<statement>
				<p>
					An investment of principal <m>P</m> dollars earning annual interest rate <m>r</m> (compounded yearly) grows to
					<me>B = P(1 + r)^t</me>
					after <m>t</m> years. Write a function <pf>compoundBalance</pf> that takes a scalar principal <pf>P</pf>, a scalar interest rate <pf>r</pf>, and a vector of times <pf>t</pf>, and returns a vector of the corresponding account balances. Do not use a loop.
				</p>

				<tabular valign="top" top="minor">
					<col width="11%" halign="right" />
					<col width="15%" halign="left" />
					<col width="28%" halign="center" />
					<col width="46%" halign="left" />
					<row>
						<cell>Inputs:</cell>
						<cell><p><pf>P</pf></p></cell>
						<cell><p>(1x1) double</p></cell>
						<cell><p>initial principal in dollars</p></cell>
					</row>
					<row>
						<cell></cell>
						<cell><p><pf>r</pf></p></cell>
						<cell><p>(1x1) double</p></cell>
						<cell><p>annual interest rate (e.g., 0.05 for 5%)</p></cell>
					</row>
					<row>
						<cell></cell>
						<cell><p><pf>t</pf></p></cell>
						<cell><p>(1xn) double</p></cell>
						<cell><p>number of years</p></cell>
					</row>
					<row bottom="minor">
						<cell>Outputs:</cell>
						<cell><p><pf>B</pf></p></cell>
						<cell><p>(1xn) double</p></cell>
						<cell><p>account balances at each year in <pf>t</pf></p></cell>
					</row>
				</tabular>

				<sidebyside widths="49% 49%">
					<stack>
						<p>Test Cases ⤵︎</p>
						<program language="matlab">
							B = compoundBalance(1000, 0.05, [0, 1, 2, 5])
							B = compoundBalance(500, 0.10, [10, 20])
							B = compoundBalance(1000, 0, [0, 1, 2, 3])
						</program>
					</stack>
					<stack>
						<p>Expected ⤵︎</p>
						<program language="matlab">
							B ≈ [1000, 1050, 1102.5, 1276.28]
							B ≈ [1296.87, 3363.75]
							B = [1000, 1000, 1000, 1000]
						</program>
					</stack>
				</sidebyside>
			</statement>
			<solution component="exercise-solution">
				<p>Here is one possible solution:</p>
				<program language="matlab">
					function B = compoundBalance(P, r, t)
						B = P * (1 + r).^t;
					end
				</program>
			</solution>
		</task>

	</exercise>

	<exercise label="vectors-coding-exercise-3">
		<title>Vectors and Loops</title>

		<task label="vectors-coding-mySum">
			<statement>
				<p>
					Write a function <pf>mySum</pf> that takes a vector <pf>v</pf> and returns the sum of all its elements. Use a loop — do not use any built-in aggregate functions.
				</p>

				<tabular valign="top" top="minor">
					<col width="11%" halign="right" />
					<col width="15%" halign="left" />
					<col width="28%" halign="center" />
					<col width="46%" halign="left" />
					<row>
						<cell>Inputs:</cell>
						<cell><p><pf>v</pf></p></cell>
						<cell><p>(1xn) double</p></cell>
						<cell><p>vector with at least one element</p></cell>
					</row>
					<row bottom="minor">
						<cell>Outputs:</cell>
						<cell><p><pf>s</pf></p></cell>
						<cell><p>(1x1) double</p></cell>
						<cell><p>sum of all elements of <pf>v</pf></p></cell>
					</row>
				</tabular>

				<sidebyside widths="49% 49%">
					<stack>
						<p>Test Cases ⤵︎</p>
						<program language="matlab">
							s = mySum([1, 2, 3, 4, 5])
							s = mySum([10])
							s = mySum([-1, 1, -2, 2])
						</program>
					</stack>
					<stack>
						<p>Expected ⤵︎</p>
						<program language="matlab">
							s = 15
							s = 10
							s = 0
						</program>
					</stack>
				</sidebyside>
			</statement>
			<solution component="exercise-solution">
				<p>Here is one possible solution using a value-based loop:</p>
				<program language="matlab">
					function s = mySum(v)
						s = 0;
						for x = v
							s = s + x;
						end
					end
				</program>
			</solution>
		</task>

		<task label="vectors-coding-myMax">
			<statement>
				<p>
					Write a function <pf>myMax</pf> that takes a vector <pf>v</pf> and returns its largest element. Use a loop — do not use any built-in aggregate functions.
				</p>

				<tabular valign="top" top="minor">
					<col width="11%" halign="right" />
					<col width="15%" halign="left" />
					<col width="28%" halign="center" />
					<col width="46%" halign="left" />
					<row>
						<cell>Inputs:</cell>
						<cell><p><pf>v</pf></p></cell>
						<cell><p>(1xn) double</p></cell>
						<cell><p>vector with at least one element</p></cell>
					</row>
					<row bottom="minor">
						<cell>Outputs:</cell>
						<cell><p><pf>m</pf></p></cell>
						<cell><p>(1x1) double</p></cell>
						<cell><p>largest element of <pf>v</pf></p></cell>
					</row>
				</tabular>

				<sidebyside widths="49% 49%">
					<stack>
						<p>Test Cases ⤵︎</p>
						<program language="matlab">
							m = myMax([3, 7, 2, 9, 5])
							m = myMax([10])
							m = myMax([-5, -3, -1, -8])
						</program>
					</stack>
					<stack>
						<p>Expected ⤵︎</p>
						<program language="matlab">
							m = 9
							m = 10
							m = -1
						</program>
					</stack>
				</sidebyside>
			</statement>
			<solution component="exercise-solution">
				<p>
					Here is one possible solution. Initializing <pf>m</pf> to the first element and starting the loop at position 2 avoids comparing the first element with itself.
				</p>
				<program language="matlab">
					function m = myMax(v)
						m = v(1);
						for i = 2:length(v)
							if v(i) &gt; m
								m = v(i);
							end
						end
					end
				</program>
			</solution>
		</task>

		<task label="vectors-coding-myMin">
			<statement>
				<p>
					Write a function <pf>myMin</pf> that takes a vector <pf>v</pf> and returns its smallest element. Use a loop — do not use any built-in aggregate functions.
				</p>

				<tabular valign="top" top="minor">
					<col width="11%" halign="right" />
					<col width="15%" halign="left" />
					<col width="28%" halign="center" />
					<col width="46%" halign="left" />
					<row>
						<cell>Inputs:</cell>
						<cell><p><pf>v</pf></p></cell>
						<cell><p>(1xn) double</p></cell>
						<cell><p>vector with at least one element</p></cell>
					</row>
					<row bottom="minor">
						<cell>Outputs:</cell>
						<cell><p><pf>m</pf></p></cell>
						<cell><p>(1x1) double</p></cell>
						<cell><p>smallest element of <pf>v</pf></p></cell>
					</row>
				</tabular>

				<sidebyside widths="49% 49%">
					<stack>
						<p>Test Cases ⤵︎</p>
						<program language="matlab">
							m = myMin([3, 7, 2, 9, 5])
							m = myMin([10])
							m = myMin([-5, -3, -1, -8])
						</program>
					</stack>
					<stack>
						<p>Expected ⤵︎</p>
						<program language="matlab">
							m = 2
							m = 10
							m = -8
						</program>
					</stack>
				</sidebyside>
			</statement>
			<solution component="exercise-solution">
				<p>Here is one possible solution:</p>
				<program language="matlab">
					function m = myMin(v)
						m = v(1);
						for i = 2:length(v)
							if v(i) &lt; m
								m = v(i);
							end
						end
					end
				</program>
			</solution>
		</task>

		<task label="vectors-coding-myMean">
			<statement>
				<p>
					Write a function <pf>myMean</pf> that takes a vector <pf>v</pf> and returns the average (arithmetic mean) of its elements. Use a loop — do not use any built-in aggregate functions.
				</p>

				<tabular valign="top" top="minor">
					<col width="11%" halign="right" />
					<col width="15%" halign="left" />
					<col width="28%" halign="center" />
					<col width="46%" halign="left" />
					<row>
						<cell>Inputs:</cell>
						<cell><p><pf>v</pf></p></cell>
						<cell><p>(1xn) double</p></cell>
						<cell><p>vector with at least one element</p></cell>
					</row>
					<row bottom="minor">
						<cell>Outputs:</cell>
						<cell><p><pf>m</pf></p></cell>
						<cell><p>(1x1) double</p></cell>
						<cell><p>average of the elements of <pf>v</pf></p></cell>
					</row>
				</tabular>

				<sidebyside widths="49% 49%">
					<stack>
						<p>Test Cases ⤵︎</p>
						<program language="matlab">
							m = myMean([2, 4, 6, 8])
							m = myMean([10])
							m = myMean([1, 2, 3, 4, 5])
						</program>
					</stack>
					<stack>
						<p>Expected ⤵︎</p>
						<program language="matlab">
							m = 5
							m = 10
							m = 3
						</program>
					</stack>
				</sidebyside>
			</statement>
			<solution component="exercise-solution">
				<p>Here is one possible solution:</p>
				<program language="matlab">
					function m = myMean(v)
						s = 0;
						for x = v
							s = s + x;
						end
						m = s / length(v);
					end
				</program>
			</solution>
		</task>

		<task label="vectors-coding-countAbove">
			<statement>
				<p>
					Write a function <pf>countAbove</pf> that takes a vector <pf>v</pf> and a threshold <pf>t</pf>, and returns the number of elements in <pf>v</pf> that are strictly greater than <pf>t</pf>. Use a loop.
				</p>

				<tabular valign="top" top="minor">
					<col width="11%" halign="right" />
					<col width="15%" halign="left" />
					<col width="28%" halign="center" />
					<col width="46%" halign="left" />
					<row>
						<cell>Inputs:</cell>
						<cell><p><pf>v</pf></p></cell>
						<cell><p>(1xn) double</p></cell>
						<cell><p>vector to scan</p></cell>
					</row>
					<row>
						<cell></cell>
						<cell><p><pf>t</pf></p></cell>
						<cell><p>(1x1) double</p></cell>
						<cell><p>threshold value</p></cell>
					</row>
					<row bottom="minor">
						<cell>Outputs:</cell>
						<cell><p><pf>count</pf></p></cell>
						<cell><p>(1x1) double</p></cell>
						<cell><p>number of elements strictly greater than <pf>t</pf></p></cell>
					</row>
				</tabular>

				<sidebyside widths="49% 49%">
					<stack>
						<p>Test Cases ⤵︎</p>
						<program language="matlab">
							count = countAbove([1, 2, 3, 4, 5], 3)
							count = countAbove([10, 20, 30], 100)
							count = countAbove([5, 5, 5], 5)
							count = countAbove([-3, -1, 0, 1, 3], 0)
						</program>
					</stack>
					<stack>
						<p>Expected ⤵︎</p>
						<program language="matlab">
							count = 2
							count = 0
							count = 0
							count = 2
						</program>
					</stack>
				</sidebyside>
			</statement>
			<solution component="exercise-solution">
				<p>Here is one possible solution:</p>
				<program language="matlab">
					function count = countAbove(v, t)
						count = 0;
						for x = v
							if x &gt; t
								count = count + 1;
							end
						end
					end
				</program>
			</solution>
		</task>

		<task label="vectors-coding-firstAbove">
			<statement>
				<p>
					Write a function <pf>firstAbove</pf> that takes a vector <pf>v</pf> and a threshold <pf>t</pf>, and returns the position of the <em>first</em> element in <pf>v</pf> that is strictly greater than <pf>t</pf>. If no such element exists, return <pf>-1</pf>. Use a loop, and use <pf>return</pf> to stop the loop as soon as you find a match.
				</p>

				<tabular valign="top" top="minor">
					<col width="11%" halign="right" />
					<col width="15%" halign="left" />
					<col width="28%" halign="center" />
					<col width="46%" halign="left" />
					<row>
						<cell>Inputs:</cell>
						<cell><p><pf>v</pf></p></cell>
						<cell><p>(1xn) double</p></cell>
						<cell><p>vector to scan</p></cell>
					</row>
					<row>
						<cell></cell>
						<cell><p><pf>t</pf></p></cell>
						<cell><p>(1x1) double</p></cell>
						<cell><p>threshold value</p></cell>
					</row>
					<row bottom="minor">
						<cell>Outputs:</cell>
						<cell><p><pf>idx</pf></p></cell>
						<cell><p>(1x1) double</p></cell>
						<cell><p>position of first element above <pf>t</pf>, or <pf>-1</pf> if none</p></cell>
					</row>
				</tabular>

				<sidebyside widths="49% 49%">
					<stack>
						<p>Test Cases ⤵︎</p>
						<program language="matlab">
							idx = firstAbove([1, 2, 3, 4, 5], 3)
							idx = firstAbove([10, 20, 30], 100)
							idx = firstAbove([5, 10, 15], 0)
							idx = firstAbove([3, 1, 4, 1, 5, 9, 2, 6], 4)
						</program>
					</stack>
					<stack>
						<p>Expected ⤵︎</p>
						<program language="matlab">
							idx = 4
							idx = -1
							idx = 1
							idx = 5
						</program>
					</stack>
				</sidebyside>
			</statement>
			<solution component="exercise-solution">
				<p>
					Here is one possible solution. The <pf>return</pf> statement exits the function the moment a match is found, so the loop never visits later elements once the answer is known.
				</p>
				<program language="matlab">
					function idx = firstAbove(v, t)
						for i = 1:length(v)
							if v(i) &gt; t
								idx = i;
								return
							end
						end
						idx = -1;
					end
				</program>
			</solution>
		</task>

		<task label="vectors-coding-runningTotal">
			<statement>
				<p>
					Write a function <pf>runningTotal</pf> that takes a vector <pf>v</pf> and returns a new vector <pf>w</pf> of the same length, where <pf>w(i)</pf> is the sum of the first <pf>i</pf> elements of <pf>v</pf>. Preallocate the result vector with <pf>zeros</pf>, then fill it in using a loop.
				</p>

				<tabular valign="top" top="minor">
					<col width="11%" halign="right" />
					<col width="15%" halign="left" />
					<col width="28%" halign="center" />
					<col width="46%" halign="left" />
					<row>
						<cell>Inputs:</cell>
						<cell><p><pf>v</pf></p></cell>
						<cell><p>(1xn) double</p></cell>
						<cell><p>vector with at least one element</p></cell>
					</row>
					<row bottom="minor">
						<cell>Outputs:</cell>
						<cell><p><pf>w</pf></p></cell>
						<cell><p>(1xn) double</p></cell>
						<cell><p>running totals of <pf>v</pf></p></cell>
					</row>
				</tabular>

				<sidebyside widths="49% 49%">
					<stack>
						<p>Test Cases ⤵︎</p>
						<program language="matlab">
							w = runningTotal([1, 2, 3, 4])
							w = runningTotal([5])
							w = runningTotal([2, 0, 0, 5])
							w = runningTotal([1, -1, 1, -1])
						</program>
					</stack>
					<stack>
						<p>Expected ⤵︎</p>
						<program language="matlab">
							w = [1, 3, 6, 10]
							w = [5]
							w = [2, 2, 2, 7]
							w = [1, 0, 1, 0]
						</program>
					</stack>
				</sidebyside>
			</statement>
			<solution component="exercise-solution">
				<p>
					Here is one possible solution. Each element of <pf>w</pf> after the first is the previous running total plus the current input element.
				</p>
				<program language="matlab">
					function w = runningTotal(v)
						w = zeros(1, length(v));
						w(1) = v(1);
						for i = 2:length(v)
							w(i) = w(i - 1) + v(i);
						end
					end
				</program>
			</solution>
		</task>

		<task label="vectors-coding-differences">
			<statement>
				<p>
					Write a function <pf>differences</pf> that takes a vector <pf>v</pf> of length <m>n</m> and returns a vector <pf>w</pf> of length <m>n - 1</m>, where each element of <pf>w</pf> is the difference between consecutive elements of <pf>v</pf>:
					<me>w(i) = v(i+1) - v(i)</me>
					Preallocate the result vector with <pf>zeros</pf>, then fill it in using a loop.
				</p>

				<tabular valign="top" top="minor">
					<col width="11%" halign="right" />
					<col width="15%" halign="left" />
					<col width="28%" halign="center" />
					<col width="46%" halign="left" />
					<row>
						<cell>Inputs:</cell>
						<cell><p><pf>v</pf></p></cell>
						<cell><p>(1xn) double</p></cell>
						<cell><p>vector with at least two elements</p></cell>
					</row>
					<row bottom="minor">
						<cell>Outputs:</cell>
						<cell><p><pf>w</pf></p></cell>
						<cell><p>(1x(n-1)) double</p></cell>
						<cell><p>differences between consecutive elements</p></cell>
					</row>
				</tabular>

				<sidebyside widths="49% 49%">
					<stack>
						<p>Test Cases ⤵︎</p>
						<program language="matlab">
							w = differences([1, 3, 6, 10])
							w = differences([5, 5, 5])
							w = differences([10, 7, 12, 8])
							w = differences([0, 1])
						</program>
					</stack>
					<stack>
						<p>Expected ⤵︎</p>
						<program language="matlab">
							w = [2, 3, 4]
							w = [0, 0]
							w = [-3, 5, -4]
							w = [1]
						</program>
					</stack>
				</sidebyside>
			</statement>
			<solution component="exercise-solution">
				<p>
					Here is one possible solution. Notice that the loop runs from <pf>1</pf> to <pf>length(v) - 1</pf>, because <pf>v(i+1)</pf> needs to be a valid position.
				</p>
				<program language="matlab">
					function w = differences(v)
						w = zeros(1, length(v) - 1);
						for i = 1:length(v) - 1
							w(i) = v(i + 1) - v(i);
						end
					end
				</program>
			</solution>
		</task>

		<task label="vectors-coding-reverseWithLoop">
			<statement>
				<p>
					Earlier in this chapter you wrote <pf>reverseVector</pf> using slicing. Now write a function <pf>reverseWithLoop</pf> that does the same job — returning a new vector with the elements of <pf>v</pf> in reverse order — but using a loop instead of slicing. Preallocate the result vector with <pf>zeros</pf>.
				</p>

				<tabular valign="top" top="minor">
					<col width="11%" halign="right" />
					<col width="15%" halign="left" />
					<col width="28%" halign="center" />
					<col width="46%" halign="left" />
					<row>
						<cell>Inputs:</cell>
						<cell><p><pf>v</pf></p></cell>
						<cell><p>(1xn) double</p></cell>
						<cell><p>vector of any length</p></cell>
					</row>
					<row bottom="minor">
						<cell>Outputs:</cell>
						<cell><p><pf>w</pf></p></cell>
						<cell><p>(1xn) double</p></cell>
						<cell><p>elements of <pf>v</pf> in reverse order</p></cell>
					</row>
				</tabular>

				<sidebyside widths="49% 49%">
					<stack>
						<p>Test Cases ⤵︎</p>
						<program language="matlab">
							w = reverseWithLoop([1, 2, 3, 4, 5])
							w = reverseWithLoop([10, 20])
							w = reverseWithLoop([99])
						</program>
					</stack>
					<stack>
						<p>Expected ⤵︎</p>
						<program language="matlab">
							w = [5, 4, 3, 2, 1]
							w = [20, 10]
							w = [99]
						</program>
					</stack>
				</sidebyside>
			</statement>
			<solution component="exercise-solution">
				<p>
					Here is one possible solution. As <pf>i</pf> walks forward through <pf>w</pf>, the expression <pf>length(v) - i + 1</pf> walks backward through <pf>v</pf> — pairing the first slot of the output with the last element of the input, and so on.
				</p>
				<program language="matlab">
					function w = reverseWithLoop(v)
						w = zeros(1, length(v));
						for i = 1:length(v)
							w(i) = v(length(v) - i + 1);
						end
					end
				</program>
			</solution>
		</task>

		<task label="vectors-coding-interleave">
			<statement>
				<p>
					Write a function <pf>interleave</pf> that takes two equal-length vectors <pf>v</pf> and <pf>u</pf> and returns a new vector that alternates between them: the first element of <pf>v</pf>, then the first element of <pf>u</pf>, then the second of <pf>v</pf>, then the second of <pf>u</pf>, and so on. Preallocate the result vector with <pf>zeros</pf>.
				</p>

				<tabular valign="top" top="minor">
					<col width="11%" halign="right" />
					<col width="15%" halign="left" />
					<col width="28%" halign="center" />
					<col width="46%" halign="left" />
					<row>
						<cell>Inputs:</cell>
						<cell><p><pf>v</pf></p></cell>
						<cell><p>(1xn) double</p></cell>
						<cell><p>first vector</p></cell>
					</row>
					<row>
						<cell></cell>
						<cell><p><pf>u</pf></p></cell>
						<cell><p>(1xn) double</p></cell>
						<cell><p>second vector, same length as <pf>v</pf></p></cell>
					</row>
					<row bottom="minor">
						<cell>Outputs:</cell>
						<cell><p><pf>w</pf></p></cell>
						<cell><p>(1x(2n)) double</p></cell>
						<cell><p>elements of <pf>v</pf> and <pf>u</pf> alternating</p></cell>
					</row>
				</tabular>

				<sidebyside widths="49% 49%">
					<stack>
						<p>Test Cases ⤵︎</p>
						<program language="matlab">
							w = interleave([1, 2, 3], [10, 20, 30])
							w = interleave([1, 1], [2, 2])
							w = interleave([7], [8])
						</program>
					</stack>
					<stack>
						<p>Expected ⤵︎</p>
						<program language="matlab">
							w = [1, 10, 2, 20, 3, 30]
							w = [1, 2, 1, 2]
							w = [7, 8]
						</program>
					</stack>
				</sidebyside>
			</statement>
			<solution component="exercise-solution">
				<p>
					Here is one possible solution. The output index <pf>2*i - 1</pf> hits positions 1, 3, 5, … (the odd slots), and <pf>2*i</pf> hits positions 2, 4, 6, … (the even slots).
				</p>
				<program language="matlab">
					function w = interleave(v, u)
						w = zeros(1, 2 * length(v));
						for i = 1:length(v)
							w(2*i - 1) = v(i);
							w(2*i) = u(i);
						end
					end
				</program>
			</solution>
		</task>

		<task label="vectors-coding-countEvens">
			<statement>
				<p>
					Write a function <pf>countEvens</pf> that takes a vector <pf>v</pf> of integers and returns the number of even elements. Recall that an integer <pf>x</pf> is even when <pf>mod(x, 2)</pf> equals <pf>0</pf>. Use a loop.
				</p>

				<tabular valign="top" top="minor">
					<col width="11%" halign="right" />
					<col width="15%" halign="left" />
					<col width="28%" halign="center" />
					<col width="46%" halign="left" />
					<row>
						<cell>Inputs:</cell>
						<cell><p><pf>v</pf></p></cell>
						<cell><p>(1xn) double</p></cell>
						<cell><p>vector of integers</p></cell>
					</row>
					<row bottom="minor">
						<cell>Outputs:</cell>
						<cell><p><pf>count</pf></p></cell>
						<cell><p>(1x1) double</p></cell>
						<cell><p>number of even elements in <pf>v</pf></p></cell>
					</row>
				</tabular>

				<sidebyside widths="49% 49%">
					<stack>
						<p>Test Cases ⤵︎</p>
						<program language="matlab">
							count = countEvens([1, 2, 3, 4, 5, 6])
							count = countEvens([1, 3, 5, 7])
							count = countEvens([2, 4, 6, 8])
							count = countEvens([0, -2, -3, 7])
						</program>
					</stack>
					<stack>
						<p>Expected ⤵︎</p>
						<program language="matlab">
							count = 3
							count = 0
							count = 4
							count = 2
						</program>
					</stack>
				</sidebyside>
			</statement>
			<solution component="exercise-solution">
				<p>Here is one possible solution:</p>
				<program language="matlab">
					function count = countEvens(v)
						count = 0;
						for x = v
							if mod(x, 2) == 0
								count = count + 1;
							end
						end
					end
				</program>
			</solution>
		</task>

		<task label="vectors-coding-indexOfMax">
			<statement>
				<p>
					Write a function <pf>indexOfMax</pf> that takes a vector <pf>v</pf> and returns the <em>position</em> of its largest element — not the value itself. If the largest value appears more than once, return the position of the first occurrence. Use a loop.
				</p>

				<tabular valign="top" top="minor">
					<col width="11%" halign="right" />
					<col width="15%" halign="left" />
					<col width="28%" halign="center" />
					<col width="46%" halign="left" />
					<row>
						<cell>Inputs:</cell>
						<cell><p><pf>v</pf></p></cell>
						<cell><p>(1xn) double</p></cell>
						<cell><p>vector with at least one element</p></cell>
					</row>
					<row bottom="minor">
						<cell>Outputs:</cell>
						<cell><p><pf>idx</pf></p></cell>
						<cell><p>(1x1) double</p></cell>
						<cell><p>position of the largest element of <pf>v</pf></p></cell>
					</row>
				</tabular>

				<sidebyside widths="49% 49%">
					<stack>
						<p>Test Cases ⤵︎</p>
						<program language="matlab">
							idx = indexOfMax([3, 7, 2, 9, 5])
							idx = indexOfMax([10])
							idx = indexOfMax([5, 5, 5])
							idx = indexOfMax([-3, -1, -8, -2])
						</program>
					</stack>
					<stack>
						<p>Expected ⤵︎</p>
						<program language="matlab">
							idx = 4
							idx = 1
							idx = 1
							idx = 2
						</program>
					</stack>
				</sidebyside>
			</statement>
			<solution component="exercise-solution">
				<p>
					Here is one possible solution. The strict inequality <pf>&gt;</pf> (rather than <pf>&gt;=</pf>) is what guarantees the first occurrence wins when there are ties.
				</p>
				<program language="matlab">
					function idx = indexOfMax(v)
						idx = 1;
						for i = 2:length(v)
							if v(i) &gt; v(idx)
								idx = i;
							end
						end
					end
				</program>
			</solution>
		</task>

		<task label="vectors-coding-replaceNegatives">
			<statement>
				<p>
					Write a function <pf>replaceNegatives</pf> that takes a vector <pf>v</pf> and a value <pf>newval</pf>, and returns a new vector where every negative element of <pf>v</pf> has been replaced by <pf>newval</pf>. Non-negative elements should be left alone. Use a loop.
				</p>

				<tabular valign="top" top="minor">
					<col width="11%" halign="right" />
					<col width="15%" halign="left" />
					<col width="28%" halign="center" />
					<col width="46%" halign="left" />
					<row>
						<cell>Inputs:</cell>
						<cell><p><pf>v</pf></p></cell>
						<cell><p>(1xn) double</p></cell>
						<cell><p>vector to scan</p></cell>
					</row>
					<row>
						<cell></cell>
						<cell><p><pf>newval</pf></p></cell>
						<cell><p>(1x1) double</p></cell>
						<cell><p>replacement value for negative entries</p></cell>
					</row>
					<row bottom="minor">
						<cell>Outputs:</cell>
						<cell><p><pf>w</pf></p></cell>
						<cell><p>(1xn) double</p></cell>
						<cell><p>vector with negative elements replaced</p></cell>
					</row>
				</tabular>

				<sidebyside widths="49% 49%">
					<stack>
						<p>Test Cases ⤵︎</p>
						<program language="matlab">
							w = replaceNegatives([1, -2, 3, -4, 5], 0)
							w = replaceNegatives([-1, -2, -3], 99)
							w = replaceNegatives([1, 2, 3], 0)
							w = replaceNegatives([0, -1, 0, -2], 100)
						</program>
					</stack>
					<stack>
						<p>Expected ⤵︎</p>
						<program language="matlab">
							w = [1, 0, 3, 0, 5]
							w = [99, 99, 99]
							w = [1, 2, 3]
							w = [0, 100, 0, 100]
						</program>
					</stack>
				</sidebyside>
			</statement>
			<solution component="exercise-solution">
				<p>
					Here is one possible solution. Starting with a copy of <pf>v</pf> and only modifying the positions that need changing is cleaner than rebuilding the whole vector from scratch.
				</p>
				<program language="matlab">
					function w = replaceNegatives(v, newval)
						w = v;
						for i = 1:length(v)
							if w(i) &lt; 0
								w(i) = newval;
							end
						end
					end
				</program>
			</solution>
		</task>

		<task label="vectors-coding-vectorContains">
			<statement>
				<p>
					Write a function <pf>vectorContains</pf> that takes a vector <pf>v</pf> and a target value <pf>target</pf>, and returns <pf>true</pf> if <pf>target</pf> appears anywhere in <pf>v</pf>, and <pf>false</pf> otherwise. Use a loop, and use <pf>return</pf> to stop the loop as soon as you find a match.
				</p>

				<tabular valign="top" top="minor">
					<col width="11%" halign="right" />
					<col width="15%" halign="left" />
					<col width="28%" halign="center" />
					<col width="46%" halign="left" />
					<row>
						<cell>Inputs:</cell>
						<cell><p><pf>v</pf></p></cell>
						<cell><p>(1xn) double</p></cell>
						<cell><p>vector to search</p></cell>
					</row>
					<row>
						<cell></cell>
						<cell><p><pf>target</pf></p></cell>
						<cell><p>(1x1) double</p></cell>
						<cell><p>value to search for</p></cell>
					</row>
					<row bottom="minor">
						<cell>Outputs:</cell>
						<cell><p><pf>found</pf></p></cell>
						<cell><p>(1x1) logical</p></cell>
						<cell><p><pf>true</pf> if <pf>target</pf> appears in <pf>v</pf>, otherwise <pf>false</pf></p></cell>
					</row>
				</tabular>

				<sidebyside widths="49% 49%">
					<stack>
						<p>Test Cases ⤵︎</p>
						<program language="matlab">
							found = vectorContains([1, 2, 3, 4, 5], 3)
							found = vectorContains([1, 2, 3], 99)
							found = vectorContains([7], 7)
							found = vectorContains([10, 20, 30], 5)
						</program>
					</stack>
					<stack>
						<p>Expected ⤵︎</p>
						<program language="matlab">
							found = true
							found = false
							found = true
							found = false
						</program>
					</stack>
				</sidebyside>
			</statement>
			<solution component="exercise-solution">
				<p>
					Here is one possible solution. The function returns <pf>true</pf> as soon as a match is found; if the loop finishes without finding one, the function falls through to <pf>found = false</pf>.
				</p>
				<program language="matlab">
					function found = vectorContains(v, target)
						for x = v
							if x == target
								found = true;
								return
							end
						end
						found = false;
					end
				</program>
			</solution>
		</task>

		<task label="vectors-coding-findClosest">
			<statement>
				<p>
					Write a function <pf>findClosest</pf> that takes a vector <pf>v</pf> and a target value <pf>target</pf>, and returns the element of <pf>v</pf> that is closest to <pf>target</pf>. The closest element is the one whose absolute difference from <pf>target</pf> is smallest. If two elements are equally close, return the one that appears first. Use a loop.
				</p>

				<tabular valign="top" top="minor">
					<col width="11%" halign="right" />
					<col width="15%" halign="left" />
					<col width="28%" halign="center" />
					<col width="46%" halign="left" />
					<row>
						<cell>Inputs:</cell>
						<cell><p><pf>v</pf></p></cell>
						<cell><p>(1xn) double</p></cell>
						<cell><p>vector with at least one element</p></cell>
					</row>
					<row>
						<cell></cell>
						<cell><p><pf>target</pf></p></cell>
						<cell><p>(1x1) double</p></cell>
						<cell><p>value to compare against</p></cell>
					</row>
					<row bottom="minor">
						<cell>Outputs:</cell>
						<cell><p><pf>closest</pf></p></cell>
						<cell><p>(1x1) double</p></cell>
						<cell><p>element of <pf>v</pf> closest to <pf>target</pf></p></cell>
					</row>
				</tabular>

				<sidebyside widths="49% 49%">
					<stack>
						<p>Test Cases ⤵︎</p>
						<program language="matlab">
							closest = findClosest([1, 5, 10, 15], 7)
							closest = findClosest([1, 5, 10, 15], 12)
							closest = findClosest([10], 100)
							closest = findClosest([-3, -1, 2, 4], 0)
						</program>
					</stack>
					<stack>
						<p>Expected ⤵︎</p>
						<program language="matlab">
							closest = 5
							closest = 10
							closest = 10
							closest = -1
						</program>
					</stack>
				</sidebyside>
			</statement>
			<solution component="exercise-solution">
				<p>
					Here is one possible solution. The function tracks both the running best element and its distance from the target; whenever a closer element is found, both are updated together.
				</p>
				<program language="matlab">
					function closest = findClosest(v, target)
						closest = v(1);
						bestDist = abs(v(1) - target);
						for i = 2:length(v)
							d = abs(v(i) - target);
							if d &lt; bestDist
								closest = v(i);
								bestDist = d;
							end
						end
					end
				</program>
			</solution>
		</task>

	</exercise>

</exercises>