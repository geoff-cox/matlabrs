<!--META-DATA
{
	tags: ["if", "for", "while", "vector"],
}
-->

<statement>
	<p>
		Returns the number of times a number occurs in a given list of numbers.
		<tabular valign="top" halign="right" top="minor">
			<col width="12%"/>
			<col width="88%" halign="left"/>
			<row>
				<cell>Inputs:</cell>
				<cell>
					<p><pf>list</pf> (1 x N) double vector</p>
				</cell>
			</row>
			<row bottom="minor">
				<cell/>
				<cell>
					<p><pf>num</pf> (1 x 1) double — number we are looking for in <pf>list</pf></p>
				</cell>
			</row>
			<row bottom="minor">
				<cell>Outputs:</cell>
				<cell>
					<p><pf>num_count</pf> (1 x 1) integer — number of times <pf>num</pf> occurs in <pf>list</pf></p>
				</cell>
			</row>
			<row>
				<cell>Details:</cell>
				<cell><p>▸ Use <pf>numel</pf>, <pf>size</pf>, or <pf>length</pf> to get the number of values in the list.</p></cell>
			</row>
			<row>
				<cell/>
				<cell><p>▸ Use a <pf>for</pf> or <pf>while</pf> loop together with an <pf>if</pf>-statement.</p></cell>
			</row>
			<row bottom="minor">
				<cell/>
				<cell><p>▸ No other built-in MATLAB commands are allowed.</p></cell>
			</row>
		</tabular>
	</p>

	<p>
		Examples:
		<program>
			<code>
				num_count = list_occurrences([1 1 1 -9 0 0 6 6 -1 6 7 1 2], 1)
				% returns 4
			</code>
		</program>
		<program>
			<code>
				num_count = list_occurrences([1 1 1 -9 0 0 6 6 -1 6 7 1 2], -6)
				% returns 0
			</code>
		</program>
	</p>
</statement>
