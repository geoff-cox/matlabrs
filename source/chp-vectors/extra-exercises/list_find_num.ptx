<!--META-DATA
{
tags: for, while, vector, indexing, find-indices,
}
-->

<statement>
	<p>
		Returns the index locations where the given number appears in the list.
	</p>

	<tabular valign="top" halign="right" top="minor">
		<col width="12%"/>
		<col width="88%" halign="left"/>

		<row bottom="minor">
			<cell>Inputs:</cell>
			<cell>
				<p><pf>list</pf> (1 x N) double vector — list of numbers</p>
				<p><pf>num</pf> (1 x 1) double — value to find in <pf>list</pf></p>
			</cell>
		</row>

		<row bottom="minor">
			<cell>Outputs:</cell>
			<cell>
				<p><pf>indices</pf> (1 x m) integer vector — locations in <pf>list</pf> where <pf>num</pf> appears; <pf>[]</pf> if none</p>
			</cell>
		</row>

		<row>
			<cell>Details:</cell>
			<cell><p>▸ Use a <pf>for</pf> or <pf>while</pf> loop with an <pf>if</pf>-statement. Do not use <pf>find</pf>.</p></cell>
		</row>
		<row bottom="minor">
			<cell/>
			<cell><p>▸ Preallocate the output (e.g., with <pf>zeros</pf>) if you choose a fixed-capacity approach.</p></cell>
		</row>
		<row>
			<cell/>
			<cell><p>▸ Do not use the <pf>find</pf> command.</p></cell>
		</row>
	</tabular>

	<p>
		Examples:
		<program>
			<code>
				% Example calls and expected results
				loc = locate_number([1 1 1 -9 0 0 6 6 -1 6 7 0 2], 0)
				% returns [5 6 12]
				where_is_1 = locate_number([1 1 1 -9 0 0 6 6 -1 6 7 0 2], 1)
				% returns [1 2 3]
				this_result = locate_number([1 1 1 -9 1 3 6 6 -1 6 7 2], 14)
				% returns []
			</code>
		</program>
	</p>
</statement>