<!--META-DATA
{
	tags: ["for", "while", "mod", "vector"],
}
-->

<statement>
	<p>
		Returns a list of proper divisors of an integer.
		<ul>
			<li>A <em>divisor</em> of a number, <m>N</m>, is a number that divides <m>N</m> evenly (remainder zero).</li>
			<li>A <em>proper divisor</em> of <m>N</m> is any divisor less than <m>N</m>.</li>
			<li>For example, the proper divisors of <m>12</m> are <m>1, 2, 3, 4, 6</m>.</li>
		</ul>
	</p>

	<tabular valign="top" halign="right" top="minor">
		<col width="12%"/>
		<col width="88%" halign="left"/>
		<row bottom="minor">
			<cell>Inputs:</cell>
			<cell>
				<p><pf>num</pf> (1 x 1) integer</p>
			</cell>
		</row>
		<row bottom="minor">
			<cell>Outputs:</cell>
			<cell>
				<p><pf>divisors</pf> (1 x N) integer vector — contains the proper divisors of <pf>num</pf>.</p>
			</cell>
		</row>
			<row>
			<cell>Details:</cell>
			<cell>
				<p>Use a <pf>for</pf> or <pf>while</pf> loop to code this.</p>
			</cell>
		</row>
		<row bottom="minor">
				<cell/>
			<cell>
				<p>You will need MATLAB's <pf>mod</pf> function.</p>
			</cell>
		</row>
	</tabular>

	<p>
		Examples:
	<program>
		<code>
			divisors = proper_divisors(81)
			% should return
			% divisors = 1  3  9  27
		</code>
	</program>
	<program>
		<code>
			divisors = proper_divisors(18111)
			% should return
			% divisors = 1  3  6037
		</code>
	</program>
	<program>
		<code>
			divisors = proper_divisors(11)
			% should return
			% divisors = 1
		</code>
	</program>
	</p>
</statement>
