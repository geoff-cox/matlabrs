<!--META-DATA
{
	tags: while, for,
}
-->

<statement>
	<p>
		Returns the number of negative values occurring in &lt;pf&gt;list&lt;/pf&gt;.
	</p>

	<tabular valign="top" top="minor">
		<col width="12%"/>
		<col width="88%"/>
		<row bottom="minor">
			<cell>Inputs:</cell>
			<cell>
				<p><pf>list</pf> (1 x N) double — list of numeric values (doubles).</p>
			</cell>
		</row>
		<row bottom="minor">
			<cell>Outputs:</cell>
			<cell>
				<p><pf>neg_count</pf> (1 x 1) number — number of negative values occurring in <pf>list</pf>.</p>
			</cell>
		</row>
		<row>
			<cell>Details:</cell>
			<cell><p>▸ Use</p></cell>
		</row>
		<row>
			<cell/>
			<cell><p>numel</p></cell>
		</row>
		<row>
			<cell/>
			<cell><p>,</p></cell>
		</row>
		<row>
			<cell/>
			<cell><p>size</p></cell>
		</row>
		<row>
			<cell/>
			<cell><p>, or</p></cell>
		</row>
		<row>
			<cell/>
			<cell><p>length</p></cell>
		</row>
		<row>
			<cell/>
			<cell><p>to get the number of values in the list. No other built-in MATLAB commands are allowed.</p></cell>
		</row>
		<row>
			<cell/>
			<cell><p>▸ Use a</p></cell>
		</row>
		<row>
			<cell/>
			<cell><p>for</p></cell>
		</row>
		<row>
			<cell/>
			<cell><p>or</p></cell>
		</row>
		<row>
			<cell/>
			<cell><p>while</p></cell>
		</row>
		<row>
			<cell/>
			<cell><p>loop together with an</p></cell>
		</row>
		<row>
			<cell/>
			<cell><p>if</p></cell>
		</row>
		<row bottom="minor">
			<cell/>
			<cell><p>-statement to code this.</p></cell>
		</row>
	</tabular>

	<p>
		Examples:
		<program>
			<code>
				neg_count = negative_count([111 -90 20 66 -167 42])
				neg_count = 2
				neg_count = negative_count([1 1 1 0 1])
				neg_count = 0
			</code>
		</program>
	</p>
</statement>
