<!--META-DATA
{
tags: for, while, vector, logical, symmetry,
}
-->

<statement>
	<p>
		Returns <pf>true</pf> if a list is symmetric (second half mirrors the first about the middle), and <pf>false</pf> otherwise.
	</p>

	<tabular valign="top" halign="right" top="minor">
		<col width="12%"/>
		<col width="88%" halign="left"/>

		<row bottom="minor">
			<cell>Inputs:</cell>
			<cell>
			<p><pf>list</pf> (1 x N) double vector — list of numbers</p>
			</cell>
		</row>

		<row bottom="minor">
			<cell>Outputs:</cell>
			<cell>
			<p><pf>answer</pf> (1 x 1) logical — <pf>true</pf> if <pf>list</pf> is symmetric; <pf>false</pf> otherwise</p>
			</cell>
		</row>

		<row bottom="minor">
			<cell>Details:</cell>
			<cell><p>▸ A single number is considered symmetric. Implement with a loop (<pf>for</pf> or <pf>while</pf>).</p></cell>
		</row>
	</tabular>

	<p>
		Examples:
		<program>
			<code>
				% Example calls and expected results
				answer = is_symmetric([1 -3 1 -3 2])
				% returns 0
				answer = is_symmetric([1 -3 1 -3 1])
				% returns 1
				answer = is_symmetric([1 -3 -3 1])
				% returns 1
			</code>
		</program>
	</p>
</statement>
