						<stack>
							<program language="matlab">
								fprintf('Hello!\n')
								fprintf('Hello!\n')
								fprintf('Hello!\n')
								fprintf('Hello!\n')
								fprintf('Hello!\n')
								fprintf('Hello!\n')
							</program>
						</stack>
						<stack>
							<program language="matlab" line-numbers="no">
								% ==== Write your for loop here ====
								󠀠
								󠀠
								󠀠
								󠀠
								󠀠
							</program>
						</stack>
					</sidebyside>
				</statement>
			</task>

			<task xml:id="quiz-for-loops-rewrite-drill-2">
