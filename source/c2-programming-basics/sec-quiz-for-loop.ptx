    <exercise xml:id="quiz-for-loop-function-writing">
      <title>Write Functions with for-Loops</title>

      <task xml:id="quiz-for-loop-function-writing-1">
        <statement>
          <p>
            Write a function named <pf>sumFromOne</pf> that takes a positive integer <pf>n</pf> and returns
            <m>1 + 2 + \cdots + n</m> using a <pf>for</pf>-loop.
          </p>
          <program language="matlab">
% Write your function here
function total = sumFromOne(n)



end
          </program>
        </statement>
      </task>

      <task xml:id="quiz-for-loop-function-writing-2">
        <statement>
          <p>
            Write a function named <pf>countDivByFive</pf> that takes a positive integer <pf>n</pf> and returns how many integers from 1 through <pf>n</pf> are divisible by 5.
          </p>
          <program language="matlab">
% Write your function here
function count = countDivByFive(n)



end
          </program>
        </statement>
      </task>

      <task xml:id="quiz-for-loop-function-writing-3">
        <statement>
          <p>
            Write a function named <pf>sumRounded</pf> that takes a positive integer <pf>n</pf>. In a loop from 1 to <pf>n</pf>, add <pf>round(k/2)</pf> to a running total. Return the total.
          </p>
          <program language="matlab">
% Write your function here
function total = sumRounded(n)



end
          </program>
        </statement>
      </task>
    </exercise>
  </worksheet>
</section>
