		</exercise>

		<exercise xml:id="quiz-for-loop-function-2">
			<title>Counting Heads</title>

			<task xml:id="quiz-for-loop-function-2a">
				<statement>
					<p>
						Write a function named <pf>headsCount</pf> that uses a for loop to count the number of heads that result from flipping a coin <pf>n</pf> times. 
						Inside the loop, simulate a single coin flip using <pf>randi([0,1])</pf>, where <pf>0</pf> represents tails and <pf>1</pf> represents heads.
					</p>

					<sidebyside>
						<stack>
							<tabular valign="top" halign="right" top="minor">
								<col width="12%"/>
								<col width="12%" halign="left"/>
								<col width="22%" halign="left"/>
								<col width="54%" halign="left"/>
								<row>
									<cell><p>Inputs:</p></cell>
									<cell><p><pf>n</pf></p></cell>
									<cell><p>(1x1) double</p></cell>
									<cell><p>number of coin flips</p></cell>
								</row>
								<row bottom="minor">
									<cell><p>Outputs:</p></cell>
									<cell><p><pf>count</pf></p></cell>
									<cell><p>(1x1) double</p></cell>
									<cell><p>the number of heads in <pf>n</pf> coin flips</p></cell>
								</row>
							</tabular>
						</stack>
					</sidebyside>

					<program language="matlab">
						% Write your headsCount function here. You must use a for-loop.
								󠀠
								󠀠
								󠀠
								󠀠
								󠀠
								󠀠
								󠀠
								󠀠
								󠀠
								󠀠
								󠀠
								󠀠
					</program>
				</statement>
			</task>

