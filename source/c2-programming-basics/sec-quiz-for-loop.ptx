<section xml:id="sec-quiz-for-loop">
  <title>for-Loop Quiz</title>

  <worksheet xml:id="ws-quiz-for-loop">
    <title>Quiz: for-Loops</title>

    <exercise xml:id="quiz-for-loop-conceptual">
      <title>Conceptual Questions</title>

      <task xml:id="quiz-for-loop-conceptual-1">
        <statement>
          <p>
            In a MATLAB <pf>for</pf>-loop, which line controls how many times the loop body runs?
          </p>
        </statement>
        <choices randomize="no">
          <choice correct="yes">
            <statement><p>The range after the equals sign in the loop header</p></statement>
            <feedback><p>The values listed by the loop range determine each iteration.</p></feedback>
          </choice>
          <choice>
            <statement><p>The first line inside the loop body</p></statement>
            <feedback><p>Statements inside the body run after MATLAB chooses the current loop value.</p></feedback>
          </choice>
          <choice>
            <statement><p>The <pf>end</pf> keyword</p></statement>
            <feedback><p><pf>end</pf> closes the loop block but does not define iteration values.</p></feedback>
          </choice>
          <choice>
            <statement><p>The value printed by <pf>fprintf</pf></p></statement>
            <feedback><p>Printing output does not control loop iteration count.</p></feedback>
          </choice>
        </choices>
      </task>

      <task xml:id="quiz-for-loop-conceptual-2">
        <statement correct="yes">
          <p>
            If you run <pf>for k = 2:2:8</pf>, then <pf>k</pf> takes the values 2, 4, 6, and 8.
          </p>
        </statement>
        <feedback>
          <p>
            The loop starts at 2, steps by 2, and stops at 8.
          </p>
        </feedback>
      </task>

      <task xml:id="quiz-for-loop-conceptual-3">
        <statement>
          <p>
            Which loop header counts backward from 9 down to 1?
          </p>
        </statement>
        <choices randomize="no">
          <choice>
            <statement><p><pf>for n = 9:1</pf></p></statement>
            <feedback><p>This range is empty because the default step is positive.</p></feedback>
          </choice>
          <choice correct="yes">
            <statement><p><pf>for n = 9:-1:1</pf></p></statement>
            <feedback><p>A step of <pf>-1</pf> correctly moves downward each iteration.</p></feedback>
          </choice>
          <choice>
            <statement><p><pf>for n = -1:9:1</pf></p></statement>
            <feedback><p>This starts at <pf>-1</pf> and does not produce the requested countdown.</p></feedback>
          </choice>
          <choice>
            <statement><p><pf>for n = 1:-1:9</pf></p></statement>
            <feedback><p>This range is empty because the start value is below the stop value for a negative step.</p></feedback>
          </choice>
        </choices>
      </task>

      <task xml:id="quiz-for-loop-conceptual-4">
        <statement correct="yes">
          <p>
            You should initialize a running total before a <pf>for</pf>-loop if the loop keeps adding to that total.
          </p>
        </statement>
        <feedback>
          <p>
            Initialization gives the variable a known starting value before accumulation begins.
          </p>
        </feedback>
      </task>

      <task xml:id="quiz-for-loop-conceptual-5">
        <statement>
          <p>
            What values are generated by <pf>4:-2:-2</pf>?
          </p>
        </statement>
        <choices randomize="no">
          <choice>
            <statement><p><pf>4, 2, 0, -2, -4</pf></p></statement>
            <feedback><p>The range stops when it reaches the endpoint <pf>-2</pf>, so <pf>-4</pf> is not included.</p></feedback>
          </choice>
          <choice correct="yes">
            <statement><p><pf>4, 2, 0, -2</pf></p></statement>
            <feedback><p>Start at 4, subtract 2 each time, and include <pf>-2</pf>.</p></feedback>
          </choice>
          <choice>
            <statement><p><pf>4, 3, 2, 1, 0, -1, -2</pf></p></statement>
            <feedback><p>This would use a step of <pf>-1</pf>, not <pf>-2</pf>.</p></feedback>
          </choice>
          <choice>
            <statement><p><pf>2, 0, -2</pf></p></statement>
            <feedback><p>The first value 4 is missing.</p></feedback>
          </choice>
        </choices>
      </task>

      <task xml:id="quiz-for-loop-conceptual-6">
        <statement>
          <p>
            Which expression checks whether <pf>n</pf> is even inside a loop?
          </p>
        </statement>
        <choices randomize="no">
          <choice correct="yes">
            <statement><p><pf>mod(n,2) == 0</pf></p></statement>
            <feedback><p>Even numbers leave remainder 0 when divided by 2.</p></feedback>
          </choice>
          <choice>
            <statement><p><pf>mod(n,2) == 1</pf></p></statement>
            <feedback><p>Remainder 1 identifies odd numbers, not even numbers.</p></feedback>
          </choice>
          <choice>
            <statement><p><pf>n/2 == 0</pf></p></statement>
            <feedback><p>This is only true when <pf>n</pf> is zero.</p></feedback>
          </choice>
          <choice>
            <statement><p><pf>n - 2 == 0</pf></p></statement>
            <feedback><p>This checks only whether <pf>n</pf> equals 2.</p></feedback>
          </choice>
        </choices>
      </task>

      <task xml:id="quiz-for-loop-conceptual-7">
        <statement correct="yes">
          <p>
            In a script, the loop variable from a <pf>for</pf>-loop remains in the workspace after the loop ends.
          </p>
        </statement>
        <feedback>
          <p>
            Script variables stay in the base workspace unless you clear them.
          </p>
        </feedback>
      </task>

      <task xml:id="quiz-for-loop-conceptual-8">
        <statement>
          <p>
            Which line correctly starts a loop that runs exactly 7 times?
          </p>
        </statement>
        <choices randomize="no">
          <choice>
            <statement><p><pf>for t = 0:7</pf></p></statement>
            <feedback><p>This runs 8 times because it includes both 0 and 7.</p></feedback>
          </choice>
          <choice correct="yes">
            <statement><p><pf>for t = 1:7</pf></p></statement>
            <feedback><p>The values 1 through 7 give exactly 7 iterations.</p></feedback>
          </choice>
          <choice>
            <statement><p><pf>for t = 7</pf></p></statement>
            <feedback><p>This runs only once with <pf>t = 7</pf>.</p></feedback>
          </choice>
          <choice>
            <statement><p><pf>for t = 7:-1</pf></p></statement>
            <feedback><p>This is not a complete descending range.</p></feedback>
          </choice>
        </choices>
      </task>

      <task xml:id="quiz-for-loop-conceptual-9">
        <statement>
          <p>
            A student wants each loop iteration to print on a new line. Which format string should they use with <pf>fprintf</pf>?
          </p>
        </statement>
        <choices randomize="no">
          <choice>
            <statement><p><pf>'%d'</pf></p></statement>
            <feedback><p>This prints values back-to-back unless another separator is added.</p></feedback>
          </choice>
          <choice correct="yes">
            <statement><p><pf>'%d\n'</pf></p></statement>
            <feedback><p><pf>\n</pf> inserts a newline after each printed value.</p></feedback>
          </choice>
          <choice>
            <statement><p><pf>'%d\t'</pf></p></statement>
            <feedback><p><pf>\t</pf> adds a tab, not a new line.</p></feedback>
          </choice>
          <choice>
            <statement><p><pf>'\n%d'</pf></p></statement>
            <feedback><p>This starts by moving to a new line before printing.</p></feedback>
          </choice>
        </choices>
      </task>

      <task xml:id="quiz-for-loop-conceptual-10">
        <statement>
          <p>
            Which statement best describes when to use a <pf>for</pf>-loop in this chapter?
          </p>
        </statement>
        <choices randomize="no">
          <choice correct="yes">
            <statement><p>Use it when you know the sequence of values or the number of repeats ahead of time.</p></statement>
            <feedback><p>That is the main use case for <pf>for</pf>-loops in beginner MATLAB programming.</p></feedback>
          </choice>
          <choice>
            <statement><p>Use it only when you need nested loops.</p></statement>
            <feedback><p>Nested loops are not required for ordinary repetition tasks.</p></feedback>
          </choice>
          <choice>
            <statement><p>Use it only when you need random numbers.</p></statement>
            <feedback><p>Loops are useful for many repeated tasks, not just random-number tasks.</p></feedback>
          </choice>
          <choice>
            <statement><p>Use it only inside functions, not scripts.</p></statement>
            <feedback><p><pf>for</pf>-loops work in both scripts and functions.</p></feedback>
          </choice>
        </choices>
      </task>
    </exercise>

    <exercise xml:id="quiz-for-loop-rewrite">
      <title>Rewrite Repeated Code and Loop Code</title>

      <task xml:id="quiz-for-loop-rewrite-1">
        <statement>
          <p>
            Rewrite this repeated code as one <pf>for</pf>-loop that prints the same output:
          </p>
          <program language="matlab">
fprintf('Step 1 complete\n')
fprintf('Step 2 complete\n')
fprintf('Step 3 complete\n')
fprintf('Step 4 complete\n')
          </program>
          <program language="matlab" line-numbers="no">
% Write your for-loop here


          </program>
        </statement>
      </task>

      <task xml:id="quiz-for-loop-rewrite-2">
        <statement>
          <p>
            Rewrite this repeated code as one <pf>for</pf>-loop that updates <pf>score</pf> the same way:
          </p>
          <program language="matlab">
score = 10;
score = score + 2;
score = score + 2;
score = score + 2;
score = score + 2;
score = score + 2;
          </program>
          <program language="matlab" line-numbers="no">
% Write your for-loop here


          </program>
        </statement>
      </task>

      <task xml:id="quiz-for-loop-rewrite-3">
        <statement>
          <p>
            Expand the loop into equivalent repeated code lines:
          </p>
          <program language="matlab">
value = 3;
for n = 1:4
    value = value + n;
end
fprintf('%d\n', value)
          </program>
          <program language="matlab" line-numbers="no">
% Write the repeated code here (no loop)




          </program>
        </statement>
      </task>

      <task xml:id="quiz-for-loop-rewrite-4">
        <statement>
          <p>
            Expand the loop into equivalent repeated <pf>fprintf</pf> calls:
          </p>
          <program language="matlab">
for k = 6:-2:0
    fprintf('%d\n', k)
end
          </program>
          <program language="matlab" line-numbers="no">
% Write the repeated code here (no loop)



          </program>
        </statement>
      </task>
    </exercise>

    <exercise xml:id="quiz-for-loop-output">
      <title>Determine the Output</title>

      <task xml:id="quiz-for-loop-output-1">
        <statement>
          <p>
            What is printed?
          </p>
          <program language="matlab">
total = 0;
for n = 1:4
    total = total + n;
end
fprintf('total = %d\n', total)
          </program>
        </statement>
      </task>

      <task xml:id="quiz-for-loop-output-2">
        <statement>
          <p>
            What is printed?
          </p>
          <program language="matlab">
count = 0;
for n = 3:7
    if mod(n,2) == 1
        count = count + 1;
    end
end
fprintf('count = %d\n', count)
          </program>
        </statement>
      </task>

      <task xml:id="quiz-for-loop-output-3">
        <statement>
          <p>
            What does this function return when called with <pf>x = 3</pf>?
          </p>
          <program language="matlab">
function y = bump(x)
    y = x;
    for k = 1:5
        y = y + 2;
    end
end
          </program>
        </statement>
      </task>
    </exercise>

