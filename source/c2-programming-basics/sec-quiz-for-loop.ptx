<section xml:id="sec-quiz-looping-for-fundamentals" component="quiz">
	<title>for-Loops Quiz (Fundamentals)</title>

	<worksheet xml:id="ws-quiz-looping-for-fundamentals">
		<title>Quiz: for-Loops (Fundamentals)</title>

		<sidebyside widths="10% 90%">
			<stack>
				<p>NAME:</p>
				<p>HR:</p>
			</stack>
		</sidebyside>

    <!-- ========================================================= -->
    <!-- Conceptual Questions																			 -->
    <!-- ========================================================= -->

		<exercise xml:id="quiz-for-loop-conceptual">
			<title>Conceptual Questions</title>

			<task xml:id="quiz-for-loop-conceptual-3">
				<statement>
					<p>
						Which loop header counts backward from 9 down to 1?
					</p>
				</statement>
				<choices randomize="no">
					<choice>
						<statement><p><pf>for k = 9:1</pf></p></statement>
						<feedback><p>This range is empty because the default step is positive.</p></feedback>
					</choice>
					<choice correct="yes">
						<statement><p><pf>for k = 9:-1:1</pf></p></statement>
						<feedback><p>A step of <pf>-1</pf> correctly moves downward each iteration.</p></feedback>
					</choice>
					<choice>
						<statement><p><pf>for k = -1:9:1</pf></p></statement>
						<feedback><p>This starts at <pf>-1</pf> and does not produce the requested countdown.</p></feedback>
					</choice>
					<choice>
						<statement><p><pf>for k = 1:-1:9</pf></p></statement>
						<feedback><p>This range is empty because the start value is below the stop value for a negative step.</p></feedback>
					</choice>
				</choices>
			</task>

			<task xml:id="quiz-for-loop-conceptual-5">
				<statement>
					<p>
						What are the <pf>k</pf>-values generated by the loop header: <pf>for k = 4:-2:-2</pf>?
					</p>
				</statement>
				<choices randomize="no">
					<choice>
						<statement><p><pf>4, 2, 0, -2, -4</pf></p></statement>
						<feedback><p>The range stops when it reaches the endpoint <pf>-2</pf>, so <pf>-4</pf> is not included.</p></feedback>
					</choice>
					<choice correct="yes">
						<statement><p><pf>4, 2, 0, -2</pf></p></statement>
						<feedback><p>Start at 4, subtract 2 each time, and include <pf>-2</pf>.</p></feedback>
					</choice>
					<choice>
						<statement><p><pf>4, 3, 2, 1, 0, -1, -2</pf></p></statement>
						<feedback><p>This would use a step of <pf>-1</pf>, not <pf>-2</pf>.</p></feedback>
					</choice>
					<choice>
						<statement><p><pf>2, 0, -2</pf></p></statement>
						<feedback><p>The first value 4 is missing.</p></feedback>
					</choice>
				</choices>
			</task>

		</exercise>

    <!-- ========================================================= -->
    <!-- Rewrite the Code (repeated code ↔ for-loop)     					 -->
    <!-- ========================================================= -->

		<exercise xml:id="quiz-for-loop-rewrite">
			<title>Rewrite Repeated Code and Loop Code</title>

			<statement>

				<p>
					Rewrite each of the following repeated code snippets using a single <pf>for</pf>-loop. Your loop should produce the same output in the same order.
				</p>
				<sidebyside widths="44% 54%">
					<stack>
						<program language="matlab">
							fprintf('Step 1 complete\n')
							fprintf('Step 2 complete\n')
							fprintf('Step 3 complete\n')
							fprintf('Step 4 complete\n')
							󠀠
						</program>
					</stack>
					<stack>
						<program language="matlab" line-numbers="no">
							% ==== Write your for loop here ====
							󠀠
							󠀠
							󠀠
							󠀠
							󠀠
						</program>
					</stack>
				</sidebyside>

				<sidebyside widths="44% 54%">
					<stack>
						<program language="matlab">
							score = 10;
							score = score + 2;
							score = score + 2;
							score = score + 2;
							score = score + 2;
							score = score + 2;
						</program>
					</stack>
					<stack>
						<program language="matlab" line-numbers="no">
							% ==== Write your for loop here ====
							󠀠
							󠀠
							󠀠
							󠀠
							󠀠
						</program>
					</stack>
				</sidebyside>
			</statement>
		</exercise>

		<!-- ========================================================= -->
		<!-- Output-Tracing Questions																	 -->
		<!-- ========================================================= -->

		<exercise xml:id="quiz-for-loop-output">
			<title>Determine the Printed Values</title>

			<statement>
				<p>
					For each of the following code snippets, determine what is printed by <pf>fprintf</pf>.
				</p>
				<sidebyside width="49%">
					<stack>
						<program language="matlab">
							total = 0;
							for k = 1:4
								total = total + n - 1;
							end
							fprintf('total = %d\n', total)
						</program>
					</stack>
					<stack>
						<program language="matlab" line-numbers="no">
							% What does this print?



							total = 
						</program>
					</stack>
				</sidebyside>

				<sidebyside width="49%">
					<stack>
						<program language="matlab">
							x = 1;
							for k = 3:3:12
								x = 2*x;
							end
							fprintf('x = %d\n', x)
						</program>
					</stack>
					<stack>
						<program language="matlab" line-numbers="no">
							% What does this print?



							x = 
						</program>
					</stack>
				</sidebyside>
			</statement>

		</exercise>

		<exercise xml:id="quiz-for-loop-function-output">
			<title>Determine the Output of Functions</title>

			<statement>
				<p>
					For each of the following functions, determine the output when called with the given input.
				</p>
				<p>
					What does this function return when <pf>x = 3</pf>?
				</p>
				<sidebyside width="49%">
					<stack>
						<program language="matlab">
							function y = bump(x)
								y = x;
								for k = 1:5
									y = y + 2;
								end
							end
						</program>
					</stack>
					<stack>
						<program language="matlab" line-numbers="no">
							% What is the value of out?

							out = bump(3);

							out = 
							󠀠
						</program>
					</stack>
				</sidebyside>

				<p>
					What does this function return when <pf>n = 6</pf>?
				</p>
				<sidebyside width="49%">
					<stack>
						<program language="matlab">
							function c = dump(n)
								c = 0;
								for k = 1:n
									if mod(k, 3) == 0
										c = c + 1;
									end
								end
							end
						</program>
					</stack>
					<stack>
						<program language="matlab" line-numbers="no">
							% What is the value of out?

							out = dump(6);

							out = 
							󠀠
							󠀠
							󠀠
						</program>
					</stack>
				</sidebyside>
			</statement>
		</exercise>
	
		<!-- ========================================================= -->
		<!-- Function-Writing Questions																 -->
		<!-- ========================================================= -->

		<exercise xml:id="quiz-for-loop-function-1">
			<title>Summing with a for-Loop</title>

			<task xml:id="quiz-for-loop-function-1a">
				<statement>
					<p>
						Write a function named <pf>sumFromOne</pf> that takes a positive integer <pf>n</pf> and returns the sum:
						<me>1 + 2 + \cdots + n</me> 
					</p>

					<sidebyside>
						<stack>
							<tabular valign="top" halign="right" top="minor">
								<col width="12%"/>
								<col width="12%" halign="left"/>
								<col width="22%" halign="left"/>
								<col width="54%" halign="left"/>
								<row>
									<cell><p>Inputs:</p></cell>
									<cell><p><pf>n</pf></p></cell>
									<cell><p>(1x1) double</p></cell>
									<cell><p>number to sum up to</p></cell>
								</row>
								<row bottom="minor">
									<cell><p>Outputs:</p></cell>
									<cell><p><pf>total</pf></p></cell>
									<cell><p>(1x1) double</p></cell>
									<cell><p>the sum above</p></cell>
								</row>
							</tabular>
						</stack>
					</sidebyside>

					<program language="matlab">
						% Write your sumFromOne function here. You must use a for-loop.
								󠀠
								󠀠
								󠀠
								󠀠
								󠀠
								󠀠
								󠀠
								󠀠
								󠀠
								󠀠
								󠀠
								󠀠
					</program>
				</statement>
			</task>

      <task xml:id="quiz-for-loop-fresh-function-1">
