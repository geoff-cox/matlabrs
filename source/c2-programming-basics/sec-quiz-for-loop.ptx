					<program language="matlab">
						% Write your headsCountTwoInARow function here. You must use a for-loop.
								󠀠
								󠀠
								󠀠
								󠀠
								󠀠
								󠀠
								󠀠
								󠀠
								󠀠
								󠀠
								󠀠
