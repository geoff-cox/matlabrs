		<exercise xml:id="quiz-for-loop-construction-1">
			<title>Compute the Running Total</title>

			<introduction>
				<p>
					For each of the following, assume that:
					<ul>
						<li><pf>a</pf> is a random integer between 100 and 900, and</li>
						<li><pf>x</pf> is a random integer between 5 and 12</li>
					</ul>
					and write a <pf>for</pf>-loop that completes each task. 
				</p>
			</introduction>

			<task xml:id="quiz-for-loop-construction-1a">
				<statement>
					<p>
						Compute the sum of all integers between <pf>x</pf> and <pf>a</pf>. Store the result in <pf>total</pf>.
					</p>
					<program language="matlab">
						a = randi([100, 900]);
						x = randi([5, 12]);
						total = 0; % initialize
						% ==== Write your for loop here ====
						󠀠
						󠀠
						󠀠
						󠀠
						󠀠
					</program>
				</statement>
			</task>

			<task xml:id="quiz-for-loop-construction-1b">
				<statement>
					<p>
						Compute the sum of all integers between <pf>0</pf> and <pf>a</pf> that are divisible by <pf>x</pf>. Store the result in <pf>total</pf>.
					</p>
					<program language="matlab">
						a = randi([100, 900]);
						x = randi([5, 12]);
						total = 0; % initialize
						% ==== Write your for loop here ====
						󠀠
						󠀠
						󠀠
						󠀠
						󠀠
					</program>
				</statement>
			</task>
		</exercise>

		<exercise xml:id="quiz-for-loop-construction-2">
			<title>Approximating Pi with Leibniz's Formula</title>

			<statement>
				<p>
					The Leibniz formula for <m>\pi</m> states that:
					<me>\frac{\pi}{4} = 1 - \frac{1}{3} + \frac{1}{5} - \frac{1}{7} + \frac{1}{9} - \cdots</me>
					This infinite series converges slowly to <m>\pi/4</m>, but we can approximate it by adding many terms. Work through the tasks below to approximate <m>\pi</m>.
				</p>

				<p>
					Write a for loop that computes the sum of the first 1000 terms of the series:
					<me>1 - \frac{1}{3} + \frac{1}{5} - \frac{1}{7} + \frac{1}{9} - \cdots</me>.
					Store the sum in a variable called <pf>total</pf>. Then use <pf>total</pf> to compute an approximation of <m>\pi</m>.
					Store the approximation in a variable called <pf>approx</pf>. 
				</p>

				<program language="matlab">
					% ==== Write your for loop here ====
					󠀠
					󠀠
					󠀠
					󠀠
					󠀠
					󠀠
				</program>
			</statement>
		</exercise>

		<exercise xml:id="quiz-for-loop-function-1">
			<title>Counting Heads</title>

			<task xml:id="quiz-for-loop-construction-3a">
				<statement>
					<p>
						Write a function, called <pf>headsCount</pf>, that uses a for loop to count the number of heads that result from flipping a coin <pf>n</pf> times. Inside the loop, simulate a single coin flip using <pf>randi([0,1])</pf>, where <pf>0</pf> represents tails and <pf>1</pf> represents heads.
					</p>

					<sidebyside>
						<stack>
							<tabular valign="top" halign="right" top="minor">
								<col width="12%"/>
								<col width="88%" halign="left"/>
								<row>
									<cell>Inputs:</cell>
									<cell>
										<p><pf>n</pf> (1x1) double — positive integer</p>
									</cell>
								</row>
								<row bottom="minor">
									<cell>Outputs:</cell>
									<cell>
										<p><pf>count</pf> (1x1) double — the number of heads in n coin flips</p>
									</cell>
								</row>
							</tabular>
						</stack>
					</sidebyside>
					<program language="matlab">
						% ==== Write your function here ====
						function count = headsCount(n)
						󠀠
						󠀠
						󠀠
						󠀠
						󠀠
						󠀠
						end
					</program>
				</statement>
			</task>

			<task xml:id="quiz-for-loop-construction-3b">
				<statement>
					<p>
						Extend your function to count the number of times you get two heads in a row.
					</p>
					<program language="matlab">
						% ==== Write your function here ====
						function count = headsCountTwoInARow(n)
						󠀠
						󠀠
						󠀠
						󠀠
						󠀠
						󠀠
						end
					</program>
				</statement>
			</task>

		</exercise>

		<exercise xml:id="quiz-for-loop-function-2">
			<statement>
				<p>
					Write a function, <pf>sumSquares</pf> that computes 
					<me>1^2 + 2^2 + \cdots + n^2</me>
					for a given positive integer <m>n</m>.
				</p>

				<sidebyside>
					<stack>
						<tabular valign="top" halign="right" top="minor">
							<col width="12%"/>
							<col width="88%" halign="left"/>
							<row>
								<cell>Inputs:</cell>
								<cell>
									<p><pf>n</pf> (1x1) double — positive integer</p>
								</cell>
							</row>
							<row bottom="minor">
								<cell>Outputs:</cell>
								<cell>
									<p><pf>S</pf> (1x1) double — the sum <m>1^2 + 2^2 + \cdots + n^2</m></p>
								</cell>
							</row>
						</tabular>
						<p>Examples:</p>
						<program language="matlab">
							n = 1;		% returns: S = 1
							n = 3;		% returns: S = 14 (1^2 + 2^2 + 3^2 = 1 + 4 + 9)
						</program>
						<program language="matlab">
							% ==== Write your function here ====
							󠀠
							󠀠
							󠀠
							󠀠
							󠀠
							󠀠
							󠀠
							󠀠
						</program>
					</stack>
				</sidebyside>
			</statement>
		</exercise>

		<exercise xml:id="quiz-for-loop-function-3">
			<statement>
				<p>
					Write a script that uses a <pf>for</pf> loop to compute the sum of all odd numbers from 1 to 
					<pf>N</pf> (where <pf>N</pf> is given). Use the loop to iterate through the range <pf>1:2:N</pf>, 
					which generates only odd numbers. Store the result in <pf>sum_odd</pf>.
				</p>

				<sidebyside>
					<stack>
						<tabular valign="top" halign="right" top="minor">
							<col width="12%"/>
							<col width="88%" halign="left"/>
							<row>
								<cell>Inputs:</cell>
								<cell>
									<p><pf>N</pf> (1x1) double — positive integer upper limit</p>
								</cell>
							</row>
							<row bottom="minor">
								<cell>Outputs:</cell>
								<cell>
									<p><pf>sum_odd</pf> (1x1) double — sum of all odd numbers from 1 to N</p>
								</cell>
							</row>
						</tabular>
						<p>Examples:</p>
						<program language="matlab">
							N = 5;		% returns: sum_odd = 25 (1 + 3 + 5)
							N = 8;		% returns: sum_odd = 25 (1 + 3 + 5 + 7, stops before 8)
							N = 1;		% returns: sum_odd = 1
						</program>
						<program language="matlab">
							% ==== Write your function here ====
							󠀠
							󠀠
							󠀠
							󠀠
							󠀠
							󠀠
							󠀠
							󠀠
						</program>
					</stack>
				</sidebyside>
			</statement>
		</exercise>
		
	</worksheet>

</section>