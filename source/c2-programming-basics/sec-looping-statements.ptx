			<exercise label="quiz-looping-for-fundamentals-conceptual-parsons" language="matlab" adaptive="yes" indentation="hide">
				<title>Conceptual Question: Build a Loop in the Correct Order</title>

				<statement>
					<p>
						Put these blocks in the correct order to compute <pf>n!</pf> using a running product, then print the result.
					</p>
				</statement>

				<blocks>
					<block>
						<cline>fact = 1;</cline>
					</block>
					<block>
						<cline>for k = 1:6</cline>
					</block>
					<block>
						<cline>    fact = fact * k;</cline>
					</block>
					<block>
						<cline>end</cline>
					</block>
					<block>
						<cline>fprintf('%d! = %d\n', n, fact)</cline>
					</block>
				</blocks>

				<solution>
					<program language="matlab">
						fact = 1;
						for k = 1:6
								fact = fact * k;
						end
						fprintf('%d! = %d\n', n, fact)
					</program>
				</solution>
			</exercise>

			<exercise xml:id="quiz-for-loop-fresh-conceptual-10" language="matlab" numbered="left" indentation="hide">
				<title>Conceptual Question: Parsons Problem</title>
				<statement>
					<p>
						Put the blocks in order to print the first multiple of 7 between 1 and 50 (inclusive), then stop looping.
					</p>
				</statement>
				<blocks>
					<block><cline>for k = 1:50</cline></block>
					<block><cline>    if mod(k, 7) == 0</cline></block>
					<block><cline>        fprintf('First multiple: %d\n', k)</cline></block>
					<block><cline>        break</cline></block>
					<block><cline>    end</cline></block>
					<block><cline>end</cline></block>
				</blocks>
			</exercise>			

