			<task label="coding-for-loop-classifyNumber">
				<statement>
					<p>
						Let <m>p</m> and <m>N</m> be positive integers, then 
						<ul marker="square">
							<li>
								<p>
									<line><m>N</m> is <q><term>perfect</term></q> if it equals the sum of its proper divisors.</line>
									<line><em>N = 6 is perfect because <m>1 + 2 + 3 = 6</m>.</em></line>
								</p>
							</li>
							<li>
								<p>
									<line><m>N</m> is <q><term>abundant</term></q> if it is less than the sum of its proper divisors.</line>
									<line><em>N = 12 is abundant because <m>12 &lt; 1 + 2 + 3 + 4 + 6 = 16</m>.</em></line>
								</p>
							</li>
							<li>
								<p>
									<line><m>N</m> is <q><term>deficient</term></q> if it is greater than the sum of its proper divisors.</line>
									<line><em>N = 8 is deficient because <m>8 &gt; 1 + 2 + 4 = 7</m>.</em></line>
								</p>
							</li>
						</ul>
					</p>
					<p>
						Write a function, called <pf>classifyNumber</pf>, that classifies a given positive integer as <pf>"perfect"</pf>, <pf>"abundant"</pf>, or <pf>"deficient"</pf>. Use the function from the previous task as a helper function.
					</p>
					<tabular valign="top" halign="right" top="minor">
						<col width="11%"/>
						<col width="10%"/>
						<col width="28%" halign="left"/>
						<col width="51%" halign="left"/>
						<row>
							<cell><p>Inputs:</p></cell>
							<cell><p><pf>N</pf></p></cell>
							<cell><p>(1x1) double</p></cell>
							<cell><p>positive integer</p></cell>
						</row>
						<row bottom="minor">
							<cell><p>Outputs:</p></cell>
							<cell><p><pf>type</pf></p></cell>
							<cell><p>(1x1) string</p></cell>
							<cell><p><pf>"perfect"</pf>, <pf>"abundant"</pf>, or <pf>"deficient"</pf> depending on n</p></cell>
						</row>
					</tabular>
					<sidebyside widths="49% 49%">
						<stack>
							<p>Test Cases ⤵︎</p>
							<program language="matlab">
								type = classifyNumber(6)
								type = classifyNumber(8)
								type = classifyNumber(12)
								type = classifyNumber(1)
							</program>
						</stack>
						<stack>
							<p>Expected ⤵︎</p>
							<program language="matlab">
								% type = "perfect"
								% type = "deficient"
								% type = "abundant"
								% type = "deficient"
							</program>
						</stack>
					</sidebyside>
				</statement>
				<!-- <solution>
					<p>
						Here is one possible solution:
					</p>
					<program language="matlab">
						function type = classifyNumber(N)
							sum_divisors = sumProperDivisors(N); % Call helper function
							if N == sum_divisors
								type = "perfect";
							elseif N &lt; sum_divisors
								type = "abundant";
							else
								type = "deficient";
							end
						end
					</program>
				</solution> --> 
			</task>

			<task label="coding-for-loop-approxE">
