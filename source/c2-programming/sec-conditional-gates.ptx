		<exercise label="conditional-activity-10">
			<title>Activity 10: Late Fee Function</title>

			<introduction>
				<p>
					Use an <pf>if-elseif-else</pf> chain to assign a fee based on how late something is.
				</p>
			</introduction>

			<task label="conditional-activity-10a">
				<statement>
					<p>
						Write a function named <pf>late_fee</pf> that takes a single number <pf>daysLate</pf> (the number of days late) and returns <pf>fee</pf> according to the table below:
					</p>
					<tabular halign="center" top="minor" bottom="minor" left="minor" right="minor">
						<row>
							<cell><pf>daysLate</pf></cell><cell><pf>fee</pf></cell>
						</row>
						<row>
							<cell>0 or less</cell><cell>0</cell>
						</row>
						<row>
							<cell>1 to 3</cell><cell>5</cell>
						</row>
						<row>
							<cell>3 to 7</cell><cell>15</cell>
						</row>
						<row>
							<cell><m>\quad</m> more than 7<m>\quad</m></cell><cell><m>\quad</m>30<m>\quad</m></cell>
						</row>
					</tabular>
				</statement>
				<!-- <solution>
					<program language="matlab">
						function fee = late_fee(daysLate)
							if daysLate &lt;= 0
								fee = 0;
							elseif daysLate &lt;= 3
								fee = 5;
							elseif daysLate &lt;= 7
								fee = 15;
							else
								fee = 30;
							end
						end
					</program>
				</solution> -->
			</task>

			<task label="conditional-activity-10b">
				<statement>
					<p>
						Modify the function to return a second output <pf>status</pf> with values according to the table below:
					</p>
					<tabular halign="center" top="minor" bottom="minor" left="minor" right="minor">
						<row>
							<cell><pf>daysLate</pf></cell><cell><pf>fee</pf></cell><cell><pf>status</pf></cell>
						</row>
						<row>
							<cell>0 or less</cell><cell>0</cell><cell>on time</cell>
						</row>
						<row>
							<cell>1 to 3</cell><cell>5</cell><cell>minor late</cell>
						</row>
						<row>
							<cell>3 to 7</cell><cell>15</cell><cell>late</cell>
						</row>
						<row>
							<cell><m>\quad</m> more than 7<m>\quad</m></cell><cell><m>\quad</m>30<m>\quad</m></cell><cell><m>\quad</m>very late<m>\quad</m></cell>
						</row>
					</tabular>
				</statement>
				<!-- <solution>
					<program language="matlab">
						function [fee, status] = late_fee(daysLate)
							if daysLate &lt;= 0
								fee = 0;
								status = 'on time';
							elseif daysLate &lt;= 3
								fee = 5;
								status = 'minor late';
							elseif daysLate &lt;= 7
								fee = 15;
								status = 'late';
							else
								fee = 30;
								status = 'very late';
							end
						end
					</program>
				</solution> -->
			</task>

		</exercise>

		<!-- <assemblage>
