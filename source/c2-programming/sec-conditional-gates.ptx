		<exercise label="conditional-activity-6">
			<title>Activity 6: Letter Grade Function</title>

			<introduction>
				<p>
					Convert a numeric score to a letter grade using range-based conditions.
				</p>
			</introduction>

			<task label="conditional-activity-6a">
				<statement>
					<p>
						Write a function named <pf>letter_grade</pf> that returns <pf>'A'</pf>, <pf>'B'</pf>, <pf>'C'</pf>,
						<pf>'D'</pf>, or <pf>'F'</pf> for a scalar <pf>score</pf> using the standard 90/80/70/60 cutoffs.
					</p>
				</statement>
				<!-- <solution>
					<program language="matlab">
						function letter = letter_grade(score)
							if score &gt;= 90
								letter = 'A';
							elseif score &gt;= 80
								letter = 'B';
							elseif score &gt;= 70
								letter = 'C';
							elseif score &gt;= 60
								letter = 'D';
							else
								letter = 'F';
							end
						end
					</program>
				</solution> -->
			</task>

			<task label="conditional-activity-6b">
				<statement>
					<p>
						Add an input check so that scores outside <pf>0</pf> to <pf>100</pf> return <pf>'invalid'</pf>.
					</p>
				</statement>
				<!-- <solution>
					<program language="matlab">
						function letter = letter_grade(score)
							if score &lt; 0 || score &gt; 100
								letter = 'invalid';
							elseif score &gt;= 90
								letter = 'A';
							elseif score &gt;= 80
								letter = 'B';
							elseif score &gt;= 70
								letter = 'C';
							elseif score &gt;= 60
								letter = 'D';
							else
								letter = 'F';
							end
						end
					</program>
				</solution> -->
			</task>

			<task label="conditional-activity-6c">
				<statement>
					<p>
						Concept check: why must the <pf>score &gt;= 90</pf> test appear before the <pf>score &gt;= 80</pf> test?
					</p>
				</statement>
				<!-- <solution>
					<p>
						Conditions are checked in order. If the <pf>score &gt;= 80</pf> test came first, scores of 90 or above
						would already satisfy it and never reach the <pf>A</pf> branch.
					</p>
				</solution> -->
			</task>
		</exercise>

		<exercise label="conditional-activity-7">
			<title>Activity 7: Shipping Mode Switch</title>

			<introduction>
				<p>
					Use a <pf>switch</pf> statement to choose among discrete shipping options.
				</p>
			</introduction>

			<task label="conditional-activity-7a">
				<statement>
					<p>
						Create a function named <pf>shipping_cost</pf> that takes a <pf>mode</pf> input (<pf>'S'</pf>,
						<pf>'E'</pf>, or <pf>'O'</pf>) and returns a scalar <pf>cost</pf> of 5, 12, or 20.
					</p>
				</statement>
				 <solution>
					<program language="matlab">
						function cost = shipping_cost(mode)
							switch mode
								case 'S'
									cost = 5;
								case 'E'
									cost = 12;
								case 'O'
									cost = 20;
								otherwise
									cost = NaN;
							end
						end
					</program>
				</solution> 
			</task>

			<task label="conditional-activity-7b">
				<statement>
					<p>
						Extend the function so it also accepts full words (<pf>'standard'</pf>, <pf>'express'</pf>,
						and <pf>'overnight'</pf>) in addition to the single-letter codes.
					</p>
				</statement>
				 <solution>
					<program language="matlab">
						function cost = shipping_cost(mode)
							switch mode
								case {'S', 'standard'}
									cost = 5;
								case {'E', 'express'}
									cost = 12;
								case {'O', 'overnight'}
									cost = 20;
								otherwise
									cost = NaN;
							end
						end
					</program>
				</solution> 
			</task>

			<task label="conditional-activity-7c">
				<statement>
					<p>
						Concept check: what happens when <pf>mode = 'e'</pf> (lowercase), and why?
					</p>
				</statement>
				 <solution>
					<p>
						The <pf>otherwise</pf> branch runs and returns <pf>NaN</pf> because <pf>switch</pf> comparisons are
						case-sensitive, so <pf>'e'</pf> does not match <pf>'E'</pf>.
					</p>
				</solution> 
			</task>
		</exercise>

		<exercise label="conditional-activity-8">
