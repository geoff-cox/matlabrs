<?xml version="1.0" encoding="utf-8"?>

<pretext xml:lang="en-US" xmlns:xi="http://www.w3.org/2001/XInclude">

	<xi:include href="aa-bookends/book-info.ptx" />

	<book xml:id="matlabrs">
		<title>PROTEUS Drag-And-Drop Test</title>

		<chapter xml:id="chp-welcome-to-matlab" xmlns:xi="http://www.w3.org/2001/XInclude">
			<title>TEST CHAPTER</title>

			<exercise label="dnd-test-exercise">
				<title>DRAG-AND-DROP EXERCISE</title>
				<statement>
					<p>
						Drag stuff and drop it.
					</p>
				</statement>
				<feedback>
					<p>
						Just drag-and-drop stuff.
					</p>
				</feedback>
				<cardsort>
					<match>
						<premise>L1</premise>
						<response>R1</response>
					</match>
					<match>
						<premise>L2a</premise>
						<premise>L2b</premise>
						<premise>L2c</premise>
						<response>R2</response>
					</match>
					<match>
						<premise>L3a</premise>
						<premise>L3b</premise>
						<response>R3</response>
					</match>
					<match>
						<response>R4</response>
					</match>
					<match>
						<premise>L5</premise>
					</match>
				</cardsort>
			</exercise>

		</chapter>

	</book>

</pretext>
