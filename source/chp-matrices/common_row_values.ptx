<!--META-DATA
{
	tags: for, vector,
}
-->

<statement>
	<p>
		Returns a sorted list of all the values common in the rows of a matrix.
	</p>

	<tabular valign="top" top="minor">
		<col width="12%"/>
		<col width="88%"/>
		<row bottom="minor">
			<cell>Inputs:</cell>
			<cell>
				<p><pf>A</pf> (m x n) double — matrix of numbers (doubles).</p>
			</cell>
		</row>
		<row bottom="minor">
			<cell>Outputs:</cell>
			<cell>
				<p><pf>common_vals</pf> (1 x L) double vector — vector of values common in each row of <pf>A</pf></p>
			</cell>
		</row>
		<row>
			<cell>Details:</cell>
			<cell><p>The output should not have any duplicate values.</p></cell>
		</row>
		<row>
			<cell/>
			<cell><p>The output should be sorted (in ascending order). You may use your</p></cell>
		</row>
		<row>
			<cell/>
			<cell><p>HW3P5_sort</p></cell>
		</row>
		<row>
			<cell/>
			<cell><p>code to do this or you can use MATLAB's</p></cell>
		</row>
		<row>
			<cell/>
			<cell><p>sort</p></cell>
		</row>
		<row>
			<cell/>
			<cell><p>command for a one-point deduction.</p></cell>
		</row>
		<row>
			<cell/>
			<cell><p>You may use your</p></cell>
		</row>
		<row>
			<cell/>
			<cell><p>remove_duplicates</p></cell>
		</row>
		<row>
			<cell/>
			<cell><p>code from HW 2 within this program.</p></cell>
		</row>
		<row bottom="minor">
			<cell/>
			<cell><p>If there are no common values, then your code should return the empty matrix, [].</p></cell>
		</row>
	</tabular>

	<p>
		Examples:
		<program>
			<code>
				INPUT
				[3 2 3 1;...
				9 2 5 3;...
				3 2 5 9;...
				2 1 3 5;...
				1 1 3 2];
				[3 2 3 1;...
				9 2 5 3;...
				3 2 5 9;...
				2 1 3 5;...
				1 1 3 2];
				OUTPUT
				[2 3]
				INPUT
				[2 1 1 1;...
				1 2 5 1;...
				1 2 1 9;...
				2 1 1 5
				];
				[2 1 1 1;...
				1 2 5 1;...
				1 2 1 9;...
				2 1 1 5
				];
				OUTPUT
				[1 2]
			</code>
		</program>
	</p>
</statement>
