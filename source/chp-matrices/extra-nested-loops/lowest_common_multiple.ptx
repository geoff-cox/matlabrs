<statement>
<p>
	the lowest common multiple of 4 and 6 is 12. the lowest common multiple of 5 and 6 is 30. the lowest common multiple of 250 and 35 is 1750.
</p>

<tabular valign="top" top="minor">
	<col width="12%"/>
	<col width="88%"/>
	<row bottom="minor">
		<cell>Inputs:</cell>
		<cell>
			<p><pf>number1</pf> (1 x 1) integer — positive integer value.</p>
			<p><pf>number2</pf> (1 x 1) integer — positive integer value.</p>
		</cell>
	</row>
	<row bottom="minor">
		<cell>Outputs:</cell>
		<cell>
			<p><pf>lcm</pf> (1 x 1) integer — integer containing the lowest common multiple of <pf>number1</pf> and <pf>number2</pf>.</p>
		</cell>
	</row>
	<row>
		<cell>Details:</cell>
		<cell><p>Code this by calling your</p></cell>
	</row>
	<row>
		<cell/>
		<cell><p>HW3P5_prime_factors</p></cell>
	</row>
	<row>
		<cell/>
		<cell><p>function within this function.</p></cell>
	</row>
	<row>
		<cell/>
		<cell><p>MATLAB's</p></cell>
	</row>
	<row>
		<cell/>
		<cell><p>mod</p></cell>
	</row>
	<row bottom="minor">
		<cell/>
		<cell><p>function should be useful.</p></cell>
	</row>
</tabular>

<p>
	Examples:
<program>
	<code>
		n = lowest_common_multiple(16, 64)
		64
		lowest_common_multiple(44, 60)
		660
	</code>
</program>
</p>
</statement>
