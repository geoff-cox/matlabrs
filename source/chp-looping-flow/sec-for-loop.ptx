			<task label="for-loop-drill-print-3">
				<title>Print with a For-Loop 3</title>
				<statement>
					<p>
						Use a <pf>for</pf>-loop and <pf>fprintf</pf> to produce the exact same message. Press <kbd>Evaluate</kbd> to confirm it does.
					</p>
					<program language="matlab">
						10
						8
						6
						4
