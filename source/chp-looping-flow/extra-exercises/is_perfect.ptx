<!--META-DATA
{
	tags: logical, sum, divisors,
}
-->

<statement>
<p>
	The proper divisors of 6: 1, 2, and 3 sum to 6. The proper divisors of 28: 1, 2, 4, 7, and 14 sum to 28.
</p>

<tabular valign="top" top="minor">
	<col width="12%"/>
	<col width="88%"/>
	<row bottom="minor">
		<cell>Inputs:</cell>
		<cell>
			<p><pf>number</pf> (1 x 1) integer — positive integer.</p>
		</cell>
	</row>
	<row bottom="minor">
		<cell>Outputs:</cell>
		<cell>
			<p><pf>result</pf> (1 x 1) number — <pf>true</pf> if <pf>number</pf> is perfect. <pf>false</pf> Otherwise.</p>
		</cell>
	</row>
	<row>
		<cell>Details:</cell>
		<cell><p>Code this by calling your</p></cell>
	</row>
	<row>
		<cell/>
		<cell><p>HW2P2_proper_divisors</p></cell>
	</row>
	<row>
		<cell/>
		<cell><p>function within this function.</p></cell>
	</row>
	<row>
		<cell/>
		<cell><p>You may use MATLAB's</p></cell>
	</row>
	<row>
		<cell/>
		<cell><p>sum</p></cell>
	</row>
	<row bottom="minor">
		<cell/>
		<cell><p>function.</p></cell>
	</row>
</tabular>

<p>
	Examples:
<program>
	<code>
		is_perfect(110)
		0 (logical)
		is_perfect(8128)
		1 (logical)
	</code>
</program>
</p>
</statement>
