<statement>
<p>
	1 + 7 + 2 + 9 = 19 and 1729 = 19 × 91
</p>

<tabular valign="top" top="minor">
	<col width="12%"/>
	<col width="88%"/>
	<row bottom="minor">
		<cell>Inputs:</cell>
		<cell>
			<p><pf>number</pf> (1 x 1) integer — positive integer.</p>
		</cell>
	</row>
	<row bottom="minor">
		<cell>Outputs:</cell>
		<cell>
			<p><pf>result</pf> (1 x 1) number — <pf>true</pf> if <pf>number</pf> is Harshad. <pf>false</pf> Otherwise.</p>
		</cell>
	</row>
	<row>
		<cell>Details:</cell>
		<cell><p>Code this by calling your</p></cell>
	</row>
	<row>
		<cell/>
		<cell><p>HW3P3_extract_digits</p></cell>
	</row>
	<row>
		<cell/>
		<cell><p>function within this function.</p></cell>
	</row>
	<row>
		<cell/>
		<cell><p>You may use MATLAB's</p></cell>
	</row>
	<row>
		<cell/>
		<cell><p>sum</p></cell>
	</row>
	<row bottom="minor">
		<cell/>
		<cell><p>function.</p></cell>
	</row>
</tabular>

<p>
	Examples:
<program>
	<code>
		is_harshad(11)
		0 (logical)
		is_harshad(1729)
		1 (logical)
		is_harshad(111)
		1 (logical)
	</code>
</program>
</p>
</statement>
